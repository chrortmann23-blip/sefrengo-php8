   <output>&lt;CMSPHP&gt;
$a = $idcat;
$mod['path'] = array();

while($a &gt; 0 &amp;&amp; $catlist_level[$a] &gt; 0){
	sf_array_push($mod['path'],$a);
	$a = $con_tree[$a]['parent'];
}
if(&quot;MOD_VALUE[3]&quot; == 'true') { sf_array_push($mod['path'],$a); };

$mod['rpath'] = array_reverse($mod['path']);
$mod['array'] = array();
foreach ($mod['rpath'] as $a){
	$mod['tmp'] = str_replace(&quot;{font1}&quot;,&quot;MOD_VALUE[0]&quot;,&quot;MOD_VALUE[9]&quot;);
	$mod['tmp'] = str_replace(&quot;{name}&quot;,$con_tree[$a]['name'],$mod['tmp']);
	$mod['tmp'] = str_replace(&quot;{link}&quot;,$con_tree[$a]['link'],$mod['tmp']);
	sf_array_push($mod['array'] , $mod['tmp']);
};
if(&quot;MOD_VALUE[4]&quot; == 'true') {
	if (&quot;MOD_VALUE[8]&quot; != 'true' || $con_side[$idcatside]['is_start'] != '1') {
		if(&quot;MOD_VALUE[5]&quot; == 'true'){
			$mod['tmp'] = str_replace(&quot;{font1}&quot;,&quot;MOD_VALUE[0]&quot;,&quot;MOD_VALUE[9]&quot;);
			$mod['tmp'] = str_replace(&quot;{name}&quot;,$con_side[$idcatside]['name'],$mod['tmp']);
			$mod['tmp'] = str_replace(&quot;{link}&quot;,$con_side[$idcatside]['link'],$mod['tmp']);
		} else {
			$mod['tmp'] = $con_side[$idcatside]['name'];
		};
		sf_array_push($mod['array'], $mod['tmp']);
	};
};

if(&quot;MOD_VALUE[10]&quot; == 'true') { $mod['array'] = array_reverse($mod['array']); };
$mod['output'] = sf_implode(&quot;MOD_VALUE[6]&quot;, $mod['array']);
echo str_replace('{nav}', $mod['output'], &quot;MOD_VALUE[7]&quot;);

unset($a, $mod);
&lt;/CMSPHP&gt;</output>
