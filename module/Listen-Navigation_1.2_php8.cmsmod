mip_formsp($mip_form['24']);		// Template: Ordner
mip_formsp($mip_form['25']);		// Template: Aktiver Ordner
mip_formsp($mip_form['27']);		// Template: Ordner, wenn als aktiv verfolgt

unset($mip_form);
?&gt;</input>
   <output>&lt;CMSPHP&gt;

&lt;CMSPHP:CACHE&gt;



$ln_routing['idcatside'] = $idcatside;
$ln_routing['idcat'] = $idcat;
$ln_routing['routings'] = array();
$ln_routing['idcat_temp'] = $ln_routing['idcatside_temp'] = false;
$ln_routing['raw'] = trim( str_replace(' ', '', &quot;MOD_VALUE[30]&quot;));

if (strlen($ln_routing['raw']) &gt; 14) {
  $ln_routing['raw_vals'] = explode(&quot;\n&quot;, $ln_routing['raw']);
  foreach ($ln_routing['raw_vals'] AS $v) {
    $pieces = explode('&gt;', $v);
    $ln_routing['routings'][ $pieces['0'] ] = $pieces['1'];
  }
}


//source idcatside
if (sf_array_key_exists('idcatside:'.$idcatside, $ln_routing['routings'])) {
  //idcatside to idcatside
  if( strstr ( $ln_routing['routings']['idcatside:'.$idcatside], 'idcatside')) {
    $ln_routing['idcatside_temp'] = (int) str_replace('idcatside:', '', $ln_routing['routings']['idcatside:'.$idcatside]);
	if ($ln_routing['idcatside_temp'] &gt; 0) {
	  $idcatside = $ln_routing['idcatside_temp'];
	  $idcat = $con_side[$idcatside]['idcat'];
	}
  //idcatside to idcat
  } else {
  	$ln_routing['idcat_temp'] = (int) str_replace('idcat:', '', $ln_routing['routings']['idcatside:'.$idcatside]);
    if ($ln_routing['idcat_temp'] &gt; 0) {
		$idcat = $ln_routing['idcat_temp'];
		$idcatside = $SF_catinfos-&gt;getIdcatsideStartpage($idcat);
    }
  }
// source idcat
} else if (sf_array_key_exists('idcat:'.$idcat, $ln_routing['routings'])) {
	//idcat to idcatside
	if( strstr ( $ln_routing['routings']['idcat:'.$idcat], 'idcatside')) {
	    $ln_routing['idcatside_temp'] = (int) str_replace('idcatside:', '', $ln_routing['routings']['idcat:'.$idcat]);
	    if ($ln_routing['idcatside_temp'] &gt; 0) {
			$idcatside = $ln_routing['idcatside_temp'];
			$idcat = $con_side[$idcatside]['idcat'];
	    }
	//idcat to idcat
	} else {
		$ln_routing['idcat_temp'] = (int) str_replace('idcat:', '', $ln_routing['routings']['idcat:'.$idcat]);
		if ($ln_routing['idcat_temp'] &gt; 0) {
		  $idcat = $ln_routing['idcat_temp'];
		  $idcatside = $SF_catinfos-&gt;getIdcatsideStartpage($idcat);
		}
	}
}


&lt;/CMSPHP:CACHE&gt;



//Description of cats
if(! function_exists('get_cat_desc')){
    function get_cat_desc($a)
{
global $db,$cms_db;
$sql  = &quot;SELECT
			*
		FROM 
	   &quot;.$cms_db['cat_lang'].&quot; 
		WHERE idcatlang = '&quot;.$a.&quot;'&quot;;
$db-&gt;query($sql);
$db-&gt;next_record();
return $db-&gt;f('description'); 
}}

//Descritpion of pages
if(! function_exists('get_side_desc')){
    function get_side_desc($a,$which)
{
global $db,$cms_db;
$sql  = &quot;SELECT
			*
		FROM 
	   &quot;.$cms_db['side_lang'].&quot; LEFT JOIN
		&quot;.$cms_db['cat_side'].&quot; USING(IDSIDE)
		WHERE 
idcatside = '&quot;.$a.&quot;'&quot;;
$db-&gt;query($sql);
$db-&gt;next_record();

if ($which == 'desc') {
return $db-&gt;f('meta_description'); }
elseif ($which == 'summary'){
return $db-&gt;f('summary'); }
}}






//global $evil_global_variable_for_easy_tabindex_implementation, $mod;
$evil_global_variable_for_easy_tabindex_implementation = 1;

$mod['desc'] = array();

// idcat des Start-Ordners besorgen
&lt;CMSPHP:CACHE&gt;
if(! function_exists('nav_negotiate_startlevel') ){
function nav_negotiate_startlevel( $current_cat, $startlevel ){
        global $con_tree;

        //echo &quot;$cat, $searcharray &lt;br /&gt;&quot;;//return false;
        if (empty($current_cat) || $current_cat == 0 || ! is_int($current_cat) || ! is_int($startlevel)  ) {
                return $current_cat;
        }

        $levels = array();
        sf_array_push($levels, $current_cat);
        $cat = $current_cat;
        while(true) {
                $cat = (int) $con_tree[$cat]['parent'];
                sf_array_push($levels, $cat);
                if ($cat == 0) break;
        }
        $levels_rev = array_reverse($levels);
        //print_r($levels_rev);exit;

        if ($levels_rev[$startlevel] &gt; 0) {
                return $levels_rev[$startlevel];
        } else {
                return $current_cat;
        }
}}


if ($cms_mod['value'][1] == 'root')
{
        $cms_mod['value'][1] = '0';
}
elseif ($cms_mod['value'][1] == 'this')
{
        $cms_mod['value'][1] = $idcat;
}

$mod['startlevel']  = (int) &quot;MOD_VALUE[29]&quot;;
if ($mod['startlevel'] &gt; 0) {
  $cms_mod['value'][1] = (string) nav_negotiate_startlevel( (int) $idcat, $mod['startlevel']);
}

if (!$cms_mod['value'][14])
{
	// Update von einer Version kleiner als 0.9-dev =&gt; Diese Variablen wurden noch nicht durch die Modulkonfiguration gesetzt
	$cms_mod['value'][14] = 'sortindex';
	$cms_mod['value'][15] = 'SORT_ASC';
}


// Anzahl darzustellender Ebenen auf 0 setzen, falls unsinnige Werte angegeben wurden
if (!is_numeric($cms_mod['value'][5]) || ($cms_mod['value'][5] &lt; 0))
{
	$cms_mod['value'][5] = 0;
}

// Startnummer fuer tabindex auf 1 setzen, falls unsinnige Werte angegeben wurden
if (!is_numeric($cms_mod['value'][13]) || ($cms_mod['value'][13] &lt; 1))
{
	$cms_mod['value'][13] = 1;
}
&lt;/CMSPHP:CACHE&gt;


/*
 * Hilfs-Funktionen
 */

function print_folder_&lt;CMSPHP:CACHE&gt;echo $cms_mod['container']['id'];&lt;/CMSPHP:CACHE&gt;($folder, $depth)
{
	&lt;CMSPHP:CACHE&gt;
	if ($cms_mod['value'][16] == 'true')
	{
	&lt;/CMSPHP:CACHE&gt;
		$output = print_folder_helper_folders_&lt;CMSPHP:CACHE&gt;echo $cms_mod['container']['id'];&lt;/CMSPHP:CACHE&gt;($folder, $depth);
		$output .= print_folder_helper_pages_&lt;CMSPHP:CACHE&gt;echo $cms_mod['container']['id'];&lt;/CMSPHP:CACHE&gt;($folder, $depth);
	&lt;CMSPHP:CACHE&gt;
	}
	else
	{
	&lt;/CMSPHP:CACHE&gt;
		$output = print_folder_helper_pages_&lt;CMSPHP:CACHE&gt;echo $cms_mod['container']['id'];&lt;/CMSPHP:CACHE&gt;($folder, $depth);
		$output .= print_folder_helper_folders_&lt;CMSPHP:CACHE&gt;echo $cms_mod['container']['id'];&lt;/CMSPHP:CACHE&gt;($folder, $depth);
	&lt;CMSPHP:CACHE&gt;
	}
	&lt;/CMSPHP:CACHE&gt;
	
	if (strlen($output) &gt; 0)
	{
		$tpl = str_replace('{id}', $folder['idcat'], &quot;MOD_VALUE[26]&quot;); 
		$output = str_replace('{layer}', $output, $tpl);
	}
	
	return $output;
}


function print_folder_helper_pages_&lt;CMSPHP:CACHE&gt;echo $cms_mod['container']['id'];&lt;/CMSPHP:CACHE&gt;($folder, $depth)
{
	global $evil_global_variable_for_easy_tabindex_implementation, $con_side, $mod, $sess;
	
	$cats_no_pages = explode(&quot;,&quot;, trim(str_replace(' ', '', &quot;MOD_VALUE[28]&quot;)));
	
	// Seiten ausgeben
	if (isset($folder['pages']))
	{  
	  $pagevals = array_values($folder['pages']);
	  if(! in_array($con_side[ $pagevals['0'] ]['idcat'],$cats_no_pages) || ('MOD_VALUE[6]' != 'true' &amp;&amp; $sess-&gt;name == 'sefrengo' ) )
    {
	   
  		foreach ($folder['pages'] as $idcatside)
  		{
  			$template = ($idcatside == &lt;CMSPHP:CACHE&gt;echo $idcatside;&lt;/CMSPHP:CACHE&gt;) ? &quot;MOD_VALUE[23]&quot; : &quot;MOD_VALUE[22]&quot;;
  			$item = str_replace('{name}', htmlspecialchars($con_side[$idcatside]['name'], ENT_COMPAT, 'UTF-8'), $template);
  			$item = str_replace('{desc}', htmlspecialchars(get_side_desc($idcatside,'desc'), ENT_COMPAT, 'UTF-8'), $item);
  			$item = str_replace('{summary}', htmlspecialchars(get_side_desc($idcatside,'summary'), ENT_COMPAT, 'UTF-8'), $item);
  			$item = str_replace('{link}', $con_side[$idcatside]['link'], $item);
  			$item = str_replace('{id}', $idcatside, $item);
  			$item = str_replace('{depth}', $depth, $item);
  			if (strstr($item, '{tabindex}') !== false)
  			{
  				$item = str_replace('{tabindex}', $evil_global_variable_for_easy_tabindex_implementation++, $item);
  			}
  
  			&lt;CMSPHP:CACHE&gt;
  			if (strstr($cms_mod['value'][22], '{first}') || strstr($cms_mod['value'][23], '{first}'))
  			{
  			&lt;/CMSPHP:CACHE&gt;
  				if ($folder['first'])
  				{
  					$folder['first'] = false;
  					$item = preg_replace(&quot;/{first}(.*?)({else}(.*?))?{\/first}/&quot;, &quot;\\1&quot;, $item);
  				}
  				else
  				{
  					$item = preg_replace(&quot;/{first}(.*?)({else}(.*?))?{\/first}/&quot;, &quot;\\3&quot;, $item);
  				}
  			&lt;CMSPHP:CACHE&gt;
  			}
  
  			if (strstr($cms_mod['value'][22], '{last}') || strstr($cms_mod['value'][23], '{last}'))
  			{
  			&lt;/CMSPHP:CACHE&gt;
  				if (($folder['last_thing'] == 'page') &amp;&amp; ($folder['last'] == $idcatside))
  				{
  					$item = preg_replace(&quot;/{last}(.*?)({else}(.*?))?{\/last}/&quot;, &quot;\\1&quot;, $item);
  				}
  				else
  				{
  					$item = preg_replace(&quot;/{last}(.*?)({else}(.*?))?{\/last}/&quot;, &quot;\\3&quot;, $item);
  				}
  			&lt;CMSPHP:CACHE&gt;
  			}
  			&lt;/CMSPHP:CACHE&gt;
  
  			$temp .= $item;
  		}
  	}
	}
	
	return $temp;
}


function print_folder_helper_folders_&lt;CMSPHP:CACHE&gt;echo $cms_mod['container']['id'];&lt;/CMSPHP:CACHE&gt;($folder, $depth)
{
	global $evil_global_variable_for_easy_tabindex_implementation, $con_tree, $con_side, $mod;
  
  $cats_no_pages = explode(&quot;,&quot;, trim(str_replace(' ', '', &quot;MOD_VALUE[28]&quot;)));
  
	// Ordner ausgeben
	if (is_array($folder['children']))
	{
		// Alle Unterordner dieses Ordners durchgehen
		foreach ($folder['children'] as $subfolder)
		{
			$idcat = $subfolder['idcat'];
			$active_side_is_start = &lt;CMSPHP:CACHE&gt;echo $con_side[$idcatside]['is_start'];&lt;/CMSPHP:CACHE&gt;;
      $active_cat = &lt;CMSPHP:CACHE&gt;echo $idcat;&lt;/CMSPHP:CACHE&gt;;
      $show_start_page = &quot;&lt;CMSPHP:CACHE&gt;echo &quot;MOD_VALUE[4]&quot;;&lt;/CMSPHP:CACHE&gt;&quot;;
				
			&lt;CMSPHP:CACHE&gt;
			// Falls &quot;Ordner nur als aktiv markieren, wenn Startseite angezeigt wird&quot; gewaehlt wurde
			// und die aktuelle (die angezeigte) Seite keine Startseite ist, ...
			if (($cms_mod['value'][9] == 'true') &amp;&amp; ($con_side[$idcatside]['is_start'] != '1'))
			{
			&lt;/CMSPHP:CACHE&gt;
				// ... die Vorlage (Template) &quot;Ordner&quot; nehmen, ...
				$template = &quot;MOD_VALUE[24]&quot;;
			&lt;CMSPHP:CACHE&gt;
			}
			else
			{
			&lt;/CMSPHP:CACHE&gt;
				// ... andernfalls die Vorlage &quot;Aktiver Ordner&quot; benutzen, wenn der Unterordner
				// der aktuelle (&quot;angezeigte&quot;) Ordner ist und sonst die Vorlage &quot;Ordner&quot; verwenden.
				$template = ($idcat == &lt;CMSPHP:CACHE&gt;echo $idcat;&lt;/CMSPHP:CACHE&gt;) ? &quot;MOD_VALUE[25]&quot; : &quot;MOD_VALUE[24]&quot;;
				&lt;CMSPHP:CACHE&gt;
				if ($cms_mod['value'][11] == 'true')
				{
				&lt;/CMSPHP:CACHE&gt;
					if (in_array($idcat, $mod['active']))
					{
					   //aktive (25) oder verfolgte (27) kategorie
					   if ($idcat == $active_cat){
					        //ist aktiver ordner
					        //print_r($folder);
                  if ( in_array($idcat, $cats_no_pages)  
                  || ($active_side_is_start == '1' &amp;&amp; ($show_start_page == 'false' || ($show_start_page == 'gt1' &amp;&amp; count($subfolder['pages']) &lt; 2) ) ) 
                 /*|| count($folder['pages']) &lt; 2 &amp;&amp; */ ) {
                    $template = &quot;MOD_VALUE[25]&quot;;
                  //ist verfolter ordner
                  } else {
                    $template = &quot;MOD_VALUE[27]&quot;;
                  }
              } else {
                  $template = &quot;MOD_VALUE[27]&quot;;
              }
					}
				&lt;CMSPHP:CACHE&gt;
				}
			}
			&lt;/CMSPHP:CACHE&gt;

			$item = str_replace('{name}', htmlspecialchars($con_tree[$idcat]['name'], ENT_COMPAT, 'UTF-8'), $template);
			$item = str_replace('{desc}', htmlspecialchars(get_cat_desc($idcat), ENT_COMPAT, 'UTF-8'), $item);
			//$item = str_replace('{link}', $con_tree[$idcat]['link'], $item);
			if ('MOD_VALUE[17]' == 'true')
			{
                $item = str_replace('{link}', $con_side[ $GLOBALS['SF_catinfos']-&gt;getIdcatsideStartpage($idcat) ]['link'], $item);
			} else {
			     $item = str_replace('{link}', $con_tree[$idcat]['link'], $item);
			} 
			
			$item = str_replace('{id}', $idcat, $item);
			$item = str_replace('{depth}', $depth, $item);
			if (strstr($item, '{tabindex}') !== false)
			{
				$item = str_replace('{tabindex}', $evil_global_variable_for_easy_tabindex_implementation++, $item);
			}

			&lt;CMSPHP:CACHE&gt;
			if (strstr($cms_mod['value'][24], '{first}') || strstr($cms_mod['value'][25], '{first}'))
			{
			&lt;/CMSPHP:CACHE&gt;
				if ($folder['first'])
				{
					$folder['first'] = false;
					$item = preg_replace(&quot;/{first}(.*?)({else}(.*?))?{\/first}/&quot;, &quot;\\1&quot;, $item);
				}
				else
				{
					$item = preg_replace(&quot;/{first}(.*?)({else}(.*?))?{\/first}/&quot;, &quot;\\3&quot;, $item);
				}
			&lt;CMSPHP:CACHE&gt;
			}

			if (strstr($cms_mod['value'][24], '{last}') || strstr($cms_mod['value'][25], '{last}'))
			{
			&lt;/CMSPHP:CACHE&gt;
				if (($folder['last_thing'] == 'folder') &amp;&amp; ($folder['last'] == $idcat))
				{
					$item = preg_replace(&quot;/{last}(.*?)({else}(.*?))?{\/last}/&quot;, &quot;\\1&quot;, $item);
				}
				else
				{
					$item = preg_replace(&quot;/{last}(.*?)({else}(.*?))?{\/last}/&quot;, &quot;\\3&quot;, $item);
				}
			&lt;CMSPHP:CACHE&gt;
			}
			&lt;/CMSPHP:CACHE&gt;

			$subfolder_data = print_folder_&lt;CMSPHP:CACHE&gt;echo $cms_mod['container']['id'];&lt;/CMSPHP:CACHE&gt;($subfolder, $depth+1);
						
			$temp .= str_replace(&quot;{folder}&quot;, $subfolder_data, $item);
		}
	}

	return $temp;	
}


function build_navi_tree_&lt;CMSPHP:CACHE&gt;echo $cms_mod['container']['id'];&lt;/CMSPHP:CACHE&gt;($start, $depth, $first = false)
{
	global $catlist, $con_tree, $con_side, $cms_side, $db, $mod, $cms_db, $lang;

	$entry['idcat'] = $start;
	
	if ($first)
	{
		$entry['first'] = true;
	}

	&lt;CMSPHP:CACHE&gt;
	if ($cms_mod['value'][3] != 'true')
	{
		echo 'else if (!in_array($start, $mod[\'path\'])) return $entry;';
	}

	if ($cms_mod['value'][5] &gt; 0)
	{
		echo 'if ($depth &gt;= ' . (int)$cms_mod['value'][5] . ') return $entry;';
	}
	&lt;/CMSPHP:CACHE&gt;
	

	// $hide == true &lt;=&gt; Ausgeschlossene Seiten und Ordner verbergen
	$hide = &lt;CMSPHP:CACHE&gt;echo ($cms_mod['value'][6] == 'true') ? 'true' : '(!isset($cms_side[\'view\']))';&lt;/CMSPHP:CACHE&gt;;

	&lt;CMSPHP:CACHE&gt;
	if ($cms_mod['value'][2] != 'folders')
	{
	&lt;/CMSPHP:CACHE&gt;
		// Alle zu diesem Ordner gehoerigen Seiten zusammensuchen
		foreach ($con_side as $idcatside=&gt;$page)
		{
			// Seite ins Array aufnehmen, wenn ...
			if ( ($page['idcat'] == $start) &amp;&amp;
                 (
				   &lt;CMSPHP:CACHE&gt;
				   // ... es keine Startseite ist (nur wenn keine Startseiten angezeigt werden sollen) und ...
				   if ($cms_mod['value']['4'] == '')
				   {
			         echo '($con_side[$idcatside][\'is_start\'] == \'0\') &amp;&amp;';
				   }
				   &lt;/CMSPHP:CACHE&gt;
				   (
				     // ... wir im Backend sind, oder ...
				     isset($cms_side['view']) ||
				     // ... diese online ist ...
				     ($con_side[$idcatside]['online'] != 0)
				   )
				 ) &amp;&amp;
				 // ... und diese Seite nicht ausgeschlossen wurde (oder wir im Backend sind und ausgeschlossene Seiten dort angezeigt werden sollen)
				 (!$hide || !strstr(',&lt;CMSPHP:CACHE&gt;echo str_replace(' ', '', $cms_mod['value'][8]);&lt;/CMSPHP:CACHE&gt;,', &quot;,$idcatside,&quot;))
			   )
			{
				$entry['pages'][] = $idcatside;
				
				&lt;CMSPHP:CACHE&gt;
				// &quot;Notizen&quot;-Felder der Seiten lesen, falls diese verwendet werden
				if (strstr($cms_mod['value'][22], '{desc}') || strstr($cms_mod['value'][23], '{desc}'))
				{
				&lt;/CMSPHP:CACHE&gt;

					$db-&gt;query(&quot;SELECT summary FROM `&quot; . $cms_db['side_lang'] . &quot;` WHERE idlang='&quot; . $lang . &quot;' AND idside='&quot; . $idcatside . &quot;'&quot; );
					if ($db-&gt;next_record())
					{
						$mod['desc'][$idcatside] = $db-&gt;f('summary');
					}

				&lt;CMSPHP:CACHE&gt;
				}
				&lt;/CMSPHP:CACHE&gt;
			}
		}
		//print_r($entry['pages']);print_r($cms_mod);echo &quot;xxxxxxxxxxxxxxxx&quot;;
		// seiten nur wenn mindestens zwei 
		if ('MOD_VALUE[4]' == 'gt1') {
		  if (count($entry['pages']) &lt; 2) {
		      unset($entry['pages']);
		  }
		}
		// Seiten sortieren
		if (is_array($entry['pages']))
		{
			foreach ($entry['pages'] as $idcatside)
			{
				$sortarray[] = $con_side[$idcatside]['&lt;CMSPHP:CACHE&gt;echo $cms_mod['value'][14];&lt;/CMSPHP:CACHE&gt;'];
			}
			array_multisort($sortarray, &lt;CMSPHP:CACHE&gt;echo (($cms_mod['value'][14] == 'name') ? &quot;SORT_STRING&quot; : &quot;SORT_NUMERIC&quot;) . &quot;, &quot; . $cms_mod['value'][15];&lt;/CMSPHP:CACHE&gt;, $entry['pages']);
		}

	&lt;CMSPHP:CACHE&gt;
	}
	&lt;/CMSPHP:CACHE&gt;


	&lt;CMSPHP:CACHE&gt;
	if ($cms_mod['value'][2] != 'pages')
	{
	&lt;/CMSPHP:CACHE&gt;
		
		// Lokale Kopie von $catlist, weil der &quot;foreach zeiger&quot; fuer
		// das globale Array durch die Rekursion verloren gehen wuerde
		$catlist2 = $catlist;

		// Fuer jeden Unterordner dieses Ordners diese Funktion aufrufen (Seiten und Unterordner zusammensuchen)
		foreach ($catlist2 as $idcat)
		{
			// Unterordner ins Array aufnehmen, wenn ...
			if ( ($con_tree[$idcat]['parent'] == $start) &amp;&amp;
			     (
			       // ... wir im Backend sind, oder ...
			       isset($cms_side['view']) ||
			       // ... dieser sichtbar/online ist ...
			       ($con_tree[$idcat]['visible'] != 0)
			     ) &amp;&amp;
			     // ... und dieser Ordner nicht ausgeschlossen wurde (oder wir im Backend sind und ausgeschlossene Ordner dort angezeigt werden sollen)
			     (!$hide || !strstr(',&lt;CMSPHP:CACHE&gt;echo str_replace(' ', '', $cms_mod['value'][7]);&lt;/CMSPHP:CACHE&gt;,', &quot;,$idcat,&quot;))
			   )
			{
				$entry['children'][$idcat] = build_navi_tree_&lt;CMSPHP:CACHE&gt;echo $cms_mod['container']['id'];&lt;/CMSPHP:CACHE&gt;($idcat, $depth+1);
			}
		}


		// Ordner sortieren
		if (is_array($entry['children']))
		{
			unset($sortarray);
			&lt;CMSPHP:CACHE&gt;
			if ($cms_mod['value'][14] == 'sortindex')
			{
			&lt;/CMSPHP:CACHE&gt;
				$catlist2 = array();
				foreach ($catlist as $key=&gt;$value)
				{
					if (is_array($entry['children'][$value]))
					{
						$catlist2[$value] = $key;
					}
				}
	
				foreach ($entry['children'] as $idcat =&gt; $v)
				{
					$sortarray[] = $catlist2[$idcat];
				}
				
				array_multisort($sortarray, SORT_NUMERIC, &lt;CMSPHP:CACHE&gt;echo $cms_mod['value'][15];&lt;/CMSPHP:CACHE&gt;, $entry['children']);
			&lt;CMSPHP:CACHE&gt;
			}
			else
			{
			&lt;/CMSPHP:CACHE&gt;
				foreach ($entry['children'] as $idcat =&gt; $v)
				{
					$sortarray[] = $con_tree[$idcat]['&lt;CMSPHP:CACHE&gt;echo $cms_mod['value'][14];&lt;/CMSPHP:CACHE&gt;'];
				}
				array_multisort($sortarray, &lt;CMSPHP:CACHE&gt;echo (($cms_mod['value'][14] == 'name') ? &quot;SORT_STRING&quot; : &quot;SORT_NUMERIC&quot;) . &quot;, &quot; . $cms_mod['value'][15];&lt;/CMSPHP:CACHE&gt;, $entry['children']);
			&lt;CMSPHP:CACHE&gt;
			}
			&lt;/CMSPHP:CACHE&gt;
		}

	&lt;CMSPHP:CACHE&gt;
	}
	&lt;/CMSPHP:CACHE&gt;

	if ($first)
	{
		&lt;CMSPHP:CACHE&gt;
		if (strstr($cms_mod['value'][22], '{last}') || strstr($cms_mod['value'][23], '{last}') ||
		    strstr($cms_mod['value'][24], '{last}') || strstr($cms_mod['value'][25], '{last}'))
		{
			if ($cms_mod['value'][16] == true)
			{
			&lt;/CMSPHP:CACHE&gt;
				$current = &amp;$entry;
				$parent = &amp;$entry;
				$last = false;
				do
				{
					if (is_array($current['pages']))
					{
						$temp = $current['pages'];
						$current['last'] = array_pop($temp);
						$current['last_thing'] = 'page';
						$last = true;
					}
					else if (is_array($current['children']))
					{
						$index = array_pop(array_keys($current['children']));
						$parent = &amp;$current;
						$current = &amp;$current['children'][$index];
					}
					else
					{
						$parent['last_thing'] = 'folder';
						$parent['last'] = $current['idcat'];
						$last = true;
					}
				}
				while (!$last);
			&lt;CMSPHP:CACHE&gt;
			} else {
			&lt;/CMSPHP:CACHE&gt;
				$current =&amp; $entry;
				$parent =&amp; $entry;
				$last = false;
				do
				{
					if (is_array($current['children']))
					{
						$index = array_pop(array_keys($current['children']));
						$parent =&amp; $current;
						$current =&amp; $current['children'][$index];
					}
					else if (is_array($current['pages']))
					{
						$temp = $current['pages'];
						$current['last'] = array_pop($temp);
						$current['last_thing'] = 'page';
						$last = true;
					}
					else
					{
						$parent['last_thing'] = 'folder';
						$parent['last'] = $current['idcat'];
						$last = true;
					}
				}
				while (!$last);
		&lt;CMSPHP:CACHE&gt;
			}
		}
		&lt;/CMSPHP:CACHE&gt;
	}

	return $entry;
}


/*
 * &quot;Hauptprogramm&quot;
 */

&lt;CMSPHP:CACHE&gt;
// Falls nicht alle Unterordner angezeigt werden sollen oder der Pfad als aktiv verfolgt werden soll...
if (($cms_mod['value'][2] != 'pages') &amp;&amp; (($cms_mod['value'][3] != 'true') || ($cms_mod['value'][11] == 'true')))
{
&lt;/CMSPHP:CACHE&gt;
	// Pfad vom aktuellen Ordner zum Start-Ordner &quot;berechnen&quot;
	$mod['current_idcat'] = &lt;CMSPHP:CACHE&gt;echo $idcat;&lt;/CMSPHP:CACHE&gt;;
	$mod['path'] = array();
	&lt;CMSPHP:CACHE&gt;
	if ($cms_mod['value'][11] == 'true')
	{
	&lt;/CMSPHP:CACHE&gt;
		$mod['flag'] = true;
	&lt;CMSPHP:CACHE&gt;
	}
	&lt;/CMSPHP:CACHE&gt;
	
	while ($mod['current_idcat'] != &lt;CMSPHP:CACHE&gt;echo $cms_mod['value'][1];&lt;/CMSPHP:CACHE&gt;)
	{
		$mod['path'][] = $mod['current_idcat'];
		$mod['current_idcat'] = $con_tree[$mod['current_idcat']]['parent'];

		&lt;CMSPHP:CACHE&gt;
		// Falls der Start-Ordner nicht &quot;root&quot; ist, ...
		if ($cms_mod['value'][1] != '0')
		{
		&lt;/CMSPHP:CACHE&gt;

			if ($mod['current_idcat'] == 0)
			{
				// ... aber wir dort angekommen sind und den Startordner noch nicht gefunden haben,
				// liegt die aktuelle Seite nicht im &quot;Pfad&quot;
				&lt;CMSPHP:CACHE&gt;
				if ($cms_mod['value'][11] == 'true')
				{
				&lt;/CMSPHP:CACHE&gt;
					$mod['active'] = $mod['path'];
					$mod['flag'] = false;
				&lt;CMSPHP:CACHE&gt;
				}
				&lt;/CMSPHP:CACHE&gt;
				$mod['path'] = array();
				break;
			}

		&lt;CMSPHP:CACHE&gt;
		}
		&lt;/CMSPHP:CACHE&gt;
	}
	
	&lt;CMSPHP:CACHE&gt;
	if ($cms_mod['value'][11] == 'true') {
	&lt;/CMSPHP:CACHE&gt;

		if ($mod['flag'])
		{
			$mod['active'] = $mod['path'];
		}

	&lt;CMSPHP:CACHE&gt;
	}
}
&lt;/CMSPHP:CACHE&gt;

// Mit tabindex + 1 anfangen, wenn der Startordner ungleich Root ist, da in &quot;Einleitung der Navigation&quot; der tabindex benutzt werden koennte
$evil_global_variable_for_easy_tabindex_implementation = &lt;CMSPHP:CACHE&gt;echo ($cms_mod['value'][13] + (($cms_mod['value'][1] != 0) ? 1 : 0));&lt;/CMSPHP:CACHE&gt;;

// Die Liste gemaess den gewaehlten Einstellungen aufbauen
$mod['output'] = print_folder_&lt;CMSPHP:CACHE&gt;echo $cms_mod['container']['id'];&lt;/CMSPHP:CACHE&gt;(build_navi_tree_&lt;CMSPHP:CACHE&gt;echo $cms_mod['container']['id'];&lt;/CMSPHP:CACHE&gt;(&lt;CMSPHP:CACHE&gt;echo $cms_mod['value'][1];&lt;/CMSPHP:CACHE&gt;, 0, true), 1);

&lt;CMSPHP:CACHE&gt;

if ($cms_mod['value'][12] != 'true')
{
	echo 'if ($mod[\'output\'] != &quot;&quot;) {';
}

&lt;/CMSPHP:CACHE&gt;

$mod['intro'] = &quot;MOD_VALUE[20]&quot;;
$mod['outro'] = &quot;MOD_VALUE[21]&quot;;

// Templatevariablen in Einleitung/Ende der Navigation ersetzen, falls der Startordner ungleich &quot;root&quot; ist und der Ordner sichtbar ist.
if (&lt;CMSPHP:CACHE&gt;echo ($cms_mod['value'][1] != 0) ? 'true' : 'false';&lt;/CMSPHP:CACHE&gt; &amp;&amp;
    ((isset($cms_side['view']) &amp;&amp; &lt;CMSPHP:CACHE&gt;echo ($cms_mod['value'][6] != 'true') ? 'true' : 'false';&lt;/CMSPHP:CACHE&gt;) ||
    ($con_tree[&lt;CMSPHP:CACHE&gt;echo $cms_mod['value'][1];&lt;/CMSPHP:CACHE&gt;]['visible'] != 0)) )
{
	$mod['intro'] = str_replace('{name}', htmlspecialchars($con_tree[&lt;CMSPHP:CACHE&gt;echo $cms_mod['value'][1];&lt;/CMSPHP:CACHE&gt;]['name'], ENT_COMPAT, 'UTF-8'), $mod['intro']);
	$mod['intro'] = str_replace('{desc}', htmlspecialchars(get_cat_desc(&lt;CMSPHP:CACHE&gt;echo $cms_mod['value'][1];&lt;/CMSPHP:CACHE&gt;), ENT_COMPAT, 'UTF-8'), $mod['intro']);
	$mod['intro'] = str_replace('{link}', $con_tree[&lt;CMSPHP:CACHE&gt;echo $cms_mod['value'][1];&lt;/CMSPHP:CACHE&gt;]['link'], $mod['intro']);
	$mod['intro'] = str_replace('{id}', '&lt;CMSPHP:CACHE&gt;echo $cms_mod['value'][1];&lt;/CMSPHP:CACHE&gt;', $mod['intro']);
	$mod['intro'] = str_replace('{tabindex}', '&lt;CMSPHP:CACHE&gt;echo $cms_mod['value'][13];&lt;/CMSPHP:CACHE&gt;', $mod['intro']);
	
	$mod['outro'] = str_replace('{name}', htmlspecialchars($con_tree[&lt;CMSPHP:CACHE&gt;echo $cms_mod['value'][1];&lt;/CMSPHP:CACHE&gt;]['name'], ENT_COMPAT, 'UTF-8'), $mod['outro']);
	$mod['outro'] = str_replace('{desc}', htmlspecialchars(get_cat_desc(&lt;CMSPHP:CACHE&gt;echo $cms_mod['value'][1];&lt;/CMSPHP:CACHE&gt;), ENT_COMPAT, 'UTF-8'), $mod['outro']);
	$mod['outro'] = str_replace('{link}', $con_tree[&lt;CMSPHP:CACHE&gt;echo $cms_mod['value'][1];&lt;/CMSPHP:CACHE&gt;]['link'], $mod['outro']);
	$mod['outro'] = str_replace('{id}', '&lt;CMSPHP:CACHE&gt;echo $cms_mod['value'][1];&lt;/CMSPHP:CACHE&gt;', $mod['outro']);
	$mod['outro'] = str_replace('{tabindex}', $evil_global_variable_for_easy_tabindex_implementation, $mod['outro']);
}

// Navigation ausgeben
echo $mod['intro'] . $mod['output'] . $mod['outro'];

&lt;CMSPHP:CACHE&gt;
if ($cms_mod['value'][12] != 'true')
{
	echo '}';
}
&lt;/CMSPHP:CACHE&gt;



&lt;CMSPHP:CACHE&gt;
//clean routing
$idcatside = $ln_routing['idcatside'];
$idcat = $ln_routing['idcat'];
&lt;/CMSPHP:CACHE&gt;


unset ($mod, $evil_global_variable_for_easy_tabindex_implementation);

&lt;/CMSPHP&gt;
</output>
