if ( !function_exists('suchmodul_createPageLinks') ) {
function suchmodul_createPageLinks($isFloating, $separator, $showNavLinks,$id) {
        global $mod, $cfg_client, $idcatside, $cms_mod;
        if ($isFloating &gt; 0) {
                $floatdiff = ceil($isFloating / 2);

                $start = $id - $floatdiff;
                if ($start &gt; $mod[&quot;anz&quot;]) $start = $mod[&quot;anz&quot;] - $floatdiff;
                if ($start &lt; 1) $start = 1;

                $stop = $id + $floatdiff;
                if ($stop &gt; $mod[&quot;anz&quot;]) $stop = $mod[&quot;anz&quot;];
        } else {
                $start = 1;
                $stop = $mod[&quot;anz&quot;];
        }

        if ($id &gt; 1 &amp;&amp; $showNavLinks == 'true') {
                $previd = $id - 1;
                $returnvalue .= &quot;\n&lt;a href=\&quot;&quot;.$mod['idcatlink'].&quot;&amp;amp;page=&quot;.$previd.$mod['query'].&quot;\&quot;&gt;MOD_VALUE[33]&lt;/a&gt;\n&quot;;
        }

        for ( $mod[&quot;pagecounter&quot;] = $start; $mod[&quot;pagecounter&quot;] &lt;= $stop; $mod[&quot;pagecounter&quot;]++ )
        {
                if ($mod[&quot;pagecounter&quot;] &gt; $start) $returnvalue .= $separator;
                if ($mod[&quot;pagecounter&quot;] == $id) {
                       if (&quot;MOD_VALUE[38]&quot; == 'false'){
                        $returnvalue .= &quot;&lt;span class=\&quot;MOD_VALUE[36]\&quot; &gt;[&quot;.$mod[&quot;pagecounter&quot;].&quot;]&lt;/span&gt;&quot;;
                        } else {
                        $returnvalue .= &quot;\n&lt;a class=\&quot;MOD_VALUE[36]\&quot; href=\&quot;&quot;.$mod['idcatlink'].&quot;&amp;amp;page=&quot;.$mod[&quot;pagecounter&quot;].$mod['query'].&quot;\&quot;&gt;[&quot;.$mod[&quot;pagecounter&quot;].&quot;]&lt;/a&gt;&quot;;
                        }
                } else {
                        $returnvalue .= &quot;\n&lt;a class=\&quot;MOD_VALUE[35]\&quot; href=\&quot;&quot;.$mod['idcatlink'].&quot;&amp;amp;page=&quot;.$mod[&quot;pagecounter&quot;].$mod['query'].&quot;\&quot;&gt;&quot;.$mod[&quot;pagecounter&quot;].&quot;&lt;/a&gt;&quot;;
                }
        }

        if ($id &lt; $mod[&quot;anz&quot;] &amp;&amp; $showNavLinks == 'true') {
                $nextid = $id + 1;
                $returnvalue .= &quot;\n&lt;a class=\&quot;MOD_VALUE[35]\&quot; href=\&quot;&quot;.$mod['idcatlink'].&quot;&amp;amp;page=&quot;.$nextid.$mod['query'].&quot;\&quot;&gt;MOD_VALUE[34]&lt;/a&gt;&quot;;
        }
        return $returnvalue;
}  // end function

} // end if exist



