                $mod['hidden'] .= &quot;\n&lt;input type='hidden' name='w_72' value='MOD_VALUE[72]' /&gt;\n&lt;input type='hidden' name='w_73' value='MOD_VALUE[73]' /&gt;&quot;;
                $mod['hidden'] .= &quot;\n&lt;input type='hidden' name='w_74' value='MOD_VALUE[74]' /&gt;&quot;;
