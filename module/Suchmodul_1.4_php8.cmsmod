                $mod['repl_string'] .=&quot; /&gt;&lt;label class='MOD_VALUE[2]' for='w_71'&gt; Notizen&lt;/label&gt;&lt;br /&gt;\n&lt;input type='checkbox' name='w_72' id='w_72' value='B.meta_description' &quot;;
                if($w_72 || (&quot;MOD_VALUE[72]&quot; != &quot;&quot; &amp;&amp; ( $mod['newmodus'] || !$suche ))){ $mod['repl_string'] .= &quot;checked=\&quot;checked\&quot;&quot;;}
                $mod['repl_string'] .=&quot; /&gt;&lt;label class='MOD_VALUE[2]' for='w_72'&gt; Beschreibung&lt;/label&gt;&lt;br /&gt;\n&lt;input type='checkbox' name='w_73' id='w_73' value='B.meta_keywords' &quot;;
                if($w_73 || (&quot;MOD_VALUE[73]&quot; != &quot;&quot; &amp;&amp; ( $mod['newmodus'] || !$suche ))){ $mod['repl_string'] .= &quot;checked=\&quot;checked\&quot;&quot;;}
                $mod['repl_string'] .=&quot; /&gt;&lt;label class='MOD_VALUE[2]' for='w_73'&gt; Schlüsselwörter&lt;/label&gt;&lt;br /&gt;\n&lt;input type='checkbox' name='w_74' id='w_74' value='A.value' &quot;;
                if($w_74 || (&quot;MOD_VALUE[74]&quot; != &quot;&quot; &amp;&amp; ( $mod['newmodus'] || !$suche ))){ $mod['repl_string'] .= &quot;checked=\&quot;checked\&quot;&quot;;}
