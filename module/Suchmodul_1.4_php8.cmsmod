                $mod['repl_string'] .= &quot;&gt;Titel&lt;/option&gt;\n&lt;option value='B.summary'&quot;;
                if($sort == &quot;B.summary&quot; || (&quot;MOD_VALUE[10]&quot; == &quot;B.summary&quot; &amp;&amp; ( $mod['newmodus'] || !$suche ))){ $mod['repl_string'] .= &quot; selected='selected'&quot;; }
                $mod['repl_string'] .= &quot;&gt;Notizen&lt;/option&gt;\n&lt;option value='B.meta_description'&quot;;
                if($sort == &quot;B.meta_description&quot; || (&quot;MOD_VALUE[10]&quot; == &quot;B.meta_description&quot; &amp;&amp; ( $mod['newmodus'] || !$suche ))){ $mod['repl_string'] .= &quot; selected='selected'&quot;; }
                $mod['repl_string'] .= &quot;&gt;Beschreibung&lt;/option&gt;\n&lt;option value='B.meta_keywords'&quot;;
