                $mod['repl_string'] .=&quot; /&gt;&lt;label class='MOD_VALUE[2]' for='w_70'&gt; Titel&lt;/label&gt;&lt;br /&gt;\n&lt;input type='checkbox' name='w_71' id='w_71' value='B.summary' &quot;;
