                $mod['repl_string'] .= &quot;&gt;Nichts&lt;/option&gt;\n&lt;option value='summary'&quot;;
                if($what == &quot;summary&quot; || (&quot;MOD_VALUE[8]&quot; == &quot;summary&quot; &amp;&amp; ( $mod['newmodus'] || !$suche ))){ $mod['repl_string'] .= &quot; selected='selected'&quot;; }
                $mod['repl_string'] .= &quot;&gt;Notizen&lt;/option&gt;\n&lt;option value='meta_description'&quot;;
                if($what == &quot;meta_description&quot; || (&quot;MOD_VALUE[8]&quot; == &quot;meta_description&quot; &amp;&amp; ( $mod['newmodus'] || !$suche ))){ $mod['repl_string'] .= &quot; selected='selected'&quot;; }
