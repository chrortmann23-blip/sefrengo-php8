                if($how == &quot;QUOT&quot; || (&quot;MOD_VALUE[9]&quot; == &quot;QUOT&quot; &amp;&amp; ( $mod['newmodus'] || !$suche ))){ $mod['repl_string'] .= &quot; selected='selected'&quot;; }
                $mod['repl_string'] .= &quot;&gt;exakt&lt;/option&gt;\n&lt;/select&gt;&quot;;
                $mod['tpl_form'] = str_replace(&quot;{how}&quot;,$mod['repl_string'],$mod['tpl_form']);
        } else {
                $mod['hidden'] .= &quot;\n&lt;input type='hidden' name='how' value='MOD_VALUE[9]' /&gt;\n&quot;;
        }
        // sort - Sortierungsoption
        if(strstr($mod['tpl_form'],&quot;{sort}&quot;)){
