        echo &quot;' method='post'&gt;\n&lt;div&gt;\n&quot;.$mod['tpl_form'].$mod['hidden'].&quot;\n&lt;input type='hidden' name='page' value='1' /&gt;&lt;input type='hidden' name='modus' value='&quot;.$modus.&quot;' /&gt;\n&lt;/div&gt;\n&lt;/form&gt;\n&quot;;
}
if(strlen($suche) &gt; 0){
        $mod['tpl_output'] = &quot;&quot;;
        // Die uebergebenen Werte ueberpruefen
        if (!($w_70 == &quot;B.title&quot; OR $w_70 == &quot;&quot;)) { $w_70 =&quot;B.title&quot;; }
        if (!($w_71 == &quot;B.summary&quot; OR $w_71 == &quot;&quot;)) { $w_71 =&quot;B.summary&quot;; }
        if (!($w_72 == &quot;B.meta_description&quot; OR $w_72 == &quot;&quot;)) { $w_72 =&quot;B.meta_description&quot;; }
        if (!($w_73 == &quot;B.meta_keywords&quot; OR $w_73 == &quot;&quot;)) { $w_73 =&quot;B.meta_keywords&quot;; }
        if (!($w_74 == &quot;A.value&quot; OR $w_74 == &quot;&quot;)) { $w_74 =&quot;A.value&quot;; }
        //$what ueberpruefen
        if (! sf_in_array($what,array(&quot;none&quot;,&quot;summary&quot;,&quot;meta_description&quot;,&quot;body&quot;))) {
                $what = &quot;body&quot;;
        }
        //$how ueberpruefen
        if (! sf_in_array($how,array(&quot;AND&quot;,&quot;OR&quot;,&quot;QUOT&quot;))) {
                $how = &quot;AND&quot;;
        }
        //$sort ueberpruefen
        if (! sf_in_array($sort,array(&quot;C.idcatside&quot;,&quot;B.title&quot;,&quot;B.summary&quot;,&quot;B.meta_description&quot;,&quot;B.meta_keywords&quot;))) {
                $sort = &quot;C.idcatside&quot;;
        }
        $mod['sql_fields'] = sf_implode(&quot;,&quot;,array_diff(array($w_70,$w_71,$w_72,$w_73,$w_74),array(&quot;&quot;)));
        switch($what){
                case &quot;none&quot;: $mod['get_fields']    = &quot;B.title,C.idcatside&quot;; break;
                case &quot;summary&quot;: $mod['get_fields'] = &quot;B.title,C.idcatside,B.summary&quot;; break;
                case &quot;meta_description&quot;: $mod['get_fields'] = &quot;B.title,C.idcatside,B.meta_description&quot;; break;
                case &quot;body&quot;: $mod['get_fields']    = &quot;B.title,C.idcatside,A.value&quot;; break;
        }
        if(&quot;MOD_VALUE[11]&quot; == &quot;0&quot;){
                $mod['res_limit'] = &quot;&quot;;
                $mod['res_start'] = &quot;&quot;;
        } else {
                $mod['res_limit'] = &quot;MOD_VALUE[11]&quot;;
                if($page &lt; 1 || !$page)
                        {
                                $page = &quot;1&quot;;
                                $mod['res_start'] = 0;
                        } else {
                                if (! is_numeric($page))
                                {
                                        $mod['res_start'] = 0;
                                } else {
                                        $mod['res_start'] = ($page-1) * &quot;MOD_VALUE[11]&quot;;
                                }
                        }
        }

                if ($mod['test'] == &quot;true&quot;) {echo &quot;&lt;hr /&gt;Diverses: [22]:MOD_VALUE[22] [23]:MOD_VALUE[23] [20]:MOD_VALUE[20]&lt;br /&gt;&quot;;}

        
// Suche auf Seiten beschraenken fals erwuenscht
        $mod['sql_sidecat'] = &quot;&quot;;
        if('MOD_VALUE[22]' == 'none') {
                // alle Seiten/Kategorien ausschlissen bis auf die Ausgewaehlten
                if(&quot;MOD_VALUE[23]&quot; != &quot;&quot; AND (substr_count(&quot;MOD_VALUE[23]&quot;,&quot;root&quot;)==0)) {
                        $mod['sql_sidecat'] = &quot;(C.idcat IN (MOD_VALUE[23]))&quot;;
                }
                if(&quot;MOD_VALUE[24]&quot; != &quot;&quot; AND (substr_count(&quot;MOD_VALUE[24]&quot;,&quot;root&quot;)==0)) {
                        if($mod['sql_sidecat'] == &quot;&quot;) {
                                $mod['sql_sidecat'] = &quot; AND (C.idcatside IN (MOD_VALUE[24]))&quot;;
                        } else {
                                $mod['sql_sidecat'] = &quot; AND (&quot;.$mod['sql_sidecat'].&quot; OR (C.idcatside IN (MOD_VALUE[24])) )&quot;;
                        }
                } else {
                        if($mod['sql_sidecat'] != &quot;&quot;) {
                                $mod['sql_sidecat'] = &quot; AND &quot;.$mod['sql_sidecat'];
                        }
                }
        } else {
                // alle Seiten/Kategorien erlaube bis auf die Ausgewaehlten
                if(&quot;MOD_VALUE[23]&quot; != &quot;&quot; AND (substr_count(&quot;MOD_VALUE[23]&quot;,&quot;root&quot;)==0)) {
                        $mod['sql_sidecat'] .= &quot; AND (C.idcat NOT IN (MOD_VALUE[23]))&quot;;
                }
                if(&quot;MOD_VALUE[24]&quot; != &quot;&quot; AND (substr_count(&quot;MOD_VALUE[24]&quot;,&quot;root&quot;)==0)) {
                        $mod['sql_sidecat'] .= &quot; AND (C.idcatside NOT IN (MOD_VALUE[24]))&quot;;
                }
        }

        // Suche auf die aktuelle Sprache beschraenken fals erwuenscht
        if(&quot;MOD_VALUE[20]&quot; == &quot;true&quot;) {
                $mod['sql_lang'] = &quot;&quot;;
        } else {
                $mod['sql_lang'] = &quot; AND (B.idlang = &quot;.$lang.&quot;)&quot;;
        }

        // im Backend alle Seiten durchsuchen im Frontend nur die Seiten die Online sind und auf die er berechtigung hat.
        if($sess-&gt;name == 'cms') {
                $mod['sql_online'] = &quot;&quot;;
        } else {
                $mod['sql_online'] = &quot; AND (  (B.online &amp; 0x03) = 0x01 OR (  (B.online &amp; 0x02) = 0x02 AND ( UNIX_TIMESTAMP(NOW()) BETWEEN B.start AND B.end))) &quot;;

                // Abfrage Recht: Darf geschuetzte Seiten sehen
                $mod['sql_online'] .=  ( $perm-&gt;have_perm(2, 'area_frontend', 0) ) ?  '': ' AND (B.online &amp; 0x04) = 0x00 ';
        }

        if((&quot;MOD_VALUE[25]&quot; != &quot;&quot;) AND (substr_count(&quot;MOD_VALUE[25]&quot;,&quot;true&quot;)==0)) {
                $mod['sql_content'] = &quot; AND (A.idtype IN (MOD_VALUE[25]))&quot;;
        } else {
                $mod['sql_content'] = &quot; AND (A.idtype IN (1,2,3,7,9,11,13))&quot;;
        }

        if ($mod['test'] == &quot;true&quot;) {echo &quot;&lt;hr /&gt;Kontrolle:&quot;.sf_implode(',',$_POST).&quot; --&gt; GET 70:&quot;.$w_70.&quot; 71:&quot;.$w_71.&quot; 72:&quot;.$w_72.&quot; 73:&quot;.$w_73.&quot; 74:&quot;.$w_74.&quot;&lt;br /&gt;lang: &quot;.$lang.&quot; sql: &quot;.$mod['sql_lang'];}
        if ($mod['test'] == &quot;true&quot;) {echo &quot;&lt;br /&gt;Suche: $suche&lt;br /&gt;Suche in: &quot;.$mod['sql_fields'].&quot;&lt;br /&gt;Hole: &quot;.$mod['get_fields'].&quot;&lt;br /&gt;Verbinde: $how&lt;br /&gt;Sortiere: $sort&lt;br /&gt;Page: &quot;.$mod['res_start'].&quot;,&quot;.$mod['res_limit'];}
        if ($mod['test'] == &quot;true&quot;) {echo &quot;&lt;br /&gt;sql_where:&quot;.$mod['sql_lang'].$mod['sql_online'].$mod['sql_content'].$mod['sql_sidecat'].&quot;&lt;br /&gt;&lt;hr /&gt;&quot;;}
        $result = search(array(
                        &quot;querystring&quot; =&gt; $suche,
                        &quot;sql_tables&quot;  =&gt; $cms_db['content'].&quot; A, &quot;.$cms_db['side_lang'].&quot; B, &quot;.$cms_db['cat_side'].&quot; C,&quot;.$cms_db['side'].&quot; D&quot;,
                        &quot;sql_fields&quot;  =&gt; $mod['sql_fields'],
                        &quot;get_fields&quot;  =&gt; $mod['get_fields'],
                        &quot;sql_where&quot;   =&gt; &quot;A.idsidelang = B.idsidelang AND B.idside = C.idside AND B.idside = D.idside AND D.idclient = &quot;.$client.$mod['sql_lang'].$mod['sql_online'].$mod['sql_content'].$mod['sql_sidecat'],
                        &quot;sql_group&quot;   =&gt; &quot;C.idcatside&quot;,
                        &quot;result_limit&quot;=&gt; $mod['res_limit'],
                        &quot;result_start&quot;=&gt; $mod['res_start'],
                        &quot;sort_index&quot;  =&gt; $sort,
                        &quot;default_con&quot; =&gt; $how
                        )
        );
        // Wir brauchen die Seiten, die wir ausschliessen wollen
        if ($mod['test'] == &quot;true&quot;) {echo &quot;num_rows: &quot;.$result['num_rows'].&quot;&lt;hr /&gt;&quot;;}

        $mod['nr'] = $mod['res_start']+1;
        if($result['num_rows'] &gt; 0){
                foreach($result['result'] as $mod['res']){
                        if ($mod['test'] == &quot;true&quot;) {echo &quot;Kontrolle Result&lt;br /&gt;IDcatside: &quot;.$mod['res']['idcatside'].&quot;&lt;br /&gt;Title: &quot;.$mod['res']['title'].&quot;&lt;br&gt;Nr: &quot;.$mod['nr'].&quot;&lt;hr /&gt;&quot;;}
                        $mod['repl_string'] = &quot;\n&lt;a href='&quot;.$con_side[$mod['res']['idcatside']]['link'].&quot;' class='MOD_VALUE[0]'&gt;&quot;.$mod['res']['title'].&quot;&lt;/a&gt;\n&quot;;
                        $mod['tpl_res'] = str_replace(&quot;{link}&quot;,$mod['repl_string'],&quot;MOD_VALUE[16]&quot;);
                        if($what == &quot;none&quot;){
                                $mod['repl_string'] = &quot;&quot;;
                        } elseif($what == &quot;summary&quot;){
                                $mod['repl_string'] = &quot;&lt;p class='MOD_VALUE[1]'&gt;&quot;.$mod['res']['summary'].&quot;&lt;/p&gt;&quot;;
                        } elseif($what == &quot;meta_description&quot;){
                                $mod['repl_string'] = &quot;&lt;p class='MOD_VALUE[1]'&gt;&quot;.$mod['res']['meta_description'].&quot;&lt;/p&gt;&quot;;
                        } else {
                                $mod['repl_string'] = &quot;&lt;p class='MOD_VALUE[1]'&gt;&quot;;
                                $mod['res']['value'] = strip_tags($mod['res']['value']);
                                $mod['searchvalue'] = explode (&quot; &quot;, $suche);
                                $mod['searchstart'] = strpos ($mod['res']['value'],$mod['searchvalue'][0])-40;
                                if ($mod['searchstart'] &lt; 0) {
                                        $mod['searchstart']=0;
                                } else {
                                        $mod['repl_string'] .= &quot;...&quot;;
                                        $mod['searchstart'] = strpos ($mod['res']['value'],&quot; &quot;,$mod['searchstart']);
                                }

                                if ($mod['test'] == &quot;true&quot;) {echo &quot;Wort:'&quot;.$mod['searchvalue'][0].&quot;' Start:&quot;.$mod['searchstart'].&quot;&lt;hr /&gt;&quot;;}
                                $mod['repl_string'] .= substr($mod['res']['value'],$mod['searchstart'],300).&quot;...&lt;/p&gt;&quot;;
                        }
                        $mod['tpl_res'] = str_replace(&quot;{descr}&quot;,$mod['repl_string'],$mod['tpl_res']);
                        $mod['tpl_res'] = str_replace(&quot;{nr}&quot;,$mod['nr'],$mod['tpl_res']);
                        $mod['tpl_output'] .= $mod['tpl_res'];
                        $mod['nr']=$mod['nr']+1;
                }
        } else {
                $mod['tpl_res'] = &quot;&lt;p class='MOD_VALUE[4]'&gt;MOD_VALUE[19]&lt;/p&gt;&quot;;
                $mod['tpl_output'] .= $mod['tpl_res'];
        }

        $mod['tpl_res_pre'] = str_replace(&quot;{count}&quot;,$result['num_rows'],&quot;MOD_VALUE[15]&quot;);

        if($result['num_rows'] &gt; 0 &amp;&amp; $mod['res_limit'] != &quot;&quot; ) {
                $mod['anz'] = $result['num_rows'];
                $mod['query'] = &quot;&amp;amp;w_70=$w_70&amp;amp;w_71=$w_71&amp;amp;w_72=$w_72&amp;amp;w_73=$w_73&amp;amp;w_74=$w_74&amp;amp;what=$what&amp;amp;how=$how&amp;amp;modus=$modus&amp;amp;sort=$sort&amp;amp;suche=&quot;;
                $mod['query'] .= rawurlencode($suche);

                // gesamtanzahl der seiten herausfinden
                if(&quot;MOD_VALUE[11]&quot; == &quot;0&quot;){
                        $mod[&quot;anz&quot;] = 1;
                } else {
                        $mod[&quot;anz&quot;] = ceil($result['num_rows'] / &quot;MOD_VALUE[11]&quot;);
                }

                // wenn mod_value_32 leer ist, default-separator verwenden.
                if (&quot;MOD_VALUE[32]&quot; == &quot;&quot;)
                {
                        $separator = &quot;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&quot;;
                } else {
                        $separator = &quot;MOD_VALUE[32]&quot;;
                }
                $mod['idcatlink']= $con_side[$idcatside]['link'];
                // vor/zurück-links anzeigen?
                if ($mod[&quot;anz&quot;]&gt; 1)$mod[&quot;nav&quot;] .= suchmodul_createPageLinks(&quot;MOD_VALUE[31]&quot;, $separator, &quot;MOD_VALUE[30]&quot;, $page);
      
          if ($mod['test'] == &quot;true&quot;) {echo &quot;&lt;hr /&gt;Kontrolle Navigation: Anz &quot;.$mod[&quot;anz&quot;].&quot; Seperator:&quot;.$separato.&quot;:   &lt;br&gt;Page: &quot;.$page.&quot; [31]:MOD_VALUE[31] [30]:MOD_VALUE[30] [18]:MOD_VALUE[18]&lt;br /&gt;&quot;;}

                $mod['tpl_nav'] = str_replace(&quot;{nav}&quot;, $mod['nav'],&quot;MOD_VALUE[18]&quot;);
		
		$mod['tpl_res_pre']  = str_replace(&quot;{nav}&quot;, $mod['nav'],$mod['tpl_res_pre']);
		$mod['tpl_res_past'] = str_replace(&quot;{nav}&quot;, $mod['nav'],&quot;MOD_VALUE[17]&quot;);
		
		$mod['tpl_output'] = $mod['tpl_res_pre'].$mod['tpl_output'].$mod['tpl_res_past'];
		
	        echo $mod['tpl_output'];
		echo $mod['tpl_nav'];
		
        } else {
        	$mod['tpl_output'] = $mod['tpl_res_pre'].$mod['tpl_output'];
	        echo $mod['tpl_output'];
		
	        echo &quot;MOD_VALUE[17]&quot;;
	}        	
}
echo &quot;MOD_VALUE[41]&quot;;
unset($mod,$separator,$result);
&lt;/CMSPHP&gt;</output>
   <config></config>
   <repository_id>mod:931d2fc5c322bbcd2be1842c6a3c5db2:f7d22b0f</repository_id>
