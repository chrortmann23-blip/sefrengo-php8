// **** Tags definieren **************************************************************
$elements['none'] = '';

// for a overall speed up it's needed to convert the temp-tag array into a string
// and recognize the elements via strpos (in_array is slow)
$cflex_temp_elmt_str=sf_implode(' ',$modtemp['tags'][1]);
// the helper funtion cflex_chkelmt is only a strpos workaround to leave the
// tag definition code part like before with in_array ;) 
if(! function_exists('cflex_chkelmt')){
	function cflex_chkelmt($clfex_element,$cflex_tpl_elements)
	{
		if (strpos($cflex_tpl_elements,$clfex_element)!==false)
			return true;
		else
			return false;
	}
}

if(! function_exists('cflex_getfsize')){
	function cflex_getfsize($cflex_file)
	{
			global $modv;
			$cflex_filesize = '';
			if ($cflex_file != '') {
					if (is_file($cflex_file)) {
							$cflex_filesize = filesize($cflex_file);
							if ($cflex_filesize &gt; 1048576) $cflex_filesize = sprintf( &quot;%01.&quot;.$modv['val_fsplaces'].&quot;f&quot;, $cflex_filesize/1048576).' '.$modv['str_megabyte'];
							else $cflex_filesize = ($cflex_filesize &gt; 1024) ? sprintf( &quot;%01.&quot;.$modv['val_fsplaces'].&quot;f&quot;, $cflex_filesize/1024).' '.$modv['str_kilobyte']: $cflex_filesize.' '.$modv['str_byte'];
					}
			}
			return $cflex_filesize;
	}
}

if (cflex_chkelmt('filetype',$cflex_temp_elmt_str)) {
	$sql = &quot;SELECT * FROM &quot;.$cms_db['filetype'];
	$db-&gt;query($sql);
	$modv['filetypes']=Array();
	while ($db-&gt;next_record()) {
		$modv['filetypes'][strtolower($db-&gt;f('filetype'))]['filetype']=$db-&gt;f('filetype');
		$modv['filetypes'][strtolower($db-&gt;f('filetype'))]['filetypepict']=$db-&gt;f('filetypepict');
		$modv['filetypes'][strtolower($db-&gt;f('filetype'))]['filetypedesc']=$db-&gt;f('description');
		$modv['filetypes'][strtolower($db-&gt;f('filetype'))]['filemimetype']=$db-&gt;f('mimetype');
	}
}

// Function that gets the name of the side or cat based on the url
if(! function_exists('cflex_getSFSideTitle'))
{
  function cflex_getSFSideTitle($url)
  {
    global $SF_pageinfos, $SF_catinfos;
    $result = &quot;&quot;;

    if (strpos($url,'idcat')!==false) {

	    preg_match(&quot;/idcatside=(.*?)&amp;/&quot;, urldecode($url . &quot;&amp;&quot;), $matches_side);
	    preg_match(&quot;/idcat=(.*?)&amp;/&quot;, urldecode($url . &quot;&amp;&quot;), $matches_cat);
	    $catsideid = $matches_side[1];
	    $catid = $matches_cat[1];
	
	    // The URL matched a page    
	    if (is_object($SF_pageinfos) &amp;&amp; $catsideid) {
	      $result = $SF_pageinfos-&gt;getTitle($catsideid);
	    }
	
	    // The URL matched a folder
	    if (is_object($SF_catinfos) &amp;&amp; $catid) {
	      $result = $SF_catinfos-&gt;getTitle($catid);
	    }

		}

    return trim($result);

  }

}

// Function that gets the description of the side or cat based on the url
if(! function_exists('cflex_getSFSideDesc'))
{
  function cflex_getSFSideDesc($url)
  {
    global $SF_pageinfos, $SF_catinfos;
    $result = &quot;&quot;;

    if (strpos($url,'idcat')!==false) {

	    preg_match(&quot;/idcatside=(.*?)&amp;/&quot;, urldecode($url . &quot;&amp;&quot;), $matches_side);
	    preg_match(&quot;/idcat=(.*?)&amp;/&quot;, urldecode($url . &quot;&amp;&quot;), $matches_cat);
	    $catsideid = $matches_side[1];
	    $catid = $matches_cat[1];
	
	    // The URL matched a page    
	    if (is_object($SF_pageinfos) &amp;&amp; $catsideid) {
	      $result = $SF_pageinfos-&gt;getMetaDescription($catsideid);
	    }
	
	    // The URL matched a folder
	    if (is_object($SF_catinfos) &amp;&amp; $catid) {
	      $result = $SF_catinfos-&gt;getDescription($catid);
	    }

		}

    return trim($result);

  }

}

// Function that gets the summary of the side or nothing (in case of cat) based on the url
if(! function_exists('cflex_getSFSideSummary'))
{
  function cflex_getSFSideSummary($url)
  {
    global $SF_pageinfos, $SF_catinfos;
    $result = &quot;&quot;;

    if (strpos($url,'idcat')!==false) {

	    preg_match(&quot;/idcatside=(.*?)&amp;/&quot;, urldecode($url . &quot;&amp;&quot;), $matches_side);
	    preg_match(&quot;/idcat=(.*?)&amp;/&quot;, urldecode($url . &quot;&amp;&quot;), $matches_cat);
	    $catsideid = $matches_side[1];
	    $catid = $matches_cat[1];
	
	    // The URL matched a page    
	    if (is_object($SF_pageinfos) &amp;&amp; $catsideid) {
	      $result = $SF_pageinfos-&gt;getSummary($catsideid);
	    }
	
	    // The URL matched a folder
	    if (is_object($SF_catinfos) &amp;&amp; $catid) {
	      $result = &quot;&quot;;
	    }

		}

    return trim($result);

  }

}
