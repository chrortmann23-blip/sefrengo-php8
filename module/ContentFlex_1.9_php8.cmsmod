		$elements['fl_selected_filetarget'] = &lt;cms:mod type=&quot;file&quot; id=&quot;200&quot; addslashes=&quot;true&quot; mode=&quot;target&quot; menuoptions=&quot;false&quot;&gt;;
		
		$elements['fl_selected_filesize'] = cflex_getfsize(&lt;cms:mod type=&quot;file&quot; id=&quot;200&quot; addslashes=&quot;true&quot; mode=&quot;path&quot; menuoptions=&quot;false&quot;&gt;);

		if ('MOD_VALUE[2019]'=='true')
			$elements['fl_subdirs']				 = &lt;cms:mod type=&quot;checkbox&quot; elementName=&quot;&quot; elementValue=&quot;true&quot; elementValueUnchecked=&quot;false&quot; title=&quot;MOD_VALUE[2001]&quot; id=&quot;201&quot; addslashes=&quot;true&quot; menuoptions=&quot;false&quot; /&gt;;

 		$elements['editfile:200']		 = &lt;cms:mod type=&quot;file&quot; id=&quot;200&quot; title=&quot;MOD_VALUE[2000]&quot; mode=&quot;editbutton&quot; hidetarget=&quot;MOD_VALUE[27]&quot; folders=&quot;MOD_VALUE[2018]&quot; subfolders=&quot;MOD_VALUE[2019]&quot; filetypes=&quot;MOD_VALUE[2006]&quot; addslashes=&quot;true&quot; menuoptions=&quot;false&quot; /&gt;;

}



// **** Template abarbeiten	 **************************************************************

// imagedimension
if(strpos($modv['tpl_inner'],'{imagedimensions:')!==false)
	for ($i=1;$i&lt;4;$i++)
		if(strpos($modv['tpl_inner'],'{imagedimensions:'.$i.'}')!==false)
				$elements['imagedimensions:'.$i]=str_replace(array('{width}','{height}'),
																							 			array($elements['imagewidth:'.$i],$elements['imageheight:'.$i]),
																										$modv['tpl_imgdimensions']);
// global hide
if(strpos($modv['tpl_inner'],'{hide}')!==false)
	$modv['tpl_inner'] = preg_replace('#\{hide\}(.*)\{/hide\}#sU','',$modv['tpl_inner']);

// global if-backend
if(strpos($modv['tpl_inner'],'{if_backend}')!==false)
	if (($sess-&gt;name == 'sefrengo' &amp;&amp; $view != 'preview')) {
		$modv['tpl_inner'] = str_replace(array('{if_backend}','{/if_backend}'), array('',''), $modv['tpl_inner']);
	} else {
		$modv['tpl_inner'] = preg_replace('#\{if_backend\}(.*)\{/if_backend\}#sU','',$modv['tpl_inner']);
	}
// global if-previw
if(strpos($modv['tpl_inner'],'{if_preview}')!==false)
	if (($sess-&gt;name == 'sefrengo' &amp;&amp; $view == 'preview')) {
		$modv['tpl_inner'] = str_replace(array('{if_preview}','{/if_preview}'), array('',''), $modv['tpl_inner']);
	} else {
		$modv['tpl_inner'] = preg_replace('#\{if_preview\}(.*)\{/if_preview\}#sU','',$modv['tpl_inner']);
	}

if ($cms_mod['modul']['id'] == '1')
	$cf_paracounter=0;
$cf_paracounter++;
$modv['tpl_inner']=str_replace('{no}',$cf_paracounter, $modv['tpl_inner']);

foreach($elements AS $k =&gt; $v){

		$modv['tpl_inner']=element_ifstatements($modv['tpl_inner'],$elements,$k,$v);

		// insert content
	 	$modv['tpl_inner'] = str_replace('{'.$k.'}', $v, $modv['tpl_inner']);

 		if (strpos($modv['tpl_inner'],'{uni:')!==false)
 			$modv['tpl_inner']=str_replace(	array('{uni:1}',
 																						'{uni:2}',
 																						'{uni:3}',
 																						'{uni:4}',
 																						'{uni:5}',
 																						'{uni:6}'),
 																			array($modv['MOD_VALUE_6000'],
 																						$modv['MOD_VALUE_6001'],
 																						$modv['MOD_VALUE_6002'],
 																						$modv['MOD_VALUE_6003'],
 																						$modv['MOD_VALUE_6004'],
 																						$modv['MOD_VALUE_6005']),
 																			$modv['tpl_inner']); 

		// check for list-element and generate table-html
		if (strpos($modv['tpl_inner'],'{list:1}')!==false)
			$modv['tpl_inner'] = str_replace('{list:1}',
																			 txt2htmllist(	$modv['MOD_VALUE_4010'],
																											$modv['MOD_VALUE_4020'],
																											$elements['list_data1']),
																			 $modv['tpl_inner']); 
		if (strpos($modv['tpl_inner'],'{list:2}')!==false)
			$modv['tpl_inner'] = str_replace('{list:2}',
																			 txt2htmllist(	$modv['MOD_VALUE_4110'],
																											$modv['MOD_VALUE_4120'],
																											$elements['list_data2']),
																			 $modv['tpl_inner']); 
																					 																			 
		// check for table-element and generate table-html
		if (strpos($modv['tpl_inner'],'{table}')!==false)
			$modv['tpl_inner'] = str_replace('{table}',
																			 txt2htmltable( $elements['table_caption'],
																											$elements['table_head'],
																											$elements['table_foot'],
																											$elements['table_data']),
																			 $modv['tpl_inner']); 

 		// check for filelist-element and generate list
		if (strpos($modv['tpl_inner'],'{filelist}')!==false){
			$modv['filelist_feature_used']=true;
			$modv['tpl_inner'] = str_replace(	'{filelist}',
																				contentflexfilelist($elements['fl_selected_fileurl'],
																														$modv['MOD_VALUE_2010'],
																														$modv['MOD_VALUE_2013'],
																														$modv['MOD_VALUE_2011'],
																														$modv['MOD_VALUE_2030'],
																														$modv['MOD_VALUE_2014'],
																														$modv['MOD_VALUE_2012'],
																														$elements['fl_subdirs'],																														
																														$modv['MOD_VALUE_2019'],
																														$modv['MOD_VALUE_2018'],
																														$modv['MOD_VALUE_2006'],
																														$modv['MOD_VALUE_2031'],
																														$modv['MOD_VALUE_2032'],
																														$modv['MOD_VALUE_2002'],
																														$modv['MOD_VALUE_2000'],
																														$modv['MOD_VALUE_2001'],
																														$modv['MOD_VALUE_2005'],
																														$modv['MOD_VALUE_2116'],
																														$modv['MOD_VALUE_2004'],
																														$modv['MOD_VALUE_2015'],
																														$modv['MOD_VALUE_2020'],
																														$modv['MOD_VALUE_2003'],
																														$modv['MOD_VALUE_2022'],																														
																														$modv['MOD_VALUE_2021'],
																														$modv['MOD_VALUE_2023'],
																														$modv['MOD_VALUE_2016']),		 																												
																				$modv['tpl_inner']); 
		} else {
 				$modv['filelist_feature_used']=false;
		}
		
}

// kill absolute pathes
if ($modv['MOD_VALUE_95']!='false' &amp;&amp;
		strpos($modv['tpl_inner'],$cfg_client['upl_htmlpath'])!==false &amp;&amp;
		strpos($cfg_client['upl_htmlpath'],$cfg_client['htmlpath'])!==false)
	$modv['tpl_inner']=str_replace($cfg_client['htmlpath'],'',$modv['tpl_inner']);

$modv['tpl_inner'] = str_replace('{container_id}',$cms_mod['container']['id'],$modv['tpl_inner']);
$modv['tpl_inner'] = str_replace('{mod_key}',$cms_mod['key'],$modv['tpl_inner']);
$modv['tpl_inner'] = str_replace('{cat_name}',$con_tree[$idcat]['name'],$modv['tpl_inner']);
$modv['tpl_inner'] = str_replace('{side_name}',$con_side[$idcatside]['name'],$modv['tpl_inner']);


// Template mit den allgemeinem Inhalt ersetzen
foreach($elements1 AS $k =&gt; $v){
		$modv['tpl_inner'] = str_replace('{'.$k.'}', $v, $modv['tpl_inner']);
}

// urlencode
if(strpos($modv['tpl_inner'],'{urlencode}')!==false) {
		$thisstring=getstringparts($modv['tpl_inner'],'{urlencode}','{/urlencode}');
		$modv['tpl_inner'] = preg_replace('#\{urlencode\}(.*)\{/urlencode\}#sU',urlencode($thisstring['middle']),$modv['tpl_inner']);
	}
	
// NavTemplate mit den allgemeinem Inhalt ersetzen
foreach($elements1 AS $k =&gt; $v){
		$modv['tpl_nav'] = str_replace('{'.$k.'}', $v, $modv['tpl_nav']);
}

#if(strpos($modv['tpl_inner'],'{pagebreak}')!==false) {
#	$modv['max_items']=$modv['repeat_id']-$page;
#	$modv['tpl_inner']=str_replace('{pagebreak}','',$modv['tpl_inner']);
#}
			
// Time
if ($mod['timetest'] == &quot;true&quot;) { 
		if ((bool) $cms_mod['modul']['lastentry']) 
		{
				list($usec, $sec) = explode(&quot; &quot;, microtime());
				$time_end = ((float)$usec + (float)$sec); 
				$time = $time_end - $time_start;
				$modv['tpl_inner'] .= &quot;&lt;hr&gt;execute time cache: &quot;.((int)($time*100)/100).&quot; sec / &quot;.$cms_mod['modul']['id'].&quot; =&gt; &quot;.(int)(($time/$cms_mod['modul']['id'])*1000).&quot; ms&lt;hr&gt;&quot;; 
		}
}

// ****	 **************************************************************
//Alle Variablen, die nur innerhalb des gecachten PHPs sichtbar sind,
//auch fuer dynamisches PHP zur Verfuegung stellen
echo '&lt;CMSPHP&gt;';
if (is_array($modv)) {
foreach($modv AS $k =&gt; $v){
if (! is_array($v)) {
echo '$mvars[&quot;'.$k.'&quot;] = &quot;'. addslashes($v) .'&quot;;'.&quot;\n&quot;;
}
}}
echo '&lt;/CMSPHP&gt;';

if ($mod['test'] == &quot;true&quot;) { echo &quot;&lt;hr&gt;&quot;; }

unset($modv, $modtemp, $elements, $elements1, $spezelements, $typegroup_conf, $k, $v);
&lt;/CMSPHP:CACHE&gt;
&lt;CMSPHP&gt;
// clear page cache on filelist-use
if ($mvars['filelist_feature_used']==true)
	 change_code_status($idcatside, 1, 'idcatside');

// **** include uncached ********************************************************************************************

if ($is_dev)
	include &quot;C:/_server/www/_sefrengo/mod_dev/ContentFlex/backend/inc/mod.contentflex.php&quot;;
else
	include $cms_path.&quot;inc/mod.contentflex.php&quot;;
	
&lt;/CMSPHP&gt;

