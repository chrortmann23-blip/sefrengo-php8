            $mod['temp'] = str_replace(&quot;{file}&quot;, $mod[&quot;file&quot;][$i][&quot;filename&quot;], $mod['temp']);
        } else {
            $mod['temp'] = str_replace(&quot;{file}&quot;,
                $mod[&quot;filename&quot;] . $cfg_client['thumbext'] . '_watermark_image.' . strtolower($mod[&quot;file_ext&quot;]),
                $mod['temp']);
        }


    } else {

        $mod['temp'] = str_replace(&quot;{file}&quot;, $mod[&quot;file&quot;][$i][&quot;filename&quot;], $mod['temp']);

    }


    //filedesc
    if ($mod[&quot;file&quot;][$i][&quot;title&quot;] != &quot;&quot;) {
        $mod[&quot;filedesc&quot;] = $mod[&quot;file&quot;][$i][&quot;title&quot;];
    } else {
        $mod[&quot;filedesc&quot;] = $mod[&quot;file&quot;][$i][&quot;filename&quot;];
    }
    $mod['temp'] = str_replace(&quot;{filedesc}&quot;, $mod[&quot;filedesc&quot;], $mod['temp']);

    //filename
    $mod['temp'] = str_replace(&quot;{filename}&quot;, $mod[&quot;filename&quot;], $mod['temp']);

    // path
    $mod['temp'] = str_replace(&quot;{path}&quot;, $cfg_client[&quot;upl_htmlpath&quot;] . $mod[&quot;file&quot;][$i][&quot;dirname&quot;], $mod['temp']);
    $mod['temp'] = str_replace(&quot;{real_path}&quot;, $cfg_client[&quot;upl_path&quot;] . $mod[&quot;file&quot;][$i][&quot;dirname&quot;], $mod['temp']);

    // file
    //$mod['temp'] = str_replace(&quot;{file}&quot;, $mod[&quot;file&quot;][$i][&quot;filename&quot;] ,$mod['temp']);

