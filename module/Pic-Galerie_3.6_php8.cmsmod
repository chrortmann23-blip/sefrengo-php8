// Version 3.5.1
// (c) 2005 by Sascha Postner v/o saschapi

//Achtung! Es sind noch einige Wasserzeichengeschichten in dieser Version enthalten
//Wasserzeichen werden jedoch NICHT mehr unterstützt.


##########################################################################################################################
//Hier lagere ich mal ein paar Funktionen aus
##########################################################################################################################


//Funktion zum erstellen von Wasserzeichen
if (!function_exists('make_watermark_image_galerie')) {
    function make_watermark_image_galerie($image, $watermarkfile, $new_image, $x, $y, $transition)
    {
        global $cfg_cms, $cfg_client;
        require_once 'Image/Transform.php';
        $cms_image = Image_Transform::factory($cfg_cms['image_mode']);
        $cms_image-&gt;load($image);
        $cms_watermark = Image_Transform::factory($cfg_cms['image_mode']);
        $cms_watermark-&gt;load($watermarkfile);

        //if ($x != $cms_image-&gt;img_x || $y != $cms_image-&gt;img_y) $cms_image-&gt;resize($x, $y);
        //$watermark = imagecreatefromstring(base64_decode($watermarkfile));
        $watermark_width = imagesx($cms_watermark-&gt;imageHandle);
        $watermark_height = imagesy($cms_watermark-&gt;imageHandle);
        //(Bild, Watermark, Position des Watermarks X, Position des Watermarks Y, Breite des Bilds, HÃ¶he des Bilds Y, Breite des Watermarks, HÃ¶he des Bildes, Transparenz)
        imagecopymerge($cms_image-&gt;imageHandle, $cms_watermark-&gt;imageHandle, $x, $y, 0, 0, $watermark_width,
            $watermark_height, $transition);
        $cms_image-&gt;save($new_image);
        $cms_image-&gt;free();
        unset($cms_image);
    }
}


//Funktion zum auslesen der ThumbgrÃ¶Ã¾en
if (!function_exists('get_thumb_size')) {
    function get_thumb_size($xy, $thumb)
    {
        global $cfg_cms, $cfg_client;
        require_once 'Image/Transform.php';
        $cms_image = Image_Transform::factory($cfg_cms['image_mode']);
        $cms_image-&gt;load($thumb);

        //if ($x != $cms_image-&gt;img_x || $y != $cms_image-&gt;img_y) $cms_image-&gt;resize($x, $y);
        //$watermark = imagecreatefromstring(base64_decode($watermarkfile));
        $width = imagesx($cms_image-&gt;imageHandle);
        $height = imagesy($cms_image-&gt;imageHandle);
        $cms_image-&gt;free();
        unset($cms_image);

        if ($xy == 'x') {
            return $width;
        } elseif ($xy == 'y') {
            return $height;
        }

    }
}


//Funktion zum umwandeln von Bilder IDs in Pfade
if (!function_exists('get_path')) {
    function get_path($id)
    {
        global $cfg_cms, $cfg_client, $cms_db, $db, $cms_mod;

        $sql = &quot;SELECT A.*, B.dirname
    FROM
    &quot; . $cms_db['upl'] . &quot; as A, &quot; . $cms_db['directory'] . &quot; as B
    WHERE
    idupl='&quot; . $id . &quot;'
    AND
    A.iddirectory = B.iddirectory&quot;;

        $db-&gt;query($sql);
        $db-&gt;next_record();
        $filepath = $cfg_client[&quot;upl_path&quot;] . $db-&gt;f('dirname') . $db-&gt;f('filename');

        return $filepath;
    }
}


###########################################################################################################################
#Hier ein paar Variablen, die wir Ã?berall brauchen
###########################################################################################################################

//Variable fÃ?r den Link zur aktuellen Seite mit Session ID
$mod['idcatlink'] = $con_side[$idcatside]['link'];

//Auslesen ob im Frontend-Editiert werden darf
$mod['frontedit'] = &quot;MOD_VALUE[51]&quot;;

//Auslesen ob mit Detailansicht gestartet wird
$mod['detailid_start'] = &quot;MOD_VALUE[60]&quot;;

//Auslesen ob Thumbs in der Detailansicht verwendet werden
$mod['detailid_thumb'] = &quot;MOD_VALUE[61]&quot;;

//Ordner beim Editieren im Frontend (inkl. Container fÃ?r mehrere Galerien pro Seite
$mod['change_dir_string'] = &quot;change_dir_&quot; . $cms_mod['container']['id'];
$mod['change_dir'] = ${$mod['change_dir_string']};

//Anzahl der Bilder pro Seite
$mod[&quot;number_of_pics_per_page&quot;] = MOD_VALUE[6];

//Anzahl der Bilder pro Zeile
$mod[&quot;break_after_number_of_pics&quot;] = MOD_VALUE[7];

//Thumbtext im Projekt
$mod[&quot;filename_suffix&quot;] = $cfg_client[&quot;thumbext&quot;];

//Auslesen welche Galerieseite angezeigt werden soll
if (isset($galerie)) {
    $mod[&quot;galerie&quot;] = array();
    $mod[&quot;galerie&quot;] = explode(&quot;_&quot;, $galerie);
    for ($i = 0; $i &lt; sf_count($mod[&quot;galerie&quot;]) / 2; $i++) {
        if ($cms_mod['container']['id'] == $mod[&quot;galerie&quot;][$i * 2]) {
            $id = $mod[&quot;galerie&quot;][$i * 2 + 1];
        } else {
            $mod['query'] .= &quot;_&quot; . $mod[&quot;galerie&quot;][$i * 2] . &quot;_&quot; . $mod[&quot;galerie&quot;][$i * 2 + 1];
        }
    }
}

//soll eine bestimmte Galerieseite angezeigt werden?
if (!isset($id)) {
    if (&quot;MOD_VALUE[5]&quot; == &quot;1&quot;) {
        $id = 1;
    } else {
        $id = &quot;MOD_VALUE[5]&quot;;
    }
}

//Falls Thumbs in der Detailansicht gezeigt werden umblÃ?ttern bei Detailbildern
if ($mod['detailid_thumb'] AND !$galerie AND $detailid) {
    $id = ceil($detailid / $mod[&quot;number_of_pics_per_page&quot;]);
}

// Automatisch die Dateilseiten zeigen und dann beim umblÃ?ttern die neueste Detailid zeigen
if (!isset($detailid) AND $sess-&gt;name != 'cms' AND $mod['detailid_start'] AND !$galerie) {
    $detailid = 1;
} elseif (!isset($detailid) AND $sess-&gt;name != 'cms' AND $mod['detailid_start'] AND $galerie) {
    $detailid = (($id - 1) * $mod[&quot;number_of_pics_per_page&quot;]) + 1;
}


##########################################################################################################################
// FRONTEND BEARBEITUNG (wird in der Detailansicht ausgeschlossen! Habe das fÃ?r nicht sinnvoll gehalten. LÃ?Ã¾t sich aber leicht wieder aktivieren.)
##########################################################################################################################

//Frontend-editieren
if ($mod['frontedit'] == true) {

    //bjoerns funktion
    if (!function_exists('get_val')) {
        function get_val($value_name)
        {
            global $idcatside, $cms_db, $db, $con_side, $cms_mod;

            $sql = &quot;SELECT
    *
    FROM
    &quot; . $cms_db['content_external'] . &quot;
    WHERE
    idsidelang='&quot; . $con_side[$idcatside]['idsidelang'] . &quot;'
    AND container='&quot; . $cms_mod['container']['id'] . &quot;'
    AND idtype='$value_name'&quot;;
            $db-&gt;query($sql);
            $db-&gt;next_record();

            return $db-&gt;f('value');
        }
    }

    if (!function_exists('set_val')) {
        function set_val($value_name, $value)
        {
            global $idcatside, $cms_db, $db, $con_side, $cms_mod;
            //Schauen, ob es den Wert schon gibt
            $sql = &quot;SELECT
    *
    FROM
    &quot; . $cms_db['content_external'] . &quot;
    WHERE
    idsidelang='&quot; . $con_side[$idcatside]['idsidelang'] . &quot;'
    AND container='&quot; . $cms_mod['container']['id'] . &quot;'
    AND idtype='$value_name'&quot;;
            $db-&gt;query($sql);

            //Es gibt den Wert schon -&gt; wert aktuallisieren
            if ($db-&gt;next_record()) {
                $sql = &quot;UPDATE
    &quot; . $cms_db['content_external'] . &quot;
    SET
    value='$value'
    WHERE
    idsidelang='&quot; . $con_side[$idcatside]['idsidelang'] . &quot;'
    AND container='&quot; . $cms_mod['container']['id'] . &quot;'
    AND idtype='$value_name'&quot;;
            } //Es gibt den Wert noch nicht, neu in tabelle einfÃ?gen
            else {
                $sql = &quot;INSERT INTO
    &quot; . $cms_db['content_external'] . &quot;
    (idsidelang, container, idtype, value)
    VALUES
    ('&quot; . $con_side[$idcatside]['idsidelang'] . &quot;',
    '&quot; . $cms_mod['container']['id'] . &quot;',
    '$value_name', '$value')&quot;;
            }

            $db-&gt;query($sql);

            //Letzte Ã?nderung Datum Ã?ndern!
            $sql = &quot;UPDATE &quot; . $cms_db['side_lang'] . &quot; SET lastmodified='&quot; . time() . &quot;' WHERE idsidelang='&quot; . $con_side[$idcatside]['idsidelang'] . &quot;' &quot;;
            $db-&gt;query($sql);

            //Cache lÃ¶schen
            //Seite fÃ?rs frontend neu generieren, da sich ein Wert geÃ?ndert hat
            change_code_status($idcatside, 1, 'idcatside');

        }
    }

    //Editierwechsel beachten
    if ($mod['change_dir']) {
        //Formular ist abgeschickt worden
        //Neuen Wert in die DB einfÃ?gen
        set_val('galerie_folder', $mod['change_dir']);
    }

    //Wert aus der DB holen
    $mod['galerie_folder'] = get_val('galerie_folder');


    //Bearbeitenbutton
    $aktverz = $mod['galerie_folder'];
    if ($cms_side['edit']) {

        //Startverzeichnis auslesen
        $mod['startdir'] = &quot;MOD_VALUE[52]&quot;;

        if ($mod['startdir']) {

            //Startverzeichnis Namen auslesen
            $sql = &quot;SELECT A.dirname
    FROM
    &quot; . $cms_db['directory'] . &quot; as A
    WHERE
    A.iddirectory='&quot; . $mod['startdir'] . &quot;'
    ORDER BY dirname&quot;;
            $db-&gt;query($sql);
            $db-&gt;next_record();

            $mod['startdirname'] = $db-&gt;f('dirname');

        }


        if ($mod['startdirname']) {

            //Dateimanager Verzeichnisse auslesen mit Startverzeichnis
            $sql = &quot;SELECT A.iddirectory, A.dirname
    FROM
    &quot; . $cms_db['directory'] . &quot; as A
    WHERE
    A.idclient='&quot; . $client . &quot;'
    AND A.status &amp; 0x05 = 0x00
    AND A.dirname like '&quot; . $mod['startdirname'] . &quot;%'

    ORDER BY dirname&quot;;
            $result = mysqli_query($db-&gt;Link_ID, $sql);

        } else {

            //Dateimanager Verzeichnisse auslesen
            $sql = &quot;SELECT A.iddirectory, A.dirname
    FROM
    &quot; . $cms_db['directory'] . &quot; as A
    WHERE
    A.idclient='&quot; . $client . &quot;'
    AND A.status &amp; 0x05 = 0x00

    ORDER BY dirname&quot;;
            $result = mysqli_query($db-&gt;Link_ID, $sql);

        }


        //Aktion auf aktuelle Seite legen
        $action = $con_side[$idcatside]['link'];
        //Bearbeitungsformular ausgeben
        echo &quot;&lt;div align=\&quot;center\&quot;&gt;&lt;form method=\&quot;POST\&quot; action=\&quot;$action\&quot;&gt;&lt;select name=\&quot;change_dir_&quot; . $cms_mod['container']['id'] . &quot;\&quot; size=\&quot;1\&quot;&gt;&quot;;

        while ($row = mysqli_fetch_array($result, MYSQLI_ASSOC)) {

            if ($perm-&gt;have_perm(0x01, &quot;folder&quot;, $row['iddirectory'])) {
                if ($mod['galerie_folder'] == $row['iddirectory']) {
                    echo &quot;&lt;option  selected value=\&quot;&quot;;
                } else {
                    echo &quot;&lt;option value=\&quot;&quot;;
                }
                echo $row['iddirectory'];
                echo &quot;\&quot;&gt;&quot;;
                echo $row['dirname'];
                echo &quot;&lt;/option&gt;&quot;;
            }
        }
        echo &quot;&lt;/select&gt;&quot;;
        echo &quot;&lt;input type=\&quot;submit\&quot; value=\&quot;Submit\&quot;&gt;&quot;;

        //KÃ?stchen fÃ?r Watermark neu Berechnung einfÃ?gen wenn Watermarkpfad vorhanden
        if (($mod['watermark_thumb_id']) OR ($mod['watermark_thumb_id'])) {
            echo &quot;&lt;input type=\&quot;checkbox\&quot; name=\&quot;resample_watermarks\&quot;&gt; Wasserzeichen neu berechnen?&quot;;
        }

        echo &quot;&lt;/form&gt;&lt;/div&gt;&quot;;


        unset($cms_side['edit']);
    }


} //END-Frontend-Editieren
else {
    //Wenn der Ordner in der Konfiguration eingestellt wird
    $mod['galerie_folder'] = &quot;MOD_VALUE[4]&quot;;
}


##########################################################################################################################
// Daten ermitteln
##########################################################################################################################
//Ist das Verzeichnis in der Datenbank? False bedeutet ja! Weiter unten in der if schleife wird das nochmal mÃ¶glichweise nochmal Ã?berschrieben!
//Das ist wichtig fÃ?r das Bearbeiten im Frontend. When false wird die Galerie angezeigt, wenn true bedeutet das, dass der Wert in der DB noch nicht
//gesetzt ist, was zu einem SQL-Fehler fÃ?hren wÃ?rde, der so abgefangen wird!
$mod['no_dir'] = false;


//diese if-schleife fÃ?ngt den SQL-Fehler ab wenn im FE noch kein Verzeicnis festgelegt wurde
if (($mod['galerie_folder'] == false) AND ($mod['frontedit'] == true)) {
    $mod['error_no_dir'] = &quot;&lt;div align=\&quot;center\&quot; class=\&quot;{font1}\&quot;&gt;Diese Galerie ist noch nicht eingerichtet worden.&lt;/div&gt;&quot;;
    $mod['error_no_dir'] = str_replace(&quot;{font1}&quot;, &quot;MOD_VALUE[1]&quot;, $mod['error_no_dir']);
    echo $mod['error_no_dir'];
    $mod['no_dir'] = true;
} else {
    //Mit dieser if-Schleife wird fÃ?r Unterordner gesorgt und fÃ?r &quot;Alle Ordner&quot;
    if (($mod['galerie_folder'] == false) AND ($mod['frontedit'] == false)) {
        $sql = &quot;SELECT A.*, B.dirname
    FROM &quot; . $cms_db['upl'] . &quot; as A, &quot; . $cms_db['directory'] . &quot; as B

    WHERE
    A.idclient = '$client'
    AND
    A.iddirectory = B.iddirectory
    AND
    idfiletype = 3
    ORDER BY
    A.&quot; . &quot;MOD_VALUE[15]&quot; . &quot; &quot; . &quot;MOD_VALUE[16]&quot;;
    } else {
        //Unterordner berÃ?cksichtigen?
        if (&quot;MOD_VALUE[26]&quot; == true) {

            //Name des eingestellten Verzeichnisses auslesen
            $sqlsub = &quot;SELECT A.dirname
    FROM
    &quot; . $cms_db['directory'] . &quot; as A
    WHERE
    A.iddirectory='&quot; . $mod['galerie_folder'] . &quot;'
    ORDER BY dirname&quot;;
            $db-&gt;query($sqlsub);
            $db-&gt;next_record();
            $mod['name_of_galerie_folder'] = $db-&gt;f('dirname');

            //IDs der Unterordner auslesen
            $sqlsub = &quot;SELECT A.iddirectory
    FROM
    &quot; . $cms_db['directory'] . &quot; as A
    WHERE
    A.idclient='&quot; . $client . &quot;'
    AND A.dirname like '&quot; . $mod['name_of_galerie_folder'] . &quot;%'&quot;;
            $mod['sub_dirs'] = mysqli_query($db-&gt;Link_ID, $sqlsub);

            //array mit den ids fÃ?llen
            $mod['sub_dirs_ids'] = array();
            while ($row = mysqli_fetch_array($mod['sub_dirs'], MYSQLI_ASSOC)) {
                sf_array_push($mod['sub_dirs_ids'], &quot;OR B.parentid = &quot; . $row['iddirectory'] . &quot;&quot;);
            }
            $mod['sub_dirs_ids'] = sf_implode(&quot; &quot;, $mod['sub_dirs_ids']);

            //SQL Where Abfrage fÃ?r Unterverzeichnisse fÃ?llen
            $mod['where'] = &quot;(A.iddirectory = &quot; . $mod['galerie_folder'] . &quot; &quot; . $mod['sub_dirs_ids'] . &quot;)&quot;;
        } else {
            $mod['where'] = &quot;A.iddirectory = &quot; . $mod['galerie_folder'] . &quot; &quot;;
        }

        $sql = &quot;SELECT A.*, B.dirname
    FROM &quot; . $cms_db['upl'] . &quot; as A, &quot; . $cms_db['directory'] . &quot; as B

    WHERE
    &quot; . $mod['where'] . &quot;
    AND
    A.idclient = '$client'
    AND
    A.iddirectory = B.iddirectory
    ORDER BY
    A.&quot; . &quot;MOD_VALUE[15]&quot; . &quot; &quot; . &quot;MOD_VALUE[16]&quot;;
    }

    $db-&gt;query($sql);
    $i = 0;

    //Anfang von while
    while ($db-&gt;next_record()) {
        $mod[&quot;file&quot;][$i][&quot;title&quot;] = $db-&gt;f('titel');
        $mod[&quot;file&quot;][$i][&quot;filename&quot;] = $db-&gt;f('filename');
        $mod[&quot;file&quot;][$i][&quot;idupl&quot;] = $db-&gt;f('idupl');
        $mod[&quot;file&quot;][$i][&quot;description&quot;] = $db-&gt;f('description');
        $mod[&quot;file&quot;][$i][&quot;dirname&quot;] = $db-&gt;f('dirname');
        $mod[&quot;file&quot;][$i][&quot;filesize&quot;] = $db-&gt;f('filesize');
        $mod[&quot;file&quot;][$i][&quot;width&quot;] = $db-&gt;f('pictwidth');
        $mod[&quot;file&quot;][$i][&quot;height&quot;] = $db-&gt;f('pictheight');
        $mod[&quot;file&quot;][$i][&quot;thumbwidth&quot;] = $db-&gt;f('pictthumbwidth');
        $mod[&quot;file&quot;][$i][&quot;thumbheight&quot;] = $db-&gt;f('pictthumbheight');
        ### BEGIN filter  fÃ?r &lt;order&gt;
        if (strstr($mod[&quot;file&quot;][$i][&quot;description&quot;], &quot;&lt;order&gt;&quot;)) {
            $mod['order_firstpos'] = strpos($mod[&quot;file&quot;][$i][&quot;description&quot;], &quot;&lt;order&gt;&quot;) + 7;
            $mod['order_lastpos'] = strpos($mod[&quot;file&quot;][$i][&quot;description&quot;], &quot;&lt;/order&gt;&quot;);
            $mod[&quot;file&quot;][$i]['order'] = substr($mod[&quot;file&quot;][$i][&quot;description&quot;], $mod['order_firstpos'],
                $mod['order_lastpos'] - $mod['order_firstpos']);
            $mod['order_tag'] = &quot;&lt;order&gt;&quot; . $mod[&quot;file&quot;][$i]['order'] . &quot;&lt;/order&gt;&quot;;
            $mod[&quot;file&quot;][$i][&quot;description&quot;] = str_replace($mod['order_tag'], &quot;&quot;, $mod[&quot;file&quot;][$i][&quot;description&quot;]);
        } else {
            $mod[&quot;file&quot;][$i]['order'] = &quot;ZZZ&quot;;   // wenn keine Reihenfolge definiert, dann hinten dran
        }
        ### END filter  fÃ?r &lt;order&gt;

        ### BEGIN  maximgsize
        if (&quot;MOD_VALUE[17]&quot; != &quot;&quot;) {
            if (($mod[&quot;file&quot;][$i][&quot;width&quot;] &gt; &quot;MOD_VALUE[17]&quot;) OR ($mod[&quot;file&quot;][$i][&quot;height&quot;] &gt; &quot;MOD_VALUE[17]&quot;)) {
                if ($mod[&quot;file&quot;][$i][&quot;width&quot;] &gt; $mod[&quot;file&quot;][$i][&quot;height&quot;]) {
                    $mod[&quot;file&quot;][$i][&quot;h_show&quot;] = round($mod[&quot;file&quot;][$i][&quot;height&quot;] * &quot;MOD_VALUE[17]&quot; / $mod[&quot;file&quot;][$i][&quot;width&quot;]);
                    $mod[&quot;file&quot;][$i][&quot;w_show&quot;] = &quot;MOD_VALUE[17]&quot;;
                } ELSE {
                    $mod[&quot;file&quot;][$i][&quot;w_show&quot;] = round($mod[&quot;file&quot;][$i][&quot;width&quot;] * &quot;MOD_VALUE[17]&quot; / $mod[&quot;file&quot;][$i][&quot;height&quot;]);
                    $mod[&quot;file&quot;][$i][&quot;h_show&quot;] = &quot;MOD_VALUE[17]&quot;;
                }
            } ELSE {
                $mod[&quot;file&quot;][$i][&quot;w_show&quot;] = $mod[&quot;file&quot;][$i][&quot;width&quot;];
                $mod[&quot;file&quot;][$i][&quot;h_show&quot;] = $mod[&quot;file&quot;][$i][&quot;height&quot;];
            }
            $mod[&quot;file&quot;][$i][&quot;maximgsize&quot;] = &quot;width=\&quot;&quot; . $mod[&quot;file&quot;][$i][&quot;w_show&quot;] . &quot;\&quot; height=\&quot;&quot; . $mod[&quot;file&quot;][$i][&quot;h_show&quot;] . &quot;\&quot;&quot;;
        }
        ### END maximgsize
        ### BEGIN  maximgsize2
        if (&quot;MOD_VALUE[21]&quot; != &quot;&quot;) {
            if (($mod[&quot;file&quot;][$i][&quot;width&quot;] &gt; &quot;MOD_VALUE[21]&quot;) OR ($mod[&quot;file&quot;][$i][&quot;height&quot;] &gt; &quot;MOD_VALUE[21]&quot;)) {
                if ($mod[&quot;file&quot;][$i][&quot;width&quot;] &gt; $mod[&quot;file&quot;][$i][&quot;height&quot;]) {
                    $mod[&quot;file&quot;][$i][&quot;h_show&quot;] = round($mod[&quot;file&quot;][$i][&quot;height&quot;] * &quot;MOD_VALUE[21]&quot; / $mod[&quot;file&quot;][$i][&quot;width&quot;]);
                    $mod[&quot;file&quot;][$i][&quot;w_show&quot;] = &quot;MOD_VALUE[21]&quot;;
                } ELSE {
                    $mod[&quot;file&quot;][$i][&quot;w_show&quot;] = round($mod[&quot;file&quot;][$i][&quot;width&quot;] * &quot;MOD_VALUE[21]&quot; / $mod[&quot;file&quot;][$i][&quot;height&quot;]);
                    $mod[&quot;file&quot;][$i][&quot;h_show&quot;] = &quot;MOD_VALUE[21]&quot;;
                }
            } ELSE {
                $mod[&quot;file&quot;][$i][&quot;w_show&quot;] = $mod[&quot;file&quot;][$i][&quot;width&quot;];
                $mod[&quot;file&quot;][$i][&quot;h_show&quot;] = $mod[&quot;file&quot;][$i][&quot;height&quot;];
            }
            $mod[&quot;file&quot;][$i][&quot;maximgsize2&quot;] = &quot;width=\&quot;&quot; . $mod[&quot;file&quot;][$i][&quot;w_show&quot;] . &quot;\&quot; height=\&quot;&quot; . $mod[&quot;file&quot;][$i][&quot;h_show&quot;] . &quot;\&quot;&quot;;
        }
        ### END maximgsize2

        $i++;

        // Ende von while
    }

    //Ende der if-else-schleife fÃ?r das Abfangen des SQL-Fehlers bei nicht vergebenem Verzeichnis
}


### BEGIN individual order
if (&quot;MOD_VALUE[15]&quot; == &quot;description&quot;) {
    function cmp($a, $b)
    {
        return strcmp($a[&quot;order&quot;], $b[&quot;order&quot;]);
    }

    function rcmp($a, $b)
    {
        return strcmp($b[&quot;order&quot;], $a[&quot;order&quot;]);
    }

    if (&quot;MOD_VALUE[16]&quot; == &quot;ASC&quot;) {
        sf_usort($mod[&quot;file&quot;], &quot;cmp&quot;);
    } else {
        sf_usort($mod[&quot;file&quot;], &quot;rcmp&quot;);
    }
}
###  // END individual order


$i = ($id - 1) * $mod[&quot;number_of_pics_per_page&quot;];
$mod[&quot;last_pic&quot;] = $id * $mod[&quot;number_of_pics_per_page&quot;];
if ($mod[&quot;last_pic&quot;] &gt; sf_count($mod[&quot;file&quot;])) {
    $mod[&quot;last_pic&quot;] = sf_count($mod[&quot;file&quot;]);
}

##########################################################################################################################
// Galerie-Walker:
##########################################################################################################################

if (!function_exists('galeriecreatePageLinks')) {
    function galeriecreatePageLinks($isFloating, $separator, $showNavLinks)
    {
        global $mod, $cfg_client, $idcatside, $id, $cms_mod;
        $returnvalue = '';

        if ($isFloating &gt; 0) {
            $floatdiff = ceil($isFloating / 2);

            $start = $id - $floatdiff;
            if ($start &gt; $mod[&quot;anz&quot;]) {
                $start = $mod[&quot;anz&quot;] - $floatdiff;
            }
            if ($start &lt; 1) {
                $start = 1;
            }

            $stop = $id + $floatdiff;
            if ($stop &gt; $mod[&quot;anz&quot;]) {
                $stop = $mod[&quot;anz&quot;];
            }
        } else {
            $start = 1;
            $stop = $mod[&quot;anz&quot;];
        }

        if ($id &gt; 1 &amp;&amp; $showNavLinks == 'true') {
            $previd = $id - 1;
            $returnvalue .= &quot;&lt;a href=\&quot;&quot; . $mod['idcatlink'] . &quot;&amp;amp;galerie=&quot; . $cms_mod['container']['id'] . &quot;_&quot; . $previd . $mod['query'] . &quot;\&quot;&gt;MOD_VALUE[13]&lt;/a&gt;&quot;;
        }

        for ($mod[&quot;pagecounter&quot;] = $start; $mod[&quot;pagecounter&quot;] &lt;= $stop; $mod[&quot;pagecounter&quot;]++) {
            if ($mod[&quot;pagecounter&quot;] &gt; $start) {
                $returnvalue .= $separator;
            }
            if ($mod[&quot;pagecounter&quot;] == $id) {
                if (&quot;MOD_VALUE[18]&quot; == false) {
                    $returnvalue .= &quot;&lt;span class=\&quot;MOD_VALUE[3]\&quot;&gt;[&quot; . $mod[&quot;pagecounter&quot;] . &quot;]&lt;/span&gt;&quot;;
                } else {
                    $returnvalue .= &quot;&lt;a href=\&quot;&quot; . $mod['idcatlink'] . &quot;&amp;amp;galerie=&quot; . $cms_mod['container']['id'] . &quot;_&quot; . $mod[&quot;pagecounter&quot;] . $mod['query'] . &quot;\&quot;&gt;&lt;span class=\&quot;MOD_VALUE[3]\&quot;&gt;[&quot; . $mod[&quot;pagecounter&quot;] . &quot;]&lt;/span&gt;&lt;/a&gt;&quot;;
                }
            } else {
                $returnvalue .= &quot;&lt;a href=\&quot;&quot; . $mod['idcatlink'] . &quot;&amp;amp;galerie=&quot; . $cms_mod['container']['id'] . &quot;_&quot; . $mod[&quot;pagecounter&quot;] . $mod['query'] . &quot;\&quot;&gt;&lt;span class=\&quot;MOD_VALUE[2]\&quot;&gt;&quot; . $mod[&quot;pagecounter&quot;] . &quot;&lt;/span&gt;&lt;/a&gt;&quot;;
            }
        }

        if ($id &lt; $mod[&quot;anz&quot;] &amp;&amp; $showNavLinks == 'true') {
            $nextid = $id + 1;
            $returnvalue .= &quot;&lt;a href=\&quot;&quot; . $mod['idcatlink'] . &quot;&amp;amp;galerie=&quot; . $cms_mod['container']['id'] . &quot;_&quot; . $nextid . $mod['query'] . &quot;\&quot;&gt;MOD_VALUE[14]&lt;/a&gt;&quot;;
        }

        return $returnvalue;
    }  // end function

} // end if exist

// gesamtanzahl der seiten herausfinden
$mod[&quot;anz&quot;] = ceil(sf_count($mod[&quot;file&quot;]) / $mod[&quot;number_of_pics_per_page&quot;]);

// wenn mod_value_12 leer ist, default-separator verwenden.
if (&quot;MOD_VALUE[12]&quot; == &quot;&quot;) {
    $separator = &quot;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&quot;;
} else {
    $separator = &quot;MOD_VALUE[12]&quot;;
}

// vor/zurÃ?ck-links anzeigen?
if ($mod[&quot;anz&quot;] &gt; 1) {
    $mod[&quot;walker&quot;] .= galeriecreatePageLinks(&quot;MOD_VALUE[11]&quot;, $separator, &quot;MOD_VALUE[10]&quot;);
}

