    $mod[&quot;filename&quot;] = substr($mod[&quot;file&quot;][$i][&quot;filename&quot;], 0, -(strlen($mod[&quot;file_ext&quot;])) - 1);


    //Wasserzeichen


    //Wasserzeichenposition errechnen

    //links oben
    if ($mod['watermark_image_location'] == 'lo') {

    } //mitte oben
    elseif ($mod['watermark_image_location'] == 'mo') {
        $mod['watermark_image_positionxx'] = (($mod[&quot;file&quot;][$i][&quot;width&quot;] / 2) + ($mod['watermark_image_positionx']));
    } //rechts oben
    elseif ($mod['watermark_image_location'] == 'ro') {
        $mod['watermark_image_positionxx'] = ($mod[&quot;file&quot;][$i][&quot;width&quot;] + ($mod['watermark_image_positionx']));
    } //links mitte
    elseif ($mod['watermark_image_location'] == 'lm') {
        $mod['watermark_image_positionyy'] = (($mod[&quot;file&quot;][$i][&quot;height&quot;] / 2) + ($mod['watermark_image_positiony']));
    } //mitte mitte
    elseif ($mod['watermark_image_location'] == 'mm') {
        $mod['watermark_image_positionxx'] = (($mod[&quot;file&quot;][$i][&quot;width&quot;] / 2) + ($mod['watermark_image_positionx']));
        $mod['watermark_image_positionyy'] = (($mod[&quot;file&quot;][$i][&quot;height&quot;] / 2) + ($mod['watermark_image_positiony']));
    } //rechts mitte
    elseif ($mod['watermark_image_location'] == 'rm') {
        $mod['watermark_image_positionxx'] = ($mod[&quot;file&quot;][$i][&quot;width&quot;] + ($mod['watermark_image_positionx']));
        $mod['watermark_image_positionyy'] = (($mod[&quot;file&quot;][$i][&quot;height&quot;] / 2) + ($mod['watermark_image_positiony']));
    } //links unten
    elseif ($mod['watermark_image_location'] == 'lu') {
        $mod['watermark_image_positionyy'] = ($mod[&quot;file&quot;][$i][&quot;height&quot;] + ($mod['watermark_image_positiony']));
    } //mitte unten
    elseif ($mod['watermark_image_location'] == 'mu') {
        $mod['watermark_image_positionxx'] = (($mod[&quot;file&quot;][$i][&quot;width&quot;] / 2) + ($mod['watermark_image_positionx']));
        $mod['watermark_image_positionyy'] = ($mod[&quot;file&quot;][$i][&quot;height&quot;] + ($mod['watermark_image_positiony']));
    } //rechts unten
    elseif ($mod['watermark_image_location'] == 'ru') {
        $mod['watermark_image_positionxx'] = ($mod[&quot;file&quot;][$i][&quot;width&quot;] + ($mod['watermark_image_positionx']));
        $mod['watermark_image_positionyy'] = ($mod[&quot;file&quot;][$i][&quot;height&quot;] + ($mod['watermark_image_positiony']));
    }


    if ($mod['watermark_image_id']) {

        //Bildformat fÃ?r die Bilder bereitstellen
        $mod['watermark_image'] = $mod[&quot;file&quot;][$i][&quot;dirname&quot;] . $mod[&quot;filename&quot;] . $cfg_client['thumbext'] . '_watermark_image.' . strtolower($mod[&quot;file_ext&quot;]);


        //If Wasserzeichen ist nicht vorhanden aber Thumb ist vorhanden
        if ((!@file_exists($cfg_client[&quot;upl_path&quot;] . $mod['watermark_image'])) OR ($resample_watermarks)) {
            make_watermark_image_galerie($cfg_client[&quot;upl_path&quot;] . $mod[&quot;file&quot;][$i][&quot;dirname&quot;] . $mod[&quot;filename&quot;] . &quot;.&quot; . strtolower($mod[&quot;file_ext&quot;]),
                $mod['watermark_image_path'],
