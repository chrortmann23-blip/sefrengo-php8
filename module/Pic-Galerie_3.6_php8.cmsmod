    $mod['temp'] = str_replace(&quot;{idupl}&quot;, $mod[&quot;file&quot;][$i][&quot;idupl&quot;], $mod['temp']);

    // filesize
    $mod['temp'] = str_replace(&quot;{filesize}&quot;, round(($mod[&quot;file&quot;][$i][&quot;filesize&quot;] / 1024), 1) . &quot; kb&quot;, $mod['temp']);

    // maximgsize
    $mod['temp'] = str_replace(&quot;{maximgsize}&quot;, $mod[&quot;file&quot;][$i][&quot;maximgsize&quot;], $mod['temp']);

    // maximgsize2
    $mod['temp'] = str_replace(&quot;{maximgsize2}&quot;, $mod[&quot;file&quot;][$i][&quot;maximgsize2&quot;], $mod['temp']);

    // width
    $mod['temp'] = str_replace(&quot;{width}&quot;, $mod[&quot;file&quot;][$i][&quot;width&quot;], $mod['temp']);

    // height
    $mod['temp'] = str_replace(&quot;{height}&quot;, $mod[&quot;file&quot;][$i][&quot;height&quot;], $mod['temp']);

