    } //mitte unten
    elseif ($mod['watermark_thumb_location'] == 'mu') {
        $mod['watermark_thumb_positionxx'] = (($mod[&quot;thumb_width&quot;] / 2) + ($mod['watermark_thumb_positionx']));
        $mod['watermark_thumb_positionyy'] = ($mod[&quot;thumb_height&quot;] + ($mod['watermark_thumb_positiony']));
    } //rechts unten
    elseif ($mod['watermark_thumb_location'] == 'ru') {
        $mod['watermark_thumb_positionxx'] = ($mod[&quot;thumb_width&quot;] + ($mod['watermark_thumb_positionx']));
        $mod['watermark_thumb_positionyy'] = ($mod[&quot;thumb_height&quot;] + ($mod['watermark_thumb_positiony']));
    }


    //Wasserzeichen in Thumbs einfÃ?gen?
    if ($mod['watermark_thumb_id']) {


        //Bildformat fÃ?r die Thumbs bereitstellen
        $mod['watermark_thumb'] = $mod[&quot;file&quot;][$i][&quot;dirname&quot;] . $mod[&quot;filename&quot;] . $cfg_client['thumbext'] . '_watermark_thumb.' . strtolower($mod[&quot;file_ext&quot;]);


        //If Wasserzeichen ist nicht vorhanden aber Thumb ist vorhanden
        if (((!@file_exists($cfg_client[&quot;upl_path&quot;] . $mod['watermark_thumb'])) AND (file_exists($cfg_client[&quot;upl_path&quot;] . $mod[&quot;file&quot;][$i][&quot;dirname&quot;] . $mod[&quot;filename&quot;] . $cfg_client['thumbext'] . &quot;.&quot; . strtolower($mod[&quot;file_ext&quot;]))) OR ($resample_watermarks))) {

            make_watermark_image_galerie($cfg_client[&quot;upl_path&quot;] . $mod[&quot;file&quot;][$i][&quot;dirname&quot;] . $mod[&quot;filename&quot;] . $cfg_client['thumbext'] . &quot;.&quot; . strtolower($mod[&quot;file_ext&quot;]),
                $mod['watermark_thumb_path'],
                $cfg_client[&quot;upl_path&quot;] . $mod[&quot;file&quot;][$i][&quot;dirname&quot;] . $mod[&quot;filename&quot;] . $cfg_client['thumbext'] . '_watermark_thumb.' . strtolower($mod[&quot;file_ext&quot;]),
                $mod['watermark_thumb_positionxx'], $mod['watermark_thumb_positionyy'],
                $mod['watermark_thumb_transparent']);
            $mod['temp'] = str_replace(&quot;{thumbfile}&quot;,
                $mod[&quot;filename&quot;] . $cfg_client['thumbext'] . '_watermark_thumb.' . strtolower($mod[&quot;file_ext&quot;]),
                $mod['temp']);
        } elseif ((strtolower($mod[&quot;file_ext&quot;])) == &quot;gif&quot;) {
            $mod['temp'] = str_replace(&quot;{thumbfile}&quot;, $mod[&quot;file&quot;][$i][&quot;filename&quot;], $mod['temp']);
        } //Elseif Wasserzeichen ist nicht vorhanden und Thumb ist nicht vorhanden
        elseif (((!@file_exists($cfg_client[&quot;upl_path&quot;] . $mod['watermark_thumb'])) AND (!@file_exists($cfg_client[&quot;upl_path&quot;] . $mod[&quot;file&quot;][$i][&quot;dirname&quot;] . $mod[&quot;filename&quot;] . $cfg_client['thumbext'] . &quot;.&quot; . strtolower($mod[&quot;file_ext&quot;]))) OR ($resample_watermarks))) {
            make_watermark_image_galerie($cfg_client[&quot;upl_path&quot;] . $mod[&quot;file&quot;][$i][&quot;dirname&quot;] . $mod[&quot;filename&quot;] . &quot;.&quot; . strtolower($mod[&quot;file_ext&quot;]),
                $mod['watermark_thumb_path'],
                $cfg_client[&quot;upl_path&quot;] . $mod[&quot;file&quot;][$i][&quot;dirname&quot;] . $mod[&quot;filename&quot;] . $cfg_client['thumbext'] . '_watermark_thumb.' . strtolower($mod[&quot;file_ext&quot;]),
                $mod['watermark_thumb_positionxx'], $mod['watermark_thumb_positionyy'],
                $mod['watermark_thumb_transparent']);
            $mod['temp'] = str_replace(&quot;{thumbfile}&quot;,
                $mod[&quot;filename&quot;] . $cfg_client['thumbext'] . '_watermark_thumb.' . strtolower($mod[&quot;file_ext&quot;]),
                $mod['temp']);


        } else {
            $mod['temp'] = str_replace(&quot;{thumbfile}&quot;,
                $mod[&quot;filename&quot;] . $cfg_client['thumbext'] . '_watermark_thumb.' . strtolower($mod[&quot;file_ext&quot;]),
                $mod['temp']);
        }


    } else {


        // thumb
        if (is_file($cfg_client[&quot;upl_path&quot;] . $mod[&quot;file&quot;][$i][&quot;dirname&quot;] . $mod[&quot;filename&quot;] . $mod[&quot;filename_suffix&quot;] . &quot;.&quot; . strtolower($mod[&quot;file_ext&quot;]))) {
            $mod['temp'] = str_replace(&quot;{thumbfile}&quot;,
                $mod[&quot;filename&quot;] . $mod[&quot;filename_suffix&quot;] . &quot;.&quot; . strtolower($mod[&quot;file_ext&quot;]), $mod['temp']);
        } else {
            $mod['temp'] = str_replace(&quot;{thumbfile}&quot;, $mod[&quot;file&quot;][$i][&quot;filename&quot;], $mod['temp']);
        }

    }


    // URLencode
    while (strstr($mod['temp'], &quot;{urlencode}&quot;)) {
        $mod['url_firstpos'] = strpos($mod['temp'], &quot;{urlencode}&quot;) + 11;
        $mod['url_lastpos'] = strpos($mod['temp'], &quot;{/urlencode}&quot;);
        $mod['url'] = substr($mod['temp'], $mod['url_firstpos'], $mod['url_lastpos'] - $mod['url_firstpos']);
        $mod['url_tag'] = &quot;{urlencode}&quot; . $mod['url'] . &quot;{/urlencode}&quot;;
        $mod['url'] = rawurlencode($mod['url']);
        $mod['temp'] = str_replace($mod['url_tag'], $mod['url'], $mod['temp']);
    }

    //
    $mod['out'] .= $mod['temp'];

    //
    if (((($i + 1) / $mod[&quot;break_after_number_of_pics&quot;]) - round((($i + 1) / $mod[&quot;break_after_number_of_pics&quot;]),
                0)) == 0) {
        $mod['out'] .= &quot;MOD_VALUE[31] \n&quot;;
        $mod['out'] .= &quot;MOD_VALUE[30] \n&quot;;
    }

}

##########################################################################################################################
//  Detailansicht Ausgabe
##########################################################################################################################
$mod['dtpl'] = &quot;MOD_VALUE[20]&quot;;

//Id der Galerieseite generieren auf der das Bild ist
$mod['pic_is_from_page'] = ceil($detailid / $mod[&quot;number_of_pics_per_page&quot;]);

//Links im Wlaker
$mod['dtplwalker_prev'] = &quot;&quot; . $mod['idcatlink'] . &quot;&amp;amp;detailid=&quot; . ($detailid - 1) . &quot;&quot;;
$mod['dtplwalker_prev_first'] = &quot;&quot; . $mod['idcatlink'] . &quot;&amp;amp;detailid=&quot; . (sf_count($mod[&quot;file&quot;])) . &quot;&quot;;
$mod['dtplwalker_galerie'] = &quot;&quot; . $mod['idcatlink'] . &quot;&amp;amp;galerie=&quot; . $cms_mod['container']['id'] . &quot;_&quot; . $mod['pic_is_from_page'] . &quot;&quot;;
$mod['dtplwalker_galeriestart'] = &quot;&quot; . $mod['idcatlink'] . &quot;&quot;;
$mod['dtplwalker_next'] = &quot;&quot; . $mod['idcatlink'] . &quot;&amp;amp;detailid=&quot; . ($detailid + 1) . &quot;&quot;;
$mod['dtplwalker_next_last'] = &quot;&quot; . $mod['idcatlink'] . &quot;&amp;amp;detailid=1&quot;;

//Tags fÃ?r die Links ersetzen
$mod['dtplwalker_22'] = &quot;MOD_VALUE[22]&quot;;
$mod['dtplwalker_25'] = &quot;MOD_VALUE[25]&quot;;
$mod['dtplwalker_23'] = &quot;MOD_VALUE[23]&quot;;
$mod['dtplwalker_22'] = str_replace(&quot;{font1}&quot;, &quot;MOD_VALUE[1]&quot;, $mod['dtplwalker_22']);
$mod['dtplwalker_22'] = str_replace(&quot;{font2}&quot;, &quot;MOD_VALUE[2]&quot;, $mod['dtplwalker_22']);
$mod['dtplwalker_22'] = str_replace(&quot;{font3}&quot;, &quot;MOD_VALUE[3]&quot;, $mod['dtplwalker_22']);
$mod['dtplwalker_25'] = str_replace(&quot;{font1}&quot;, &quot;MOD_VALUE[1]&quot;, $mod['dtplwalker_25']);
$mod['dtplwalker_25'] = str_replace(&quot;{font2}&quot;, &quot;MOD_VALUE[2]&quot;, $mod['dtplwalker_25']);
$mod['dtplwalker_25'] = str_replace(&quot;{font3}&quot;, &quot;MOD_VALUE[3]&quot;, $mod['dtplwalker_25']);
$mod['dtplwalker_23'] = str_replace(&quot;{font1}&quot;, &quot;MOD_VALUE[1]&quot;, $mod['dtplwalker_23']);
$mod['dtplwalker_23'] = str_replace(&quot;{font2}&quot;, &quot;MOD_VALUE[2]&quot;, $mod['dtplwalker_23']);
$mod['dtplwalker_23'] = str_replace(&quot;{font3}&quot;, &quot;MOD_VALUE[3]&quot;, $mod['dtplwalker_23']);
$mod['dtplwalker_23'] = str_replace(&quot;{page_id}&quot;, $mod['pic_is_from_page'], $mod['dtplwalker_23']);
$mod['dtplwalker_23'] = str_replace(&quot;{galerie}&quot;, $mod['dtplwalker_galerie'], $mod['dtplwalker_23']);
$mod['dtplwalker_23'] = str_replace(&quot;{galeriestart}&quot;, $mod['dtplwalker_galeriestart'], $mod['dtplwalker_23']);
$mod['dtpl'] = str_replace(&quot;{galerie}&quot;, $mod['dtplwalker_23'], $mod['dtpl']);

$mod['dtplwalker_prevtag'] = $mod['dtplwalker_22'];
$mod['dtplwalker_nexttag'] = $mod['dtplwalker_25'];
$mod['dtplwalker_nexttag'] = str_replace(&quot;{next}&quot;, $mod['dtplwalker_next'], $mod['dtplwalker_nexttag']);
$mod['dtplwalker_prevtag'] = str_replace(&quot;{prev}&quot;, $mod['dtplwalker_prev'], $mod['dtplwalker_prevtag']);
$mod['dtplwalker_nexttag'] = str_replace(&quot;{idupl}&quot;, $mod[&quot;file&quot;][($detailid)][&quot;idupl&quot;], $mod['dtplwalker_nexttag']);
$mod['dtplwalker_prevtag'] = str_replace(&quot;{idupl}&quot;, $mod[&quot;file&quot;][($detailid - 2)][&quot;idupl&quot;], $mod['dtplwalker_prevtag']);

//Hier wird zwischen zyklisch und endend entschieden
if (&quot;MOD_VALUE[24]&quot; == &quot;end&quot;) //ab hier wenn endend

{
    //ZurÃ?ck und Vor nicht anzeigen wenn Anfang oder Ende
    if ($detailid == 1) {
        $mod['dtpl'] = str_replace(&quot;{prev}&quot;, &quot;&quot;, $mod['dtpl']);
        $mod['dtpl'] = str_replace(&quot;{next}&quot;, $mod['dtplwalker_nexttag'], $mod['dtpl']);
    } elseif ($detailid == sf_count($mod[&quot;file&quot;])) {
        $mod['dtpl'] = str_replace(&quot;{prev}&quot;, $mod['dtplwalker_prevtag'], $mod['dtpl']);
        $mod['dtpl'] = str_replace(&quot;{next}&quot;, &quot;&quot;, $mod['dtpl']);
    } else {
        $mod['dtpl'] = str_replace(&quot;{prev}&quot;, $mod['dtplwalker_prevtag'], $mod['dtpl']);
        $mod['dtpl'] = str_replace(&quot;{next}&quot;, $mod['dtplwalker_nexttag'], $mod['dtpl']);
    }

    //ab hier wenn zyklisch
} else {
    //FÃ?r erste und letzte Variablen definieren
    $mod['dtplwalker_prev_firsttag'] = $mod['dtplwalker_22'];
    $mod['dtplwalker_next_lasttag'] = $mod['dtplwalker_25'];
    $mod['dtplwalker_next_lasttag'] = str_replace(&quot;{next}&quot;, $mod['dtplwalker_next_last'],
        $mod['dtplwalker_next_lasttag']);
    $mod['dtplwalker_prev_firsttag'] = str_replace(&quot;{prev}&quot;, $mod['dtplwalker_prev_first'],
        $mod['dtplwalker_prev_firsttag']);
    if ($detailid == 1) {
        $mod['dtpl'] = str_replace(&quot;{prev}&quot;, $mod['dtplwalker_prev_firsttag'], $mod['dtpl']);
        $mod['dtpl'] = str_replace(&quot;{next}&quot;, $mod['dtplwalker_nexttag'], $mod['dtpl']);
    } elseif ($detailid == sf_count($mod[&quot;file&quot;])) {
        $mod['dtpl'] = str_replace(&quot;{prev}&quot;, $mod['dtplwalker_prevtag'], $mod['dtpl']);
        $mod['dtpl'] = str_replace(&quot;{next}&quot;, $mod['dtplwalker_next_lasttag'], $mod['dtpl']);
    } else {
        $mod['dtpl'] = str_replace(&quot;{prev}&quot;, $mod['dtplwalker_prevtag'], $mod['dtpl']);
        $mod['dtpl'] = str_replace(&quot;{next}&quot;, $mod['dtplwalker_nexttag'], $mod['dtpl']);
    }

}


##########################################################################################################################
//  Templatevariablen ersetzen
##########################################################################################################################
//no_dir ist true, wenn im Frontencmst der Ordner noch nicht in die DB geschrieben wurde!
if ($mod['no_dir'] == false) {
    //Galerie-Template
    $mod['tpl'] = &quot;MOD_VALUE[8]&quot;;
    $mod['tpl'] = str_replace(&quot;{content}&quot;, $mod['out'], $mod['tpl']);
    $mod['tpl'] = str_replace(&quot;{id}&quot;, $id, $mod['tpl']);
    $mod['tpl'] = str_replace(&quot;{walker}&quot;, $mod['walker'], $mod['tpl']);
    $mod['tpl'] = str_replace(&quot;{font1}&quot;, &quot;MOD_VALUE[1]&quot;, $mod['tpl']);
    $mod['tpl'] = str_replace(&quot;{font2}&quot;, &quot;MOD_VALUE[2]&quot;, $mod['tpl']);
    $mod['tpl'] = str_replace(&quot;{font3}&quot;, &quot;MOD_VALUE[3]&quot;, $mod['tpl']);
    $mod['tpl'] = str_replace(&quot;{font4}&quot;, &quot;MOD_VALUE[27]&quot;, $mod['tpl']);
    $mod['tpl'] = str_replace(&quot;{font5}&quot;, &quot;MOD_VALUE[28]&quot;, $mod['tpl']);
}


//Detailansichts-Template
$mod['dtpl'] = str_replace(&quot;{pic_id}&quot;, $detailid, $mod['dtpl']);
$mod['dtpl'] = str_replace(&quot;{page_id}&quot;, $mod['pic_is_from_page'], $mod['dtpl']);
$mod['dtpl'] = str_replace(&quot;{pic_count}&quot;, sf_count($mod[&quot;file&quot;]), $mod['dtpl']);
$mod['dtpl'] = str_replace(&quot;{path}&quot;, $cfg_client[&quot;upl_htmlpath&quot;] . $mod[&quot;file&quot;][($detailid - 1)][&quot;dirname&quot;],
    $mod['dtpl']);
$mod['dtpl'] = str_replace(&quot;{real_path}&quot;, $cfg_client[&quot;upl_path&quot;] . $mod[&quot;file&quot;][($detailid - 1)][&quot;dirname&quot;],
    $mod['dtpl']);

//Normales Bild oder Watermark nutzen?
if ($mod['watermark_image_id']) {
    $mod[&quot;file_ext&quot;] = substr(strrchr($mod[&quot;file&quot;][$detailid - 1][&quot;filename&quot;], &quot;.&quot;), 1);
    $mod[&quot;filename&quot;] = substr($mod[&quot;file&quot;][$detailid - 1][&quot;filename&quot;], 0, -(strlen($mod[&quot;file_ext&quot;])) - 1);
    $mod['dtpl'] = str_replace(&quot;{file}&quot;,
        $mod[&quot;filename&quot;] . $cfg_client['thumbext'] . '_watermark_image.' . strtolower($mod[&quot;file_ext&quot;]), $mod['dtpl']);
} else {
    $mod['dtpl'] = str_replace(&quot;{file}&quot;, $mod[&quot;file&quot;][($detailid - 1)][&quot;filename&quot;], $mod['dtpl']);
}
$mod['dtpl'] = str_replace(&quot;{idupl}&quot;, $mod[&quot;file&quot;][($detailid - 1)][&quot;idupl&quot;], $mod['dtpl']);


$mod['dtpl'] = str_replace(&quot;{font1}&quot;, &quot;MOD_VALUE[1]&quot;, $mod['dtpl']);
$mod['dtpl'] = str_replace(&quot;{font2}&quot;, &quot;MOD_VALUE[2]&quot;, $mod['dtpl']);
$mod['dtpl'] = str_replace(&quot;{font3}&quot;, &quot;MOD_VALUE[3]&quot;, $mod['dtpl']);
$mod['dtpl'] = str_replace(&quot;{font4}&quot;, &quot;MOD_VALUE[27]&quot;, $mod['dtpl']);
$mod['dtpl'] = str_replace(&quot;{font5}&quot;, &quot;MOD_VALUE[28]&quot;, $mod['dtpl']);
$mod['dtpl'] = str_replace(&quot;{maximgsize}&quot;, $mod[&quot;file&quot;][($detailid - 1)][&quot;maximgsize&quot;], $mod['dtpl']);
$mod['dtpl'] = str_replace(&quot;{maximgsize2}&quot;, $mod[&quot;file&quot;][($detailid - 1)][&quot;maximgsize2&quot;], $mod['dtpl']);
$mod['dtpl'] = str_replace(&quot;{filesize}&quot;, round(($mod[&quot;file&quot;][($detailid - 1)][&quot;filesize&quot;] / 1024), 1) . &quot; kb&quot;,
    $mod['dtpl']);
$mod['dtpl'] = str_replace(&quot;{width}&quot;, $mod[&quot;file&quot;][($detailid - 1)][&quot;width&quot;], $mod['dtpl']);
$mod['dtpl'] = str_replace(&quot;{height}&quot;, $mod[&quot;file&quot;][($detailid - 1)][&quot;height&quot;], $mod['dtpl']);
$mod['dtpl'] = str_replace(&quot;{title}&quot;, $mod[&quot;file&quot;][($detailid - 1)][&quot;title&quot;], $mod['dtpl']);
$mod['dtpl'] = str_replace(&quot;{description}&quot;, $mod[&quot;file&quot;][($detailid - 1)][&quot;description&quot;], $mod['dtpl']);

$mod[&quot;file_ext&quot;] = substr(strrchr($mod[&quot;file&quot;][($detailid - 1)][&quot;filename&quot;], &quot;.&quot;), 1);
$mod[&quot;filename&quot;] = substr($mod[&quot;file&quot;][($detailid - 1)][&quot;filename&quot;], 0, -(strlen($mod[&quot;file_ext&quot;])) - 1);
//filedesc
if ($mod[&quot;file&quot;][($detailid - 1)][&quot;title&quot;] != &quot;&quot;) {
    $mod[&quot;filedesc&quot;] = $mod[&quot;file&quot;][($detailid - 1)][&quot;title&quot;];
} else {
    $mod[&quot;filedesc&quot;] = $mod[&quot;file&quot;][($detailid - 1)][&quot;filename&quot;];
}
$mod['dtpl'] = str_replace(&quot;{filedesc}&quot;, $mod[&quot;filedesc&quot;], $mod['dtpl']);
$mod['dtpl'] = str_replace(&quot;{filename}&quot;, $mod[&quot;filename&quot;], $mod['dtpl']);

// thumb oder watermark Thumb nutzen
if ($mod['watermark_thumb_id']) {

    if (is_file($cfg_client[&quot;upl_path&quot;] . $mod[&quot;file&quot;][($detailid - 1)][&quot;dirname&quot;] . $mod[&quot;filename&quot;] . $mod[&quot;filename_suffix&quot;] . &quot;.&quot; . strtolower($mod[&quot;file_ext&quot;]))) {
        $mod['dtpl'] = str_replace(&quot;{thumbfile}&quot;,
            $mod[&quot;filename&quot;] . $mod[&quot;filename_suffix&quot;] . &quot;_watermark_thumb.&quot; . strtolower($mod[&quot;file_ext&quot;]),
            $mod['dtpl']);
    }

} else {

    if (is_file($cfg_client[&quot;upl_path&quot;] . $mod[&quot;file&quot;][($detailid - 1)][&quot;dirname&quot;] . $mod[&quot;filename&quot;] . $mod[&quot;filename_suffix&quot;] . &quot;.&quot; . strtolower($mod[&quot;file_ext&quot;]))) {
        $mod['dtpl'] = str_replace(&quot;{thumbfile}&quot;,
            $mod[&quot;filename&quot;] . $mod[&quot;filename_suffix&quot;] . &quot;.&quot; . strtolower($mod[&quot;file_ext&quot;]), $mod['dtpl']);
    } else {
        $mod['dtpl'] = str_replace(&quot;{thumbfile}&quot;, $mod[&quot;file&quot;][($detailid - 1)][&quot;filename&quot;], $mod['dtpl']);
    }
}


//Ausgabe Detail-Template
if ($detailid) {

    echo $mod['dtpl'];
}

if ($mod['detailid_thumb'] OR !$detailid) {
    echo $mod['tpl'];
}

// VARIABLEN LEEREN
unset($size);
unset($id);
unset($mod);
unset($detailid);
&lt;/CMSPHP&gt;</output>
