        $mod['watermark_thumb_positionyy'] = (($mod[&quot;thumb_height&quot;] / 2) + ($mod['watermark_thumb_positiony']));
    } //rechts mitte
    elseif ($mod['watermark_thumb_location'] == 'rm') {
        $mod['watermark_thumb_positionxx'] = ($mod[&quot;thumb_width&quot;] + ($mod['watermark_thumb_positionx']));
        $mod['watermark_thumb_positionyy'] = (($mod[&quot;thumb_height&quot;] / 2) + ($mod['watermark_thumb_positiony']));
    } //links unten
    elseif ($mod['watermark_thumb_location'] == 'lu') {
