&lt;CMSPHP&gt;
echo &quot;MOD_VALUE[31]&quot;;

// INITIALISIERUNG
echo $cms_mod['value']['10'];


if(! function_exists('nav_cat_is_in_tree') ){
function nav_cat_is_in_tree( $cat, $start ){
	global $con_tree;
	
	//echo &quot;$cat, $start&quot;;return false;
	if(empty($cat) || empty($start) )
		return false;
		
	if($cat == $start)
		return true;

	while($cat != $start || ! empty($cat) ) {
		$cat = $con_tree[ $cat ]['parent'];
		if($cat == $start)
			return true;
		if($cat == '0') break;
	}
	return false;
}}


if($cms_mod['value']['9'] == 'root') {
	$mod['startpt'] = '0';
	$mod['level'] = 1;
} elseif($cms_mod['value']['9'] == 'this') {
	$mod['startpt'] = $idcat;
	$mod['level'] = 2;
} else {
	$mod['startpt'] = $cms_mod['value']['9'];
	$mod['level'] = 2;
}

$mod['startlevel'] = $catlist_level[ $mod['startpt'] ];

// OFFENEN PFAD FINDEN
if($cms_mod['value']['7'] != 'nosub') {
	$a = $idcat;
	$mod['path'] = array();
	while($a != $mod['startpt'] &amp;&amp; $catlist_level[$a] &gt; $mod['startlevel']) {
		sf_array_push($mod['path'],$a);
		$a = $con_tree[$a]['parent'];
	}
	sf_array_push($mod['path'],$mod['startpt']);
} else {
	$mod['path'] = array($mod['startpt']);
}

// ORDNERLISTE VORBEREITEN
if($mod['startpt'] == '0') {
	$mod['temp'] = 'start';
} else {
	$mod['temp'] = '';
}

$mod['catlist_temp'] = array();
$mod['tmplvl'] = '-';
foreach ($catlist as $a){
	switch ($cms_mod['value']['7']) {
		case 'nosub' :
			if ($con_tree[$a]['parent'] == $mod['startpt'] &amp;&amp; !strstr(&quot;,MOD_VALUE[25],&quot;,&quot;,$a,&quot;)) { 
				sf_array_push($mod['catlist_temp'],$a); 
			};
			break;
		case 'allsub' :
			if($a == $mod['startpt']){
				$mod['temp'] = 'start';
			} elseif ($mod['temp'] != &quot;stop&quot; &amp;&amp; $catlist_level[$a] &lt;= $mod['startlevel']){
				$mod['temp'] = &quot;stop&quot;;
			} elseif ($mod['temp'] == 'start' &amp;&amp; strstr(&quot;,MOD_VALUE[25],&quot;,&quot;,$a,&quot;)){
				$mod['temp'] = &quot;wait&quot;;
				$mod['tmplvl'] = $catlist_level[$a];
			} elseif ($mod['temp'] == 'start' &amp;&amp; &quot;MOD_VALUE[28]&quot; &gt; 0 &amp;&amp; $catlist_level[$a] &gt;= (&quot;MOD_VALUE[28]&quot;+$mod['startlevel'])){
				$mod['temp'] = &quot;level&quot;;
				$mod['tmplvl'] = $catlist_level[$a];
			} elseif ($mod['temp'] == &quot;wait&quot; &amp;&amp; $mod['tmplvl'] != &quot;-&quot; &amp;&amp; $catlist_level[$a] &lt;= $mod['tmplvl']){
				$mod['temp'] = 'start';
				$mod['tmplvl'] = &quot;-&quot;;
				sf_array_push($mod['catlist_temp'],$a);
			} elseif ($mod['temp'] == &quot;level&quot; &amp;&amp; $mod['tmplvl'] != &quot;-&quot; &amp;&amp; $catlist_level[$a] &lt; $mod['tmplvl']){
				$mod['temp'] = 'start';
				$mod['tmplvl'] = &quot;-&quot;;
				sf_array_push($mod['catlist_temp'],$a);
			} else {
				if($mod['temp'] == 'start'){
					sf_array_push($mod['catlist_temp'],$a);
				}
			}
			break;
		case 'autosub' :
			if (sf_in_array($con_tree[$a]['parent'],$mod['path']) &amp;&amp; !strstr(&quot;,MOD_VALUE[25],&quot;,&quot;,$a,&quot;)) { 
				sf_array_push($mod['catlist_temp'],$a); 
			}
			break;
	}
}

//vergleich auf parent
$mod['catlist'] = array();
if($mod['startpt'] != 0 &amp;&amp; is_array($mod['catlist_temp'])){
	foreach ($mod['catlist_temp'] as $a) {
		if( nav_cat_is_in_tree($a, $mod['startpt']) ){
			sf_array_push($mod['catlist'],$a);
		}
	}
} else {
	$mod['catlist'] = $mod['catlist_temp'];
}

// SEITENLISTE VORBEREITEN
foreach (sf_array_keys($con_side) as $a) {
	if( isset($cms_side['view'])  || ($con_side[$a]['online'] &amp;&amp; $con_side[$a]['online'] != '0')){
		if(!is_array($mod['sidelist'][$con_side[$a]['idcat']]))	$mod['sidelist'][$con_side[$a]['idcat']] = array();
		sf_array_push($mod['sidelist'][$con_side[$a]['idcat']],$a);
	}
}


// ORDNER AUSGEBEN
if($cms_mod['value']['6'] != 'side') {
	$mod['firstc'] = 1;
	$mod['lastlevel'] = $catlist_level[ $mod['catlist']['0'] ];
	foreach ($mod['catlist'] as $a) {
		if( isset($cms_side['view'])  || ($con_tree[$a]['visible'] == 1 &amp;&amp; is_array($mod['sidelist'][$a]))){
   			if($catlist_level[$a] &lt; ($mod['startlevel']+$mod['level'])) {
				if($a == $idcat || (&quot;MOD_VALUE[30]&quot; == 'true' &amp;&amp; strstr(','.sf_implode(',',$mod['path']).',' , &quot;,$a,&quot;))) $mod['tpl'] = &quot;MOD_VALUE[12]&quot;;
				else $mod['tpl'] = &quot;MOD_VALUE[11]&quot;;
				$mod['tpli'] = &quot;MOD_VALUE[13]&quot;;
				$mod['space'] = '';
			} else {
				if($a == $idcat || (&quot;MOD_VALUE[30]&quot; == 'true' &amp;&amp; strstr(','.sf_implode(',',$mod['path']).',' , &quot;,$a,&quot;))) $mod['tpl'] = &quot;MOD_VALUE[15]&quot;;
				else $mod['tpl'] = &quot;MOD_VALUE[14]&quot;;
				$mod['tpli'] = &quot;MOD_VALUE[16]&quot;;
				$mod['space'] = str_repeat('&amp;nbsp;',$catlist_level[$a]);
			}
			if($mod['firstc'] == 0){
				if($catlist_level[$a] &lt; $mod['lastlevel']) echo &quot;MOD_VALUE[27]&quot;;
				elseif($catlist_level[$a] &gt; $mod['lastlevel']) echo &quot;MOD_VALUE[26]&quot;;
				echo $mod['tpli'];
			}
			$mod['lastlevel'] = $catlist_level[$a];
			$mod['firstc'] = 0;
			$mod['temp'] = '';
			$mod['temp'] = str_replace('{space}', $mod['space'], $mod['tpl']);
			$mod['temp'] = str_replace('{name}', htmlentities($con_tree[$a]['name'], ENT_COMPAT, 'UTF-8'), $mod['temp']);
			$mod['temp'] = str_replace('{link}', $con_tree[$a]['link'], $mod['temp']);
			$mod['temp'] = str_replace('{id}', 'lang_'.$lang.'cat_'.$a, $mod['temp']);
			if (&quot;MOD_VALUE[30]&quot; == true) {
			$mod['page_count'] = sf_count($mod['sidelist'][$a]); 
			} else {
			$mod['page_count'] = sf_count($mod['sidelist'][$a]) - 1 ;
			}
			if ($mod['page_count'] &lt; 0) {
			$mod['page_count'] = 0;
			}
			$mod['temp'] = str_replace('{page_count}', $mod['page_count'], $mod['temp']);
			$mod['temp'] = str_replace('{font1}', &quot;MOD_VALUE[1]&quot;, $mod['temp']);
			$mod['temp'] = str_replace('{font2}', &quot;MOD_VALUE[2]&quot;, $mod['temp']);
			$mod['temp'] = str_replace('{font3}', &quot;MOD_VALUE[3]&quot;, $mod['temp']);
			$mod['temp'] = cms_stripslashes($mod['temp']);
			$mod['temp'] = str_replace('{s_name}', htmlentities(cms_addslashes($con_tree[$a]['name']), ENT_COMPAT, 'UTF-8'), $mod['temp']);
			echo $mod['temp'];

			// SEITEN DAZU
			if(&quot;MOD_VALUE[6]&quot; == 'groupside' &amp;&amp; is_array($mod['sidelist'][$a]) &amp;&amp; (sf_in_array($a,$mod['path']) || &quot;MOD_VALUE[7]&quot; != 'autosub')){
				// SEITEN SORTIEREN
				$mod['sortarray'] = array();
				foreach ($mod['sidelist'][$a] as $b) {
					if ($cms_mod['value']['4'] == 'name') {
						$sortit = strtolower($con_side[$b]['name']);
					} else {
						$sortit = $con_side[$b]['MOD_VALUE[4]'];
					}
					sf_array_push($mod['sortarray'], $sortit);
				}
				
				array_multisort($mod['sortarray'], MOD_VALUE[5], $mod['sidelist'][$a], MOD_VALUE[5]);
				
				// SEITEN AUSGEBEN
				$mod['firsts'] = 1;
				foreach ($mod['sidelist'][$a] as $b) {
					if(($con_side[$b]['is_start'] == '0' || &quot;MOD_VALUE[8]&quot; == 'true') &amp;&amp; !strstr(&quot;,MOD_VALUE[24],&quot;,&quot;,$b,&quot;)){
						if ($catlist_level[$a] &lt; ($mod['startlevel']+$mod['level'])) {
							$b == $idcatside ? $mod['tpl'] = &quot;MOD_VALUE[22]&quot; : $mod['tpl'] = &quot;MOD_VALUE[21]&quot;;
							$mod['tplis'] = &quot;MOD_VALUE[23]&quot;;
						} else {
		                    $b == $idcatside ? $mod['tpl'] = &quot;MOD_VALUE[18]&quot; : $mod['tpl'] = &quot;MOD_VALUE[17]&quot;;
		                    $mod['tplis'] = &quot;MOD_VALUE[19]&quot;;
		                }
						
						if($mod['firsts'] == 0) { 
							echo $mod['tplis'];
						} 
						
						$mod['firsts'] = 0;
						
						$mod['temp'] = '';
						$mod['temp'] = str_replace('{space}', str_repeat('&amp;nbsp;',($catlist_level[$a] + 1)), $mod['tpl']);
						$mod['temp'] = str_replace('{name}', htmlentities($con_side[$b]['name'], ENT_COMPAT, 'UTF-8'), $mod['temp']);
						$mod['temp'] = str_replace('{link}', $con_side[$b]['link'], $mod['temp']);
						$mod['temp'] = str_replace('{id}', 'lang_'.$lang.'side_'.$b, $mod['temp']);
						$mod['temp'] = str_replace('{font1}', &quot;MOD_VALUE[1]&quot;, $mod['temp']);
						$mod['temp'] = str_replace('{font2}', &quot;MOD_VALUE[2]&quot;, $mod['temp']);
						$mod['temp'] = str_replace('{font3}', &quot;MOD_VALUE[3]&quot;, $mod['temp']);
						$mod['temp'] = cms_stripslashes($mod['temp']);
						$mod['temp'] = str_replace('{s_name}', htmlentities(cms_addslashes($con_tree[$b]['name']), ENT_COMPAT, 'UTF-8'), $mod['temp']);
			            echo $mod['temp'];
					}
				}
			}
		}
	}
}

if($cms_mod['value']['6'] != 'group' &amp;&amp; $mod['startpt'] != '0') {
	// SEITEN SORTIEREN
	$mod['sortarray'] = array();
	if (is_array($mod['sidelist'][ $mod['startpt'] ]) ) {
		foreach($mod['sidelist'][ $mod['startpt'] ] as $b){
			 if ($cms_mod['value']['4'] == 'name') {
				$sortit = strtolower($con_side[$b]['name']);
			 } elseif ($cms_mod['value']['4'] == 'created' || $cms_mod['value']['4'] == 'lastmodified') {
				$sortit = strtotime($con_side[$b]['MOD_VALUE[4]']);
			 } else {
				$sortit = $con_side[$b]['MOD_VALUE[4]'];
			 }

			sf_array_push($mod['sortarray'], $sortit);
		}

		array_multisort($mod['sortarray'], MOD_VALUE[5], $mod['sidelist'][ $mod['startpt'] ], MOD_VALUE[5]);
		//SEITEN AUSGEBEN
		$mod['firsts'] = 1;
		foreach($mod['sidelist'][ $mod['startpt'] ] as $b){
			if (($con_side[$b]['is_start'] == '0' || &quot;MOD_VALUE[8]&quot; == 'true') &amp;&amp; !strstr(&quot;,MOD_VALUE[24],&quot;,&quot;,$b,&quot;)) {
				if (&quot;MOD_VALUE[21]&quot; != &quot;&quot; &amp;&amp; &quot;MOD_VALUE[21]&quot; != &quot; &quot;){
					$b == $idcatside ? $mod['tpl'] = &quot;MOD_VALUE[22]&quot; : $mod['tpl'] = &quot;MOD_VALUE[21]&quot;;
					$mod['tplis'] = &quot;MOD_VALUE[23]&quot;;
				} else {
					$b == $idcatside ? $mod['tpl'] = &quot;MOD_VALUE[18]&quot; : $mod['tpl'] = &quot;MOD_VALUE[17]&quot;;
					$mod['tplis'] = &quot;MOD_VALUE[19]&quot;;
				}
				if ($mod['firsts'] == 0) {
					echo $mod['tplis'];
				}

				$mod['firsts'] = 0;
				$mod['temp'] = '';
				$mod['temp'] = str_replace('{space}','', $mod['tpl']);
				$mod['temp'] = str_replace('{name}', htmlentities($con_side[$b]['name'], ENT_COMPAT, 'UTF-8'), $mod['temp']);
				$mod['temp'] = str_replace('{link}', $con_side[$b]['link'], $mod['temp']);
				$mod['temp'] = str_replace('{id}', 'lang_'.$lang.'side_'.$b, $mod['temp']);
				$mod['temp'] = str_replace('{font1}', &quot;MOD_VALUE[1]&quot;, $mod['temp']);
				$mod['temp'] = str_replace('{font2}', &quot;MOD_VALUE[2]&quot;, $mod['temp']);
				$mod['temp'] = str_replace('{font3}', &quot;MOD_VALUE[3]&quot;, $mod['temp']);
				$mod['temp'] = cms_stripslashes($mod['temp']);
				$mod['temp'] = str_replace('{s_name}', htmlentities(cms_addslashes($con_tree[$b]['name']), ENT_COMPAT, 'UTF-8'), $mod['temp']);
				echo $mod['temp'];
			}
	   }
   }
}
// VARIABLEN LEEREN
echo $cms_mod['value']['20'];

sf_reset($catlist);
unset ($mod, $a, $b);
&lt;/CMSPHP&gt;
