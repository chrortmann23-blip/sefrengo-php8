   <output>&lt;script language=&quot;JavaScript&quot;&gt;
&lt;!--
var &lt;?PHP echo $cms_mod['key']; ?&gt;menu = new TMainMenu('&lt;?PHP echo $cms_mod['key']; ?&gt;menu','MOD_VALUE[2]');
&lt;CMSPHP&gt;
// Navigationsbaum erstellen
if(&quot;MOD_VALUE[0]&quot; == 'root') $mod['start'] = '0';
elseif(&quot;MOD_VALUE[0]&quot; == 'this') $mod['start'] = $idcat;
else $mod['start'] = MOD_VALUE[0];
tree_level_order($mod['start'], 'mod_tree');
$mod['startlevel'] = ($mod['start'] != 0) ? $catlist_level[$mod['start']]+1 : '0';

// Seitenliste vorbereiten
if (!isset($con_side['list'])) {
	foreach (sf_array_keys($con_side) as $mod['idcatside']) {
		if (isset($cms_side['view']) || ($con_side[$mod['idcatside']]['online'] &amp;&amp; $con_side[$mod['idcatside']]['online'] != '0')) {
			if(!is_array($con_side['list'][$con_side[$mod['idcatside']]['idcat']])) $con_side['list'][$con_side[$mod['idcatside']]['idcat']] = array();
			sf_array_push($con_side['list'][$con_side[$mod['idcatside']]['idcat']], $mod['idcatside']);
			if ($con_side[$mod['idcatside']]['is_start'] == '1') $con_side['list'][$con_side[$mod['idcatside']]['idcat']]['is_start'] = true;
		}
	}
}

// gibt es Navigation?
if (is_array($mod_tree)) {
	$mod['offline_idcat'] = explode (',', &quot;MOD_VALUE[4]&quot;);
	foreach($mod_tree as $mod['idcat']) {
		if (!sf_in_array($mod['idcat'], $mod['offline_idcat'])) {
			$mod['max_deep'] = $catlist_level[$mod['idcat']]+1 - $mod['startlevel'];
			for($mod['deep']=$mod['max_deep'];$mod['deep'] &gt; 0;$mod['deep']--) {
				$mod['parent'] = $mod['idcat'];
				for($mod['i']=1;$mod['i'] &lt;= $mod['deep'];$mod['i']++) {
					if ($mod['i'] == $mod['deep']) {
                                         	$mod['menu'] = ($mod['deep'] == 1) ? $mod['menu'].'_'.round($mod['counter']['menu'.$mod['menu']]+1) : $mod['menu'].'_'.$mod['counter']['menu'.$mod['menu']];
					}
					$mod['parent'] = $con_tree[$mod['parent']]['parent'];
				}
			}

			$mod['menuparent'] = substr($mod['menu'], 0, strrpos($mod['menu'], '_'));

			// Ordner einfügen
			if (((&quot;MOD_VALUE[3]&quot; == 'all' || $mod['max_deep'] &lt;= &quot;MOD_VALUE[3]&quot;) &amp;&amp; (isset($cms_side['view']) || ($con_tree[$mod['idcat']]['visible'] == 1))) &amp;&amp; ($mod['menuparent'] == $mod['lastentry'] || isset($mod['counter']['menu'.$mod['menuparent']]))){
				// Ordner anklickbar?
				if (is_array($con_side['list'][$mod['idcat']]) &amp;&amp; isset($con_side['list'][$mod['idcat']]['is_start'])) {
					echo 'var '.$cms_mod['key'].'menu'.$mod['menu'].' = new TPopMenu(\''.cms_addslashes($con_tree[$mod['idcat']]['name']).'\',\'5\',\'a\',\''.$con_tree[$mod['idcat']]['link'].'\',\''.cms_addslashes($con_tree[$mod['idcat']]['name']).'\'); ';
				} else {
					echo 'var '.$cms_mod['key'].'menu'.$mod['menu'].' = new TPopMenu(\''.cms_addslashes($con_tree[$mod['idcat']]['name']).'\',\'5\',\'\',\'\',\''.cms_addslashes($con_tree[$mod['idcat']]['name']).'\'); ';
                                 }
				$mod['lastentry'] = $mod['menu'];
				echo $cms_mod['key'].'menu'.$mod['menuparent'].'.Add('.$cms_mod['key'].'menu'.$mod['menu'].');'.&quot;\n&quot;;
				$mod['counter']['menu'.$mod['menuparent']] = $mod['counter']['menu'.$mod['menuparent']]+1;
			}
			unset($mod['menu']);
		}
         }
}
unset($mod, $mod_tree);
&lt;/CMSPHP&gt;
