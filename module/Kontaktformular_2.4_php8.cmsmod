            /*
            * -----------------------------------------------------------
            * PRIVATE HELPER METHODS
            * -----------------------------------------------------------
            */
            function _strip_slashes($in)
            {
                if (false != 0) {
                    return stripslashes($in);
                }

                return $in;
            }

            function _snippetReplace($content)
            {
                //no snippet replacement found
                if ($this-&gt;snippet_replacement_found === false) {
                    return $content;
                } //figure out if snippet replacement exist
                else {
                    if ($this-&gt;snippet_replacement_found == 'unknown') {
                        if (file_exists($GLOBALS['cfg_cms']['cms_path'] . 'plugins/snippet_replacement/inc/class.SnippetReplacement.php')) {
                            include_once $GLOBALS['cfg_cms']['cms_path'] . 'plugins/snippet_replacement/inc/class.SnippetReplacement.php';
                            $this-&gt;snippet_object = new snippetReplacement();
                            $this-&gt;snippet_replacement_found = true;
                        } else {
                            $this-&gt;snippet_replacement_found = false;
                        }
                    }
                }

                //replace
                if ($this-&gt;snippet_replacement_found == true) {
                    $content = $this-&gt;snippet_object-&gt;replace($content, 'sr_lang', $GLOBALS['client'],
                        $GLOBALS['lang']);
                }

                return $content;
            }

            function _htmlentities($in)
            {
                if ($this-&gt;charset == 'utf-8') {
                    return htmlentities($in, ENT_COMPAT, 'UTF-8');
                } else {
                    return htmlentities($in);
                }
            }

            function _format_styleclass($style)
            {
                return ($style != '') ? ' class=&quot;' . $style . '&quot; ' : null;

            }

            function _get_styled_message($message, $style)
            {
                if ($c = $this-&gt;_format_styleclass($style)) {
                    return '&lt;span ' . $c . '&gt;' . $message . '&lt;/span&gt;';
                }

                return $message;
            }

            function _log($message)
            {
                if (!$this-&gt;logging_active) {
                    return false;
                }

                $fp = @fopen($this-&gt;logging_file, 'a+');
                @fputs($fp, $message);
                @fclose($fp);
            }

        }
    }

