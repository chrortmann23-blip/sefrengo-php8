            /**
             * Set all used stylesheets for the form
             *
             * @args array style_array - possible values are
             * submit_error, submit (Styles for textmessages),
             * label, label_error, text, textarea, option, checkbox, submitbutton,
             *
             * new:  password, select_mutiple, radio, label_as_formfield, placeholder
             */
            function set_styles($style_array)
            {
                if (!is_array($style_array)) {
                    return;
                }

                foreach ($style_array AS $k =&gt; $v) {
                    $this-&gt;field_styles[$k] = $v;
                }
            }

            //mainmethod to add form elements
            function set_formelement(
                $element_name,
                $element_type,
                $element_default,
                $element_validate,
                $element_label,
                $attributes_formelement,
                $attributes_label,
                $element_errormessage,
                $element_tplindex,
                $element_default_selected_val,
                $elementnumber
            ) {
                $i = sf_count($this-&gt;stack);
                $this-&gt;stack[$i]['name'] = $element_name;
                $this-&gt;stack[$i]['type'] = $element_type;
                $this-&gt;stack[$i]['default_value'] = $element_default;
                $this-&gt;stack[$i]['validate_rule'] = $element_validate;
                $this-&gt;stack[$i]['label'] = $this-&gt;_strip_slashes($element_label);
                $this-&gt;stack[$i]['value'] = $this-&gt;get_value($element_type, $element_name, $element_default,
                    $element_default_selected_val,
                    (sf_in_array($element_type, array('checkbox', 'checkboxSelected', 'optionMutiple'))));
                $this-&gt;stack[$i]['opt_attributes_label'] = $this-&gt;_strip_slashes($attributes_label);
                $this-&gt;stack[$i]['opt_attributes_formelement'] = $this-&gt;_strip_slashes($attributes_formelement);
                $this-&gt;stack[$i]['errormessage'] = $this-&gt;_strip_slashes($element_errormessage);
                $this-&gt;stack[$i]['tpl_index'] = $element_tplindex;
                $this-&gt;stack[$i]['elementnumber'] = $elementnumber;
                //$this-&gt;stack[$i]['selected_value'] = $element_default_selected_val;
                //some fields have advanced informations, like the upload
                $this-&gt;stack[$i]['advanced'] = false;
            }

