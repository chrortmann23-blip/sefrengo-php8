            var $mutiple_value_separator = ',';

            //key/ value separator
            var $key_value_separator = '@@';

            //all hidden values
            var $hiddenvalues;

            //email template
            var $tpl_email = '{automessage}';

            //send confirmmail
            var $confirm_mail_active = false;
            //
            var $confirm_mail_subject = 'Kontaktformular Confirm';
            //
            var $confirm_mail_tpl = '{automessage}';

            //addon object
            var $addon;


            //2d array with all informations about uploaded files in it
            //['element_name']['file'] - filepath
            //['element_name']['error'] - contains errormessage for user if occurs
            //['element_name']['int_error'] - contains internal errormessage
            var $uploads = array();

            var $upload_errors = array(
                'deb_filesize_php_ini' =&gt; 'Die hochgeladene Datei ueberschreitet die in der Anweisung upload_max_filesize in php.ini festgelegte Groesse.',
                'deb_filesize_browser' =&gt; 'Die hochgeladene Datei ueberschreitet die in dem HTML Formular mittels der Anweisung MAX_FILE_SIZE angegebene maximale Dateigroesse.',
                'deb_filesize_incremental' =&gt; 'Die Datei wurde nur teilweise hochgeladen.',
                'deb_no_file' =&gt; 'Es wurde keine Datei hochgeladen.',
                'deb_filecopy_fails' =&gt; 'upload fails - check writepremissons for backend/upload/in/',
                'usr_allowed_ext' =&gt; 'Dieser Dateityp darf nicht hochgeladen werden',
                'usr_allowed_size' =&gt; 'Die maximal zulaessige Dateigroesse wurde ueberschritten',
                'usr_internal_error' =&gt; 'Beim Upload ist ein interner Fehler aufgetreten'
            );

            //allowed fileextensions for uploadfiles - comma separated
            var $upload_allowed_extensions;

            //allowed filesize for uploadfiles in kb
            var $upload_allowed_filesize;

            //temp upload dir for files
            var $upload_dir;

            //snippet replacement stuff. Possible values are str unknown, true false
            var $snippet_replacement_found = 'unknown';
            var $snippet_object = false;

            function __construct()
            {
                $this-&gt;addon = new gooseberry_form_addon;
            }


            /*
            * -----------------------------------------------------------
            * FORM PARSER METHODS
            * -----------------------------------------------------------
            */
            function parse_elements()
            {
                $this-&gt;parsed_plain = '';
                $this-&gt;parsed = '';
                $p = '';
                $pp = '';
                //print_r($this-&gt;stack);
                foreach ($this-&gt;stack AS $k =&gt; $v) {

                    //addon preParse
                    $this-&gt;addon-&gt;onPreParse($v, $this-&gt;stack);

                    //collect all hidden values separatly
                    if ($v['type'] == 'hidden') {
                        $this-&gt;hiddenvalues .= $this-&gt;get_formelement($v['name'], $v['type'], $v['value'],
                            $v['default_value'], $v['opt_attributes_formelement']);
                        continue;
                    }

                    //special handling for checkboxes in plainform / unchecked checkboxes have no value
                    $def_v_for_plain = ($v['type'] == 'checkbox' &amp;&amp; $this-&gt;is_submitted()) ? $v['default_value'] : $v['default_value'];

                    //get formelement
                    $element = $this-&gt;get_formelement($v['name'], $v['type'], $v['value'], $v['default_value'],
                        $v['opt_attributes_formelement'], false);

                    //get plain HTML formelement
                    if ($v['type'] != 'captchaimage') {
                        $element_plain = $this-&gt;get_formelement($v['name'], $v['type'], $def_v_for_plain,
                            $v['default_value'], $v['opt_attributes_formelement'], true);
                    } //no need to generate a second captcha for plainform
                    else {
                        $element_plain = $element;
                    }

                    //find out if element must validate
                    $mv = (($v['validate_rule'] != 'false' &amp;&amp; $v['validate_rule'] != 'emailOrEmpty')) ? true : false;

                    //special validation for ceckboxes and radios
                    if ($v['type'] == 'checkbox' || $v['type'] == 'radio') {
                        $vr = $this-&gt;validate($v['validate_rule'], $_REQUEST[$v['name']]);
                    } //special validation for uploads
                    else {
                        if ($v['type'] == 'upload') {
                            $vr = $this-&gt;validate_upload($v['name'], $v['label'], $v['validate_rule'], $k);

                            // upload fails
                            if (!$vr) {
                                if ($this-&gt;uploads[$v['name']]['error'] != '') {
                                    $v['errormessage'] = $this-&gt;uploads[$v['name']]['error'];
                                }
                            }
                            //validate captcha
                        } else {
                            if ($v['type'] == 'captchaimage' &amp;&amp; $this-&gt;is_submitted()) {
                                $this-&gt;init_captcha_object();
                                $vr = $this-&gt;captcha_object-&gt;validateByCharseqAndRequestFieldname($v['value'],
                                    $v['name']);
                                if (!$vr) {
                                    $this-&gt;is_rule_violation = true;
                                }
                            } //validate other elements
                            else {
                                $vr = $this-&gt;validate($v['validate_rule'], $v['value']);
                            }
                        }
                    }

                    //validation fail - set error
                    if (!$vr) {
                        sf_array_push($this-&gt;invalid_fields, $v['label']);
                    }

                    //addon validate
                    $this-&gt;addon-&gt;onValidate($v, $vr, $this-&gt;stack);

                    //get label
                    $label = $this-&gt;get_label($v['name'], $v['label'], $v['opt_attributes_label'], $mv, $vr);

                    //addon parse row
                    $this-&gt;addon-&gt;onParseRow($v, $label, $element, $element_plain, $this-&gt;stack);

                    //add to forms
                    $p .= $this-&gt;parse_form_row($v['tpl_index'], $label, $element, $vr, $v['errormessage'], $mv);
                    $pp .= $this-&gt;parse_form_row($v['tpl_index'], $label, $element_plain, false, false, $mv);
                }

                $this-&gt;parsed = $p;
                $this-&gt;parsed_plain = $pp;

                //log errors
                if (sf_count($this-&gt;invalid_fields) &gt; 0 &amp;&amp; $this-&gt;logging_active) {
                    $logmessage = sprintf(&quot;%s: Mail Rule Violation: %s%s\n\n&quot;, date('Y-m-d (D) H:i:s'),
                        &quot;IP: &quot; . $_SERVER['REMOTE_ADDR'] . &quot;\n-------------------------------\n&quot;,
                        &quot;Invalied Fields: &quot; . sf_implode(', ',
                            $this-&gt;invalid_fields) . &quot;\n&quot; . &quot;Values:$log \n-------------------------------\n&quot;);
                    $this-&gt;_log($logmessage);
                }

                //set controlvalue formwassubmitted as hiddenvalue
                $this-&gt;hiddenvalues .= $this-&gt;get_formelement('formSubmitted', 'hidden', 'true', 'true');

                //if email receiver mode ='get', add some more hiddenvalues
                if ($this-&gt;email_receiptor_mode == 'get') {
                    $this-&gt;hiddenvalues .= $this-&gt;get_formelement('contactidcs', 'hidden',
                        $this-&gt;email_receiptor_get_mode_idcatside, '');
                    $this-&gt;hiddenvalues .= $this-&gt;get_formelement('contactcontainer', 'hidden',
                        $this-&gt;email_receiptor_get_mode_idcontainer, '');
                }

                if ($this-&gt;is_submitted() &amp;&amp; !$this-&gt;is_validated()) {
                    $this-&gt;addon-&gt;onFailure($this-&gt;stack);
                }
            }

            function get_label($element_name, $element_label, $element_attributes, $must_validated, $is_validated)
            {

                $rn = ($must_validated) ? $this-&gt;tpl_label_required_notice : '';
                //{labelcontent}{requirenotice}
                $element_label = str_replace(array('{labelcontent}', '{requirenotice}'), array($element_label, $rn),
                    $this-&gt;tpl_labeltext);
                $style = (!$is_validated) ? $this-&gt;field_styles['label_error'] : $this-&gt;field_styles['label'];
                $label = ($style != '') ? '&lt;span class=&quot;' . $style . '&quot;&gt;' . $element_label . '&lt;/span&gt;' : $element_label;

                return '&lt;label for=&quot;' . $element_name . '&quot; ' . $element_attributes . ' &gt;' . $label . '&lt;/label&gt;';
            }

            function parse_form_row($tplindex, $label, $element, $is_valid, $errormessage, $must_validated)
            {
                $errormessage = ($is_valid) ? '' : $errormessage;
                $rn = ($must_validated) ? $this-&gt;tpl_label_required_notice : '';

                if ($errormessage != '') {
                    $errormessage = str_replace('{elementerrormessage}', $errormessage, $this-&gt;tpl_elementerror);
                    $errormessage = $this-&gt;_get_styled_message($errormessage, $this-&gt;field_styles['element_error']);
                }

                return str_replace(array('{label}', '{element}', '{errormessage}', '{requirenotice}'),
                    array($label, $element, $errormessage, ''), $this-&gt;row_tpl[$tplindex]);
            }

            function get_formelement(
                $element_name,
                $element_type,
                $element_value,
                $element_default_value,
                $element_attributes = '',
                $get_plain = false
            ) {

                switch ($element_type) {
                    case 'hidden':
                        $e = '&lt;input type=&quot;hidden&quot; name=&quot;' . $element_name . '&quot; id=&quot;' . $element_name . '&quot; ';
                        $e .= ' value=&quot;' . $this-&gt;_htmlentities($element_value) . '&quot; ' . $element_attributes . ' /&gt;';
                        break;
                    case 'text':
                    case 'password':
                        $e = '&lt;input type=&quot;' . $element_type . '&quot; name=&quot;' . $element_name . '&quot; id=&quot;' . $element_name . '&quot; ' . $this-&gt;_format_styleclass($this-&gt;field_styles[$element_type]) . $element_attributes . ' ';
                        $e .= ' value=&quot;' . $this-&gt;_htmlentities($element_value) . '&quot; /&gt;';
                        break;
                    case 'textarea':
                        $e = '&lt;textarea name=&quot;' . $element_name . '&quot;  id=&quot;' . $element_name . '&quot; ' . $element_attributes . ' ' . $this-&gt;_format_styleclass($this-&gt;field_styles[$element_type]) . '&gt;' . $this-&gt;_htmlentities($element_value) . '&lt;/textarea&gt;';
                        break;
                    case 'option':
                        $e = '&lt;select name=&quot;' . $element_name . '&quot;  id=&quot;' . $element_name . '&quot;  ' . $element_attributes . ' ' . $this-&gt;_format_styleclass($this-&gt;field_styles[$element_type]) . '&gt;' . &quot;\n&quot;;
                        $p = explode($this-&gt;mutiple_value_separator, $element_default_value);
                        foreach ($p AS $k =&gt; $v) {
                            $v_key = $v;
                            if (strstr($v, $this-&gt;key_value_separator) !== false) {
                                $v_pairs = explode($this-&gt;key_value_separator, $v);
                                $v_key = $v_pairs['0'];
                                $v = $v_pairs['1'];
                            }
                            $s = ($element_value == $v_key &amp;&amp; !$get_plain) ? 'selected=&quot;selected&quot;' : '';
                            $e .= '&lt;option value=&quot;' . $this-&gt;_htmlentities($v_key) . '&quot; ' . $s . ' &gt;' . $this-&gt;_htmlentities($v) . '&lt;/option&gt;' . &quot;\n&quot;;
                        }
                        $e .= '&lt;/select&gt;' . &quot;\n&quot;;
                        break;
                    case 'optionMutiple':
                        $e = '&lt;select name=&quot;' . $element_name . '[]&quot;  id=&quot;' . $element_name . '&quot;  ' . $this-&gt;field_styles[$element_type] . ' multiple&gt;' . &quot;\n&quot;;
                        $p = explode($this-&gt;mutiple_value_separator, $element_default_value);
                        //$selected_options = (is_array($_REQUEST[$element_name])) ? $_REQUEST[$element_name] : array();
                        $selected_options = explode($this-&gt;mutiple_value_separator, $element_value);
                        //print_r($selected_options);
                        foreach ($p AS $k =&gt; $v) {
                            $s = '';
                            $v_key = $v;
                            if (strstr($v, $this-&gt;key_value_separator) !== false) {
                                $v_pairs = explode($this-&gt;key_value_separator, $v);
                                $v_key = $v_pairs['0'];
                                $v = $v_pairs['1'];
                            }

                            if (sf_count($selected_options) &gt; 0) {
                                $s = (sf_in_array($v_key,
                                        $selected_options) &amp;&amp; !$get_plain) ? ' selected=&quot;selected&quot; ' : '';
                            }
                            $e .= '&lt;option value=&quot;' . $this-&gt;_htmlentities($v_key) . '&quot; ' . $s . '&gt;' . $this-&gt;_htmlentities($v) . '&lt;/option&gt;' . &quot;\n&quot;;
                        }
                        $e .= '&lt;/select&gt;' . &quot;\n&quot;;
                        break;
                    case 'radio':
                        $p = explode($this-&gt;mutiple_value_separator, $element_default_value);
                        foreach ($p AS $k =&gt; $v) {
                            $v_key = $v;
                            if (strstr($v, $this-&gt;key_value_separator) !== false) {
                                $v_pairs = explode($this-&gt;key_value_separator, $v);
                                $v_key = $v_pairs['0'];
                                $v = $v_pairs['1'];
                            }
                            $c = ($element_value == $v_key &amp;&amp; !$get_plain) ? 'checked=&quot;checked&quot;' : '';
                            $e .= '&lt;input type=&quot;radio&quot; name=&quot;' . $element_name . '&quot; id=&quot;' . $element_name . '&quot; value=&quot;' . $this-&gt;_htmlentities($v_key) . '&quot; ' . $c . ' /&gt;' . '&amp;nbsp;' . $this-&gt;_htmlentities($v);
                        }
                        break;
                    case 'checkbox':
                    case 'checkboxSelected':
                        $element_default_value_key = $element_default_value;
                        if (strstr($element_default_value, $this-&gt;key_value_separator) !== false) {
                            $v_pairs = explode($this-&gt;key_value_separator, $element_default_value);
                            $element_default_value_key = $v_pairs['0'];
                            $element_default_value = $v_pairs['1'];
                        }

                        $c = (($element_default_value_key == $element_value &amp;&amp; !$get_plain) || (!$this-&gt;is_submitted() &amp;&amp; $element_type == 'checkboxSelected')) ? 'checked=&quot;checked&quot;' : '';
                        $e = '&lt;input type=&quot;checkbox&quot; name=&quot;' . $element_name . '&quot;  id=&quot;' . $element_name . '&quot; ' . $this-&gt;_format_styleclass($this-&gt;field_styles['checkbox']) . ' ';
                        $e .= 'value=&quot;' . $this-&gt;_htmlentities($element_default_value_key) . '&quot;  ' . $c . '  ' . $element_attributes . ' /&gt;' . '&lt;label for=&quot;' . $element_name . '&quot; ' . $this-&gt;_format_styleclass($this-&gt;field_styles['label']) . '&gt;' . $this-&gt;_htmlentities($element_default_value) . '&lt;/label&gt;';
                        break;
                    case 'upload':
                        $e = '&lt;input type=&quot;file&quot; name=&quot;' . $element_name . '&quot; id=&quot;' . $element_name . '&quot; ' . $this-&gt;_format_styleclass($this-&gt;field_styles[$element_type]) . $element_attributes . ' ';
                        $e .= ' /&gt;';
                        break;
                    case 'captchaimage':
                        $this-&gt;init_captcha_object();
                        $e = $this-&gt;captcha_object-&gt;getCaptchaHtml($element_name, $this-&gt;captchavals['length'],
                            $this-&gt;_format_styleclass($this-&gt;field_styles[$element_type]) . $element_attributes,
                            $this-&gt;captchavals['attributes'], $this-&gt;captchavals['styleset'],
                            $this-&gt;captchavals['width'], $this-&gt;captchavals['height']);
                        break;
                    case 'label'://label_as_formfield, placeholder
                        $e = '&lt;span ' . $this-&gt;_format_styleclass($this-&gt;field_styles['label_as_formfield']) . ' &gt;' . $element_value . '&lt;/span&gt;';
                        break;
                    case 'locumtenency':
                        $e = '&lt;span ' . $this-&gt;_format_styleclass($this-&gt;field_styles['placeholder']) . ' &gt;' . $this-&gt;separator_tpl . '&lt;/span&gt;';
                        break;
                }

                return $e;
            }

            function init_captcha_object()
            {
                global $cfg_client;

                if (is_object($this-&gt;captcha_object)) {
                    return true;
                } else {
                    $this-&gt;captcha_object =&amp; sf_factoryGetObject('GUI', 'CaptchaImage');
                    $this-&gt;captcha_object-&gt;setCaptchaTemplate($this-&gt;captchavals['template']);

                    return true;
                }
            }

            function get_value($element_type, $element_name, $element_default, $element_selected, $skip_default = false)
            {
                //echo &quot;$element_type, $element_name, $element_default, $element_selected, $skip_default &lt;br&gt;&quot;;
                if (isset($_REQUEST[$element_name])) {
                    $v = is_array($_REQUEST[$element_name]) ? sf_implode($this-&gt;mutiple_value_separator,
                        $_REQUEST[$element_name]) : $_REQUEST[$element_name];

                    return $this-&gt;_strip_slashes($v);
                } else {
                    if (($element_type == 'checkbox' || $element_type == 'checkboxSelected' || $element_type == 'radio') &amp;&amp; !$_REQUEST[$element_name] &amp;&amp; $this-&gt;is_submitted()) {
                        return false;
                    } else {
                        if ($element_selected != '') {
                            return $element_selected;
                        } else {
                            if ($skip_default) {
                                return false;
                            }
                        }
                    }
                }

                return $element_default;
            }


            function validate($element_validate, $element_value)
            {
                if (!$this-&gt;is_submitted()) {
                    return true;
                }

                //validate captcha
                if ($element_validate == 'imagecaptcha') {
                    //do nothing
                } //validate regex
                else {
                    if (sf_array_key_exists($element_validate, $this-&gt;rules)) {
                        if (!preg_match($this-&gt;rules[$element_validate], $element_value)) {
                            $this-&gt;is_rule_violation = true;

                            return false;
                        }
                    }
                }

                return true;
            }

            function validate_upload($element_name, $element_label, $validate_rule, $stack_key)
            {
                $upload_dir = $this-&gt;upload_dir;
                $upload_allowed_extension = $this-&gt;upload_allowed_extensions;
                $upload_allowed_filesize = $this-&gt;upload_allowed_filesize;

                $size = $_FILES[$element_name]['size'];
                $name = $_FILES[$element_name]['name'];
                $type = $_FILES[$element_name]['type'];
                $tmp_name = $_FILES[$element_name]['tmp_name'];
                $err = $_FILES[$element_name]['error'];
                $parts = pathinfo('sicheristsicher/' . $name);
                $ext = strtolower($parts['extension']);
                $allowed_ext = strtolower(str_replace(' ', '', $upload_allowed_extension));

                $this-&gt;uploads[$element_name]['label'] = $element_label;
                $this-&gt;uploads[$element_name]['file'] = '';
                $this-&gt;uploads[$element_name]['error'] = '';
                $this-&gt;uploads[$element_name]['int_error'] = '';


                //no file found/ uploaded
                if ($tmp_name == '') {
                    //check if upload is required
                    if ($validate_rule == 'required') {
                        $this-&gt;is_rule_violation = true;

                        return false;
                    } else {
                        return true;
                    }
                }

                $upload_error = '';
                //check php errors
                switch ($err) {
                    case 1:
                        $upload_error = $this-&gt;upload_errors['deb_filesize_php_ini'];
                        break;
                    case 2:
                        $upload_error = $this-&gt;upload_errors['deb_filesize_browser'];
                        break;
                    case 3:
                        $upload_error = $this-&gt;upload_errors['deb_filesize_incremental'];
                        break;
                    case 4:
                        $upload_error = $this-&gt;upload_errors['deb_no_file'];
                        break;
                }

                if ($err &gt; 0) {
                    $this-&gt;uploads[$element_name]['error'] = $this-&gt;upload_errors['usr_internal_error'];
                    $this-&gt;uploads[$element_name]['int_error'] = $upload_error;
                    $this-&gt;is_rule_violation = true;

                    return false;
                }

                //check extensions
                if (strlen($allowed_ext) &gt; 0) {
                    $ax = explode(',', $allowed_ext);
                    if (!sf_in_array($ext, $ax)) {
                        $this-&gt;uploads[$element_name]['error'] = $this-&gt;upload_errors['usr_allowed_ext'];
                        $this-&gt;is_rule_violation = true;

                        return false;
                    }
                }

                //checkfilesize
                if ($upload_allowed_filesize &gt; 0) {
                    $upload_allowed_filesize *= 1024;
                    if ($size &gt; $upload_allowed_filesize) {
                        $this-&gt;uploads[$element_name]['error'] = $this-&gt;upload_errors['usr_allowed_size'];
                        $this-&gt;is_rule_violation = true;

                        return false;
                    }
                }

                //move file
                if (!move_uploaded_file($_FILES[$element_name]['tmp_name'], $upload_dir . $name)) {

                    $this-&gt;uploads[$element_name]['error'] = $this-&gt;upload_errors['usr_internal_error'];
                    $this-&gt;uploads[$element_name]['int_error'] = $this-&gt;upload_errors['deb_filecopy_fails'];
                    $this-&gt;is_rule_violation = true;

                    return false;
                }

                $this-&gt;uploads[$element_name]['file'] = $upload_dir . $name;
                $this-&gt;uploads[$element_name]['name'] = $name;
                $this-&gt;uploads[$element_name]['type'] = $type;
                $this-&gt;uploads[$element_name]['size'] = $size;
                $this-&gt;uploads[$element_name]['ext'] = $ext;
                $this-&gt;stack[$stack_key]['advanced'] = $this-&gt;uploads[$element_name];

                return true;
            }


            /*
            * -----------------------------------------------------------
            * &quot;FORM TO FINAL HTML&quot; AND SOME MISC METHODS
            * -----------------------------------------------------------
            */
            function get_form()
            {
                return $this-&gt;_get_form();
            }

            function get_form_plain()
            {
                return $this-&gt;_get_form(true);
            }

            function _get_form($is_plain = false)
            {
                global $con_side, $con_tree, $cfg_client, $idcatside;

                $frm_vals['formstart'] = $this-&gt;get_form_head() . &quot;\n&quot;;
                $frm_vals['formend'] = $this-&gt;get_form_footer() . &quot;\n&quot;;
                $frm_vals['submit'] = $this-&gt;get_submitbutton();

                $arr['email'] = '';
                if ($this-&gt;email_receiptor_mode == 'get' &amp;&amp; $this-&gt;email_receiptor_get_mode_idcatside &gt; 0) {
                    $arr = $this-&gt;get_receiptor_data_from_content_as_array();
                    $frm_vals['textareafromdynamic'] = nl2br($arr['textareafromdynamic']);
                    $frm_vals['textfromdynamic'] = $arr['textfromdynamic'];

                    $idcatside_from = $this-&gt;email_receiptor_get_mode_idcatside;
                    $frm_vals['page_name'] = $con_side[$idcatside_from]['name'];
                    $frm_vals['page_url'] = $cfg_client['htmlpath'] . str_replace('&amp;amp;', '&amp;',
                            $con_side[$idcatside_from]['link']);
                    $frm_vals['cat_name'] = $con_tree[$con_side[$idcatside_from]['idcat']]['name'];
                    $frm_vals['cat_url'] = $cfg_client['htmlpath'] . str_replace('&amp;amp;', '&amp;',
                            $con_tree[$con_side[$idcatside_from]['idcat']]['link']);
                } else {
                    $frm_vals['textareafromdynamic'] = nl2br($this-&gt;fallback_textareafromdynamic);
                    $frm_vals['textfromdynamic'] = $this-&gt;fallback_textfromdynamic;
                    $frm_vals['page_name'] = $con_side[$idcatside]['name'];
                    $frm_vals['page_url'] = $cfg_client['htmlpath'] . str_replace('&amp;amp;', '&amp;',
                            $con_side[$idcatside]['link']);
                    $frm_vals['cat_name'] = $con_tree[$con_side[$idcatside]['idcat']]['name'];
                    $frm_vals['cat_url'] = $cfg_client['htmlpath'] . str_replace('&amp;amp;', '&amp;',
                            $con_tree[$con_side[$idcatside]['idcat']]['link']);
                }

                if ($is_plain) {
                    $frm_vals['formelementblock'] = $this-&gt;parsed_plain;
                } else {
                    $frm_vals['formelementblock'] = $this-&gt;parsed;
                }
                $frm_vals['usermessage'] = $this-&gt;get_usermessage();
                if ($frm_vals['usermessage'] != '') {
                    $frm_vals['messageblock'] = str_replace('{usermessage}', $this-&gt;get_usermessage(),
                        $this-&gt;message_block_tpl);
                } else {
                    $frm_vals['messageblock'] = '';
                }

                $tpl = $this-&gt;combination_tpl;
                foreach ($frm_vals AS $k =&gt; $v) {
                    $tpl = str_replace('{' . $k . '}', $v, $tpl);
                }

                $deb = ($this-&gt;debug) ? $this-&gt;debugmessage : '';
                $tpl = str_replace('{debugmessages}', $deb, $tpl);

                return $tpl;
            }

            function get_form_head()
            {
                $a = str_replace('{url}', $this-&gt;form_target_url, $this-&gt;tpl_formstarttag);
                if ($_REQUEST['formSubmitted'] == 'true' AND $this-&gt;is_validated()) {
                    $a = str_replace('{transmitted}', &quot;transmitted&quot;, $a);
                }

                return $a;
            }

            function get_form_footer()
            {
                return $this-&gt;hiddenvalues . $this-&gt;tpl_formendtag;
            }

            function get_submitbutton()
            {
                return '&lt;input type=&quot;submit&quot; name=&quot;fmsubmit&quot; ' . $this-&gt;_format_styleclass($this-&gt;field_styles['submitbutton']) . ' value=&quot;' . $this-&gt;submitbutton_text . '&quot; /&gt;';
            }

            function get_usermessage()
            {

                $m = '';
                if ($this-&gt;is_submitted()) {
                    if ($this-&gt;is_validated()) {
                        $m = $this-&gt;_get_styled_message($this-&gt;message_success, $this-&gt;field_styles['submit']);
                    } else {
                        $m = $this-&gt;_get_styled_message($this-&gt;message_error . ' ' . $this-&gt;get_invalid_fields(),
                            $this-&gt;field_styles['submit_error']);
                    }
                }

                return $m;
            }


            function get_invalid_fields()
            {
                return sf_implode(', ', $this-&gt;invalid_fields);
            }

            function get_stack()
            {
                return $this-&gt;stack;
            }

            function is_validated()
            {
                return (!$this-&gt;is_rule_violation);
            }

            function is_submitted()
            {
                return ($_REQUEST['formSubmitted'] == 'true');
            }


            /*
            * -----------------------------------------------------------
            * MAIL METHODS
            * -----------------------------------------------------------
            */
            function send_mail()
            {
                global $con_side, $con_tree, $cfg_client, $idcatside;

                $tpl_email = $this-&gt;tpl_email;

                $to = '';
                if ($this-&gt;email_receiptor_mode == 'get') {
                    $arr = $this-&gt;get_receiptor_data_from_content_as_array();
                    $to = trim($arr['email']);

                    $idcatside_from = $this-&gt;email_receiptor_get_mode_idcatside;
                    $page_name = $con_side[$idcatside_from]['name'];
                    $page_url = $cfg_client['htmlpath'] . str_replace('&amp;amp;', '&amp;', $con_side[$idcatside_from]['link']);
                    $cat_name = $con_tree[$con_side[$idcatside_from]['idcat']]['name'];
                    $cat_url = $cfg_client['htmlpath'] . str_replace('&amp;amp;', '&amp;',
                            $con_tree[$con_side[$idcatside_from]['idcat']]['link']);
                }

                if ($this-&gt;email_receiptor_mode == 'textfield' || $to == '') {
                    $to = $this-&gt;email_receiptor_textfield_mode_mailadress;

                    if ($this-&gt;email_receiptor_mode == 'textfield') {
                        $page_name = $con_side[$idcatside]['name'];
                        $page_url = $cfg_client['htmlpath'] . str_replace('&amp;amp;', '&amp;', $con_side[$idcatside]['link']);
                        $cat_name = $con_tree[$con_side[$idcatside]['idcat']]['name'];
                        $cat_url = $cfg_client['htmlpath'] . str_replace('&amp;amp;', '&amp;',
                                $con_tree[$con_side[$idcatside]['idcat']]['link']);

                        $arr['textfromdynamic'] = $this-&gt;fallback_textfromdynamic;
                        $arr['textareafromdynamic'] = $this-&gt;fallback_textareafromdynamic;
                    }
                }


                //no emailadress found - break up
                if ($to == '' &amp;&amp; $this-&gt;send_mail) {
                    return;
                }

                $sender = $this-&gt;email_sender;
                $subject = $this-&gt;generate_email_template($this-&gt;email_subject);


                $mail =&amp; $GLOBALS['sf_factory']-&gt;getObject('UTILS', 'Mail');
                $mail-&gt;setCharset($this-&gt;charset);
                $mail-&gt;setFrom($sender);
                $mail-&gt;setSubject($subject);

                $arr['to'] = explode(',', $to);
                $arr['cc'] = explode(',', $this-&gt;email_receiptor_cc);
                $arr['bcc'] = explode(',', $this-&gt;email_receiptor_bcc);
                foreach ($arr AS $k =&gt; $v) {
                    if (is_array($v)) {
                        foreach ($v AS $adr) {
                            $adr = trim($adr);
                            if (substr($adr, 0, 1) == '+') {
                                $mail-&gt;addAdressByUsername(substr($adr, 1), $k);
                            } else {
                                if (substr($adr, 0, 1) == '#') {
                                    $mail-&gt;addAdressByGroupname(substr($adr, 1), $k);
                                } else {
                                    $mail-&gt;addAdress($adr, $k);
                                }
                            }
                        }
                    }
                }

                //add attachements
                if (is_array($this-&gt;uploads)) {
                    foreach ($this-&gt;uploads AS $k =&gt; $v) {
                        if ($v['file'] != '') {
                            $mail-&gt;addAttachment($v['file'], $v['type'], $v['name']);
                        }
                    }
                }

                //give possibility to manipulate the stack
                ////////////////////////////////////////////////////////$this-&gt;addon-&gt;onSuccess($this-&gt;stack);

                //generate email template
                $tpl_email = $this-&gt;generate_email_template($tpl_email, $to, $arr['textfromdynamic'],
                    $arr['textareafromdynamic'], $page_name, $page_url, $cat_name, $cat_url);
                //echo $tpl_email;exit;
                $mail-&gt;setTxtBody($tpl_email);

                if ($this-&gt;debug) {
                    $this-&gt;debugmessage .= &quot;Mail to: $to || Mail from:  $sender || Mail subject: $subject &lt;br&gt;&quot;;
                    echo $this-&gt;debugmessage .= 'Mailtext:&lt;br&gt;-------------&lt;br&gt;' . nl2br($tpl_email) . '&lt;br&gt;-------------&lt;br&gt;';
                }

                if ($this-&gt;send_mail) {
                    $result = $mail-&gt;process();//$mail-&gt;send(array($to), 'mail');
                }

                //send second email
                if ($this-&gt;confirm_mail_active) {
                    $mail-&gt;adresses = array(
                        'to' =&gt; array(),
                        'cc' =&gt; array(),
                        'bcc' =&gt; array()
                    );
                    $tpl_email2 = $this-&gt;generate_email_template($this-&gt;confirm_mail_tpl, $to, $arr['textfromdynamic'],
                        $arr['textareafromdynamic'], $page_name, $page_url, $cat_name, $cat_url);


                    //get sender
                    if (is_numeric(trim($this-&gt;second_email_sender))) {
                        foreach ($this-&gt;stack AS $k =&gt; $v) {
                            if ($v['elementnumber'] == (int)$this-&gt;second_email_sender) {
                                $sender = $v['value'];
                            }
                        }
                    } else {
                        $sender = $this-&gt;second_email_sender;
                    }

                    //get recipient
                    if (is_numeric(trim($this-&gt;second_email_recipient))) {
                        foreach ($this-&gt;stack AS $k =&gt; $v) {
                            if ($v['elementnumber'] == (int)$this-&gt;second_email_recipient) {
                                $recipient = $v['value'];
                            }
                        }
                    } else {
                        $recipient = $this-&gt;second_email_recipient;
                    }


                    $rec_array = explode($this-&gt;mutiple_value_separator, $recipient);


                    $this-&gt;confirm_mail_subject = $this-&gt;generate_email_template($this-&gt;confirm_mail_subject);

                    $mail-&gt;setFrom($sender);
                    $mail-&gt;setSubject($this-&gt;confirm_mail_subject);

                    foreach ($rec_array AS $v) {
                        $v2 = explode($this-&gt;key_value_separator, $v);
                        $mail-&gt;addAdress($v2['0'], 'to');
                    }

                    $mail-&gt;setTxtBody($tpl_email2);
                    $result = $mail-&gt;process();
                }

                if ($this-&gt;logging_active) {
                    $mailstatus = ($result) ? 'OK' : 'Error - Mailfunction does not work';
                    $logmessage = sprintf(&quot;%s: Send Mail: %s%s\n\n&quot;, date('Y-m-d (D) H:i:s'),
                        &quot;IP: &quot; . $_SERVER['REMOTE_ADDR'] . &quot; Mail to: $to || Mail from:  $sender || Mail subject: $subject \nStatus: $mailstatus \n-------------------------------\n&quot;,
                        &quot;Mail Conent1: $tpl_email \n-------------------------------\n&quot; . &quot;Mail Conent2: $tpl_email2 \n-------------------------------\n&quot;);
                    $this-&gt;_log($logmessage);
                }


            }

            function generate_email_template(
                $tpl_email,
                $to = '',
                $textfromdynamic = '',
                $textareafromdynamic = '',
                $page_name = '',
                $page_url = '',
                $cat_name = '',
                $cat_url = ''
            ) {

                // convert all linebreaks to \r\n linebreaks
                $tpl_email = preg_replace(&quot;#(\r\n)|(\r)#m&quot;, &quot;\n&quot;, $tpl_email);
                //$tpl_email = preg_replace(&quot;#(\n)#m&quot;, &quot;\r\n&quot;, $tpl_email);


                // fill emailtemplate
                $tpl_email = str_replace(array(
                    '{email_receiptor}',
                    '{textfromdynamic}',
                    '{textareafromdynamic}',
                    '{page_name}',
                    '{page_url}',
                    '{cat_name}',
                    '{cat_url}'
                ), array(
                        $to,
                        $textfromdynamic,
                        $textareafromdynamic,
                        $page_name,
                        $page_url,
                        $cat_name,
                        $cat_url
                    ), $tpl_email);

                $automessage = '';
                foreach ($this-&gt;stack AS $k =&gt; $v) {
                    //echo $k.&quot;: &quot;;print_r($v);echo &quot;&lt;br&gt;&lt;br&gt;&quot;;
                    switch ($v['type']) {
                        case 'label':
                            $tpl_email = str_replace(array(
                                '{elementlabel:' . $v['elementnumber'] . '}',
                                '{elementvalue:' . $v['elementnumber'] . '}'
                            ), array($v['label'], $v['value']), $tpl_email);
                        case 'locumtenency':
                        case 'upload':
                        case 'captchaimage':
                            break;
                        case 'optionMutiple':
                            //print_r($v);
                            $s = $_REQUEST[$v['name']];
                            if (sf_count($s) &gt; 0) {
                                $m_inner = '';
                                foreach ($s AS $v2) {
                                    $m_inner .= $this-&gt;_strip_slashes($v2) . &quot;\n&quot;;
                                }
                                $automessage .= $v['label'] . &quot;:\n&quot; . $m_inner . &quot;\n\n&quot;;
                                $tpl_email = str_replace(array(
                                    '{elementlabel:' . $v['elementnumber'] . '}',
                                    '{elementvalue:' . $v['elementnumber'] . '}'
                                ), array($v['label'], $m_inner), $tpl_email);
                            }
                            break;
                        default:
                            $automessage .= $v['label'] . &quot;:\n&quot; . $v['value'] . &quot;\n\n&quot;;
                            $tpl_email = str_replace(array(
                                '{elementlabel:' . $v['elementnumber'] . '}',
                                '{elementvalue:' . $v['elementnumber'] . '}'
                            ), array($v['label'], $v['value']), $tpl_email);
                    }
                }

                if (is_array($this-&gt;uploads)) {
                    foreach ($this-&gt;uploads AS $k =&gt; $v) {
                        if ($v['file'] != '') {
                            $automessage .= &quot;ATTACHMENT '&quot; . $v['label'] . &quot;': &quot; . $v['name'] . &quot;\n&quot;;
                        }
                    }
                }

                //generate email template
                $tpl_email = str_replace('{automessage}', $automessage, $tpl_email);

                //replace snippets
                $tpl_email = $this-&gt;_snippetReplace($tpl_email);


                return $tpl_email;
            }

            function get_receiptor_data_from_content_as_array()
            {
                global $db, $cms_db, $lang;

                $arr = array('email' =&gt; '', 'textfromdynamic' =&gt; '', 'textareafromdynamic' =&gt; '',);

                if ($this-&gt;email_receiptor_get_mode_idcatside == '' || $this-&gt;email_receiptor_get_mode_idcontainer == '') {
                    return $arr;
                }

                $grab_conf['idcatside'] = $this-&gt;email_receiptor_get_mode_idcatside;
                $grab_conf['idlang'] = $lang;
                $grab_conf['container'] = $this-&gt;email_receiptor_get_mode_idcontainer;
                $grab_conf['id'] = '1,2'; //id of cmstag
                $grab_conf['type'] = '1,3';//text + textarea

                $sql = &quot;SELECT
    CS.sortindex, CS.idcatside, CS.idcat,
    CONTENT.container, CONTENT.idtype AS type, CONTENT.typenumber AS id,
    CONTENT.number AS repeatid, CONTENT.value
    FROM
    &quot; . $cms_db['content'] . &quot; CONTENT,
    &quot; . $cms_db['side_lang'] . &quot; SL
    LEFT JOIN &quot; . $cms_db['cat_side'] . &quot;  CS USING (idside)
    WHERE
    CONTENT.idsidelang = SL.idsidelang
    AND CS.idcatside = &quot; . $grab_conf['idcatside'] . &quot;
    AND SL.idlang= &quot; . $grab_conf['idlang'] . &quot;
    AND CONTENT.container IN (&quot; . $grab_conf['container'] . &quot;)
    AND CONTENT.typenumber IN (&quot; . $grab_conf['id'] . &quot;)
    AND CONTENT.idtype IN (&quot; . $grab_conf['type'] . &quot;)&quot;;
                $db-&gt;query($sql);

                while ($db-&gt;next_record()) {
                    if ($db-&gt;f('type') == 1 &amp;&amp; $db-&gt;f('id') == 1) {
                        if (preg_match($this-&gt;rules['email'], trim($db-&gt;f('value')))) {
                            $arr['email'] = trim($db-&gt;f('value'));
                        }
                    } else {
                        if ($db-&gt;f('type') == 1 &amp;&amp; $db-&gt;f('id') == 2) {
                            $arr['textfromdynamic'] = $db-&gt;f('value');
                        } else {
                            if ($db-&gt;f('type') == 3 &amp;&amp; $db-&gt;f('id') == 1) {
                                $arr['textareafromdynamic'] = $db-&gt;f('value');
                            }
                        }
                    }
                }

                return $arr;
            }


