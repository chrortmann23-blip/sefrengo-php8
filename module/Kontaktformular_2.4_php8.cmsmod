    if (!class_exists('gooseberry_formcontroller')) {
        class gooseberry_formcontroller
        {
            var $frm;//form object
            var $content;//form html content
            var $dbdata;// dataitem object
            var $dbmeta;// reportdesc object


            var $db_mode_active = false;
            var $db_mode_default_datagroup;
            var $mutiple_value_separator = ',';
            var $redirect_after_success = false;
            var $redirect_after_success_url = '';

            var $save_in_filemanager = false;
            var $filemanager_iddirectory = false;


            function __construct()
            {
                global $con_side;
                if ((int)$_REQUEST['rvbackidcatside'] &gt; 0) {
                    $this-&gt;redirect_after_success = true;
                    $this-&gt;redirect_after_success_url = $con_side[(int)$_REQUEST['rvbackidcatside']]['link'];
                    $parms = '';
                    $parms .= '&amp;rvsortfield=' . $_REQUEST['rvsortfield'];
                    $parms .= '&amp;rvstart=' . $_REQUEST['rvstart'];
                    $parms .= '&amp;rvsortdirec=' . $_REQUEST['rvsortdirec'];
                    $parms .= '&amp;rvsearchquery=' . $_REQUEST['rvsearchquery'];
                    if (is_array($_REQUEST['rvkeyfilter'])) {
                        foreach ($_REQUEST['rvkeyfilter'] AS $k =&gt; $v) {
                            $parms .= '&amp;rvkeyfilter[' . $k . ']=' . $v;
                        }
                    }
                    if (is_array($_REQUEST['rvfreefilter'])) {
                        foreach ($_REQUEST['rvfreefilter'] AS $k =&gt; $v) {
                            $parms .= '&amp;rvfreefilter[' . $k . ']=' . $v;
                        }
                    }
                    $this-&gt;redirect_after_success_url .= $parms;

                    //$this-&gt;redirect_after_success_url;exit;
                }
            }

            function set_formobject(&amp;$frm)
            {
                $this-&gt;frm =&amp; $frm;
            }

            function set_db_mode_active($set)
            {
                $this-&gt;db_mode_active = (boolean)$set;
            }

            function set_db_mode_default_datagroup($set)
            {
                $this-&gt;db_mode_default_datagroup = $set;
            }

            function set_db_mode_items_are_online($set)
            {
                $this-&gt;db_mode_items_are_online = (boolean)$set;
            }

            function set_mutiple_value_separator($set)
            {
                $this-&gt;mutiple_value_separator = $set;
            }

            function set_save_in_filemanager($set)
            {
                $this-&gt;save_in_filemanager = $set;
            }

            function set_filemanager_iddirectory($id)
            {
                $this-&gt;filemanager_iddirectory = (int)$id;
            }

            function set_tpl_labeltext($tpl)
            {
                $this-&gt;tpl_labeltext = $tpl;
            }

            function set_redirect_after_success($bol, $url)
            {
                global $con_side;

                if (trim($url) == '') {
                    return false;
                }

                if ((int)$url &gt; 0) {
                    $url = $con_side[(int)$url]['link'];
                }

                $this-&gt;redirect_after_success = (boolean)$bol;
                $this-&gt;redirect_after_success_url = $url;
            }

            function start()
            {
                global $mvars;
                $rvidnew = $rvidedit = 0;
                //dbmode
                if ($this-&gt;db_mode_active) {
                    //check external db mode
                    $rvidedit = (int)$_REQUEST['rvidedit'];
                    $rvidnew = (int)$_REQUEST['rvidnew'];
                    $is_db_mode_and_new_record = false;

                    //from reportviewer context
                    if ($rvidedit &gt; 0 || $rvidnew &gt; 0) {
                        if ($rvidnew &gt; 0) {
                            $this-&gt;dbmeta = new rv_Reportdesc;
                            $this-&gt;dbmeta-&gt;loadByIddescreption($rvidnew);
                            $this-&gt;dbdata = new rv_DataItem;
                            $this-&gt;dbdata-&gt;setDatagroup($this-&gt;dbmeta-&gt;getGroupname());
                        } else {
                            $this-&gt;dbdata = new rv_DataItem;
                            $this-&gt;dbdata-&gt;loadByIdreportdata($rvidedit);
                            $this-&gt;dbmeta = new rv_Reportdesc;
                            $this-&gt;dbmeta-&gt;loadByGroupname($this-&gt;dbdata-&gt;getDatagroup());
                        }
                        $is_db_mode_and_new_record = $this-&gt;dbdata-&gt;isEmptyRecord();
                        for ($iter =&amp; $this-&gt;dbdata-&gt;getFormvalueIterator(); $iter-&gt;valid(); $iter-&gt;next()) {
                            $formkey = ($iter-&gt;key() - 1);
                            $fieldtype = $mvars[($formkey * 20 + 101)];
                            switch ($fieldtype) {
                                case 'option':
                                case 'optionMutiple':
                                case 'radio':
                                case 'checkbox':
                                case 'checkboxSelected':
                                    $mvars[($formkey * 20 + 109)] = $iter-&gt;current();
                                    break;
                                default:
                                    $mvars[($formkey * 20 + 103)] = $iter-&gt;current();
                            }
                        }
                    } else {
                        if ($this-&gt;db_mode_default_datagroup != '') {
                            //from default
                            $this-&gt;dbdata = new rv_DataItem;
                            $this-&gt;dbdata-&gt;setDatagroup($this-&gt;db_mode_default_datagroup);

                            $this-&gt;dbmeta = new rv_Reportdesc;
                            $this-&gt;dbmeta-&gt;loadByGroupname($this-&gt;db_mode_default_datagroup);
                            $is_db_mode_and_new_record = true;
                        } else {
                            $this-&gt;db_mode_active = false;
                        }
                    }

                    //new record is per default online or offline
                    if ($is_db_mode_and_new_record) {
                        $this-&gt;dbdata-&gt;setIs_online($this-&gt;db_mode_items_are_online);
                    }
                }

                //Formular erstellen
                //n+0 aktiv
                //n+1 type
                //n+2 label
                //n+3 default
                //n+4 validate
                //n+5 attributes label
                //n+6 attributes formelement
                //n+7 custom element- error
                //n+8 index tpl elementcontainer
                //n+9 default selected
                //elementnumber $i/100
                for ($i = 100; sf_array_key_exists(($i + 1), $mvars); $i = $i + 20) {
                    if ($mvars[$i]) {
                        if ($mvars[$i + 1] == 'checkboxSelected' &amp;&amp; $is_db_mode_and_new_record) {
                            $mvars[$i + 9] = $mvars[$i + 3];
                        }
                        $this-&gt;frm-&gt;set_formelement('go_frm' . $i, $mvars[$i + 1], $mvars[$i + 3], $mvars[$i + 4],
                            $mvars[$i + 2], $mvars[$i + 6], $mvars[$i + 5], $mvars[$i + 7], $mvars[$i + 8],
                            $mvars[$i + 9], (($i / 20) - 4));
                    }
                }


                //hidden vars by reportviewer
                //sortfield=2&amp;sortdirec=asc&amp;start=0&amp;rvidedit=7&amp;rvbackidcatside=8 (edit)
                //sortfield=2&amp;sortdirec=asc&amp;start=0&amp;rvidnew=-1&amp;rvbackidcatside=8 (new)
                if ($this-&gt;db_mode_active) {
                    if ($rvidedit &gt; 0 || $rvidnew == -1) {
                        $this-&gt;frm-&gt;set_anonymus_hidden('rvsortfield', $_REQUEST['rvsortfield']);
                        $this-&gt;frm-&gt;set_anonymus_hidden('rvsortdirec', $_REQUEST['rvsortdirec']);
                        $this-&gt;frm-&gt;set_anonymus_hidden('rvsearchquery', $_REQUEST['rvsearchquery']);
                        $this-&gt;frm-&gt;set_anonymus_hidden('rvstart', (int)$_REQUEST['rvstart']);
                        $this-&gt;frm-&gt;set_anonymus_hidden('rvbackidcatside', (int)$_REQUEST['rvbackidcatside']);
                        if (is_array($_REQUEST['rvkeyfilter'])) {
                            foreach ($_REQUEST['rvkeyfilter'] AS $k =&gt; $v) {
                                $this-&gt;frm-&gt;set_anonymus_hidden('rvkeyfilter[' . $k . ']',
                                    $this-&gt;frm-&gt;_strip_slashes($v));
                            }
                        }
                        if (is_array($_REQUEST['freefilter'])) {
                            foreach ($_REQUEST['freefilter'] AS $k =&gt; $v) {
                                $this-&gt;frm-&gt;set_anonymus_hidden('freefilter[' . $k . ']',
                                    $this-&gt;frm-&gt;_strip_slashes($v));
                            }
                        }
                    }
                    if ($rvidedit &gt; 0) {
                        $this-&gt;frm-&gt;set_anonymus_hidden('rvidedit', (int)$_REQUEST['rvidedit']);
                    } else {
                        if ($rvidnew == -1) {
                            $this-&gt;frm-&gt;set_anonymus_hidden('rvidnew', (int)$_REQUEST['rvidnew']);
                        }
                    }
                }

                $this-&gt;frm-&gt;parse_elements();
                if ($this-&gt;frm-&gt;is_submitted()) {
                    if ($this-&gt;frm-&gt;is_validated()) {
                        $this-&gt;frm-&gt;send_mail();
                        $this-&gt;_reportviewer_save();
                        $this-&gt;process_redirect();
                        $this-&gt;content = $this-&gt;frm-&gt;get_form_plain();
                    } else {
                        $this-&gt;content = $this-&gt;frm-&gt;get_form();
                    }
                } else {
                    $this-&gt;content = $this-&gt;frm-&gt;get_form();
                }

            }

            function get_content()
            {
                return $this-&gt;content;
            }

            function _reportviewer_save()
            {

                $stack = $this-&gt;frm-&gt;get_stack();
                $used_keys = array();

                //id dbmode isn't active catch upload files and exit
                if (!$this-&gt;db_mode_active) {
                    foreach ($stack AS $k =&gt; $v) {
                        switch ($v['type']) {
                            case 'upload':
                                if ($v['advanced']['file'] == '') {
                                    break;
                                } else {
                                    $f =&amp; $GLOBALS['sf_factory']-&gt;getObjectForced('ASSETS', 'DbFile');
                                    if ($this-&gt;save_in_filemanager == 'overwrite') {
                                        $f-&gt;setOverwriteExistingFile(true);
                                        $f-&gt;setAutorenameIfExists(false);
                                    } else {
                                        if ($this-&gt;save_in_filemanager == 'rename') {
                                            $f-&gt;setOverwriteExistingFile(false);
                                            $f-&gt;setAutorenameIfExists(true);
                                        } else {
                                            break;
                                        }
                                    }
                                    $f-&gt;setExternalSourceFile($v['advanced']['file'], $v['advanced']['type']);
                                    $f-&gt;setIddirectory($this-&gt;filemanager_iddirectory);
                                    $f-&gt;save();
                                }
                                break;
                        }
                    }

                    return false;
                }

                foreach ($stack AS $k =&gt; $v) {
                    switch ($v['type']) {
                        case 'locumtenency':
                        case 'label':
                            break;
                        case 'upload':
                            if ($v['advanced']['file'] == '') {
                                if ($this-&gt;dbdata-&gt;isEmptyRecord()) {
                                    $v['value'] = '';
                                } else {
                                    break;
                                }
                            } else {
                                $f =&amp; $GLOBALS['sf_factory']-&gt;getObjectForced('ASSETS', 'DbFile');
                                if ($this-&gt;save_in_filemanager == 'overwrite') {
                                    $f-&gt;setOverwriteExistingFile(true);
                                    $f-&gt;setAutorenameIfExists(false);
                                } else {
                                    if ($this-&gt;save_in_filemanager == 'rename') {
                                        $f-&gt;setOverwriteExistingFile(false);
                                        $f-&gt;setAutorenameIfExists(true);
                                    } else {
                                        break;
                                    }
                                }
                                $f-&gt;setExternalSourceFile($v['advanced']['file'], $v['advanced']['type']);
                                $f-&gt;setIddirectory($this-&gt;filemanager_iddirectory);
                                $f-&gt;save();
                                $v['value'] = $f-&gt;getCmsLink();
                            }
                        default:
                            //special handling for 'option' and 'optionMutiple'
                            $this-&gt;dbdata-&gt;setFormvalueByFormkey(($k + 1), $v['value']);
                            sf_array_push($used_keys, ($k + 1));
                            $this-&gt;dbmeta-&gt;setFieldlabelByFieldkey(($k + 1), $v['label']);

                    }
                }


                $this-&gt;dbmeta-&gt;deleteFieldkeysByKeysNotInArray($used_keys);


                $this-&gt;dbdata-&gt;save();
                $this-&gt;dbmeta-&gt;save();
                //print_r($this-&gt;dbmeta);
            }

            function process_redirect()
            {
                if (!$this-&gt;redirect_after_success) {
                    return false;
                }
                //echo $this-&gt;redirect_after_success_url;exit;
                sf_header_redirect($this-&gt;redirect_after_success_url);
            }

        }
    }

    //
    // START WORKING
    //

    //look for reportviewer plugin
    if (is_file($cfg_cms['cms_path'] . 'plugins/reportviewer/index.php')) {
        $mvars['reportviewer_included'] = true;
        include_once $cfg_cms['cms_path'] . 'plugins/reportviewer/includes/class.rv_ArrayIterator.php';
        include_once $cfg_cms['cms_path'] . 'plugins/reportviewer/includes/class.rv_DataItem.php';
        include_once $cfg_cms['cms_path'] . 'plugins/reportviewer/includes/class.rv_Reportdesc.php';
    } else {
        $mvars['reportviewer_included'] = false;
    }
    include_once $cfg_cms['cms_path'] . 'external/misc/class.captcha.php';
    $frm = new gooseberry_form;
    //set debug
    $frm-&gt;set_debug(($mvars['44'] == 'true') ? true : false);
    //set form styles
    $frm-&gt;set_styles(array(
        'submit_error' =&gt; $mvars['15'],
        'submit' =&gt; $mvars['16'],
        'label' =&gt; $mvars['17'],
        'label_error' =&gt; $mvars['18'],
        'element_error' =&gt; $mvars['53'],
        'text' =&gt; $mvars['19'],
        'textarea' =&gt; $mvars['20'],
        'option' =&gt; $mvars['21'],
        'checkbox' =&gt; $mvars['22'],
        'upload' =&gt; $mvars['52'],
        'password' =&gt; $mvars['31'],
        'select_mutiple' =&gt; $mvars['32'],
        'radio' =&gt; $mvars['33'],
        'captchaimage' =&gt; $mvars['79'],
        'label_as_formfield' =&gt; $mvars['34'],
        'placeholder' =&gt; $mvars['35'],
        'submitbutton' =&gt; $mvars['23']
    ));
    //final template to combinate all elements
    $frm-&gt;set_combination_tpl($mvars['25']);
    //message block template
    $frm-&gt;set_message_block_tpl($mvars['38']);
    //template for the form element seperator
    $frm-&gt;set_separator_tpl($mvars['42']);
    //template for elementerror
    $frm-&gt;set_tpl_elementerror($mvars['43']);
    //template for one form row
    $frm-&gt;set_row_tpl(1, $mvars['26']);
    $frm-&gt;set_row_tpl(2, $mvars['46']);
    $frm-&gt;set_row_tpl(3, $mvars['66']);
    $frm-&gt;set_row_tpl(4, $mvars['86']);
    //template for formstarttag
    $frm-&gt;set_formstart_tpl($mvars['39']);
    //template for formendttag
    $frm-&gt;set_formend_tpl($mvars['40']);
    //upload restrictions
    $frm-&gt;set_upload_restrictions(array(
        'upload_allowed_extensions' =&gt; $mvars['47'],
        'upload_allowed_filesize' =&gt; $mvars['48']
    ));
    //upload
    $frm-&gt;set_upload_errors(array(
        'usr_allowed_ext' =&gt; $mvars['49'],
        'usr_allowed_size' =&gt; $mvars['50'],
        'usr_internal_error' =&gt; $mvars['51']
    ));

    //url for form- action- parameter
    $frm-&gt;set_form_target_url($con_side[(int)$idcatside]['link']);
    //email receiptor mode - get or textfield are possible
    $frm-&gt;set_email_receiptor_mode($mvars['41']);
    //settings for email receiptor mode 'get' idcatside and container
    $frm-&gt;set_email_receiptor_get_mode_data($_REQUEST['contactidcs'], $_REQUEST['contactcontainer']);
    //settings for email receiptor mode 'textfield'
    $frm-&gt;set_email_receiptor_textfield_mode_data($mvars['12']);
    //emailadress sender
    $frm-&gt;set_email_sender((is_numeric($mvars['27'])) ? $_REQUEST['go_frm' . $mvars['27']] : $mvars['12']);
    //email subject
    $frm-&gt;set_email_subject($mvars['11']);
    //success message
    $frm-&gt;set_form_message_success($mvars['14']);
    //error message
    $frm-&gt;set_form_message_error($mvars['13']);
    //submitbutton text
    $frm-&gt;set_submitbutton_text($mvars['24']);
    //mutiple value separator
    $frm-&gt;set_mutiple_value_separator($mvars['36']);
    //key/ value value separator
    $frm-&gt;set_key_value_separator($mvars['37']);
    //upload dir
    $frm-&gt;set_upload_dir($cfg_cms['cms_path'] . 'upload/in/');
    //fallback {textfromdynamic}
    $frm-&gt;set_fallback_textfromdynamic($mvars['54']);
    //fallback {textareafromdynamic}
    $frm-&gt;set_fallback_textareafromdynamic($mvars['55']);
    //charset
    $frm-&gt;set_charset($lang_charset);
    //tple email
    $frm-&gt;set_tpl_email($mvars['56']);
    //send email
    $frm-&gt;set_send_mail($mvars['65'] == 'true');
    //en/ disable logging
    $frm-&gt;set_logging_active($mvars['63'] == 'true');
    //logfile
    $frm-&gt;set_logging_file($mvars['64']);
    //cc and bcc
    $frm-&gt;set_email_receiptor_cc($mvars['57']);
    $frm-&gt;set_email_receiptor_bcc($mvars['58']);
    //confirmmail vals: boolean sendiit|subject|body
    $frm-&gt;set_confirmmail_vars(($mvars['68'] == 'true'), $mvars['69'], $mvars['70']);
    //addon object string
    $frm-&gt;set_addon($mvars['72']);
    //captcha vals
    $frm-&gt;set_captcha_vals($mvars['73'], $mvars['74'], $mvars['75'], $mvars['76'], $mvars['77'], $mvars['78']);
    //second email
    $frm-&gt;set_second_email_sender($mvars['80']);
    $frm-&gt;set_second_email_recipient($mvars['81']);
    //requirenotice
    $frm-&gt;set_tpl_requirenotice($mvars['82']);
    //labeltext
    $frm-&gt;set_tpl_labeltext($mvars['83']);

    $frm_control = new gooseberry_formcontroller;
    $frm_control-&gt;set_formobject($frm);
    $frm_control-&gt;set_db_mode_active($mvars['59'] == 'true' &amp;&amp; $mvars['reportviewer_included']);
    $frm_control-&gt;set_db_mode_default_datagroup($mvars['60']);
    $frm_control-&gt;set_db_mode_items_are_online(($mvars['71'] == 'online'));
    $frm_control-&gt;set_mutiple_value_separator($mvars['36']);
    $frm_control-&gt;set_save_in_filemanager($mvars['61']);
    $frm_control-&gt;set_filemanager_iddirectory($mvars['62']);
    $frm_control-&gt;set_redirect_after_success((trim($mvars['67']) != ''), $mvars['67']);
    $frm_control-&gt;start();
    //print_r($mvars);
    echo $frm_control-&gt;get_content();

    unset($frm, $frm_control, $inner_form, $outer_form, $to_replace, $replacer, $frm_vals, $mvars, $a);


}

unset($is_dev);
&lt;/CMSPHP&gt;</output>
